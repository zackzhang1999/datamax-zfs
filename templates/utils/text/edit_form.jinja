{% if success %}
<div id="success" hx-swap-oob="true">
    {% include "partials/success.jinja" %}
</div>
{% endif %}

{% if error %}
<div id="error" hx-swap-oob="true">
    {% include "partials/error.jinja" %}
</div>
{% endif %}

<!-- Text Editor Card -->
<div class="card">
    <div class="card-body">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    文本编辑器
                </h3>
                <p class="text-sm text-text-secondary font-mono mt-1">{{ file_path }}</p>
            </div>
        </div>

        <form class="w-full" action="/utils/text/save" method="post">
            <input type="hidden" id="file_path" name="file_path" value="{{ file_path }}">
            
            <div class="mb-4">
                <label class="form-label" for="content">文件内容</label>
                <textarea 
                    class="form-input font-mono text-sm" 
                    id="content" 
                    name="content" 
                    rows="24"
                    placeholder="文件内容……"
                >{{ content }}</textarea>
                <p class="text-xs text-text-tertiary mt-1">在上方编辑文件内容并保存更改</p>
            </div>

            <div class="flex gap-3 items-center">
                <button 
                    onclick="location.reload()" 
                    class="btn-secondary flex-1" 
                    type="button"
                >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    关闭
                </button>
                <button 
                    hx-post="/utils/text/save" 
                    hx-target="#edit" 
                    class="btn-success flex-1" 
                    type="submit"
                >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                    </svg>
                    保存更改
                </button>
            </div>
        </form>
    </div>
</div>
