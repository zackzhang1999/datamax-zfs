{% extends "layout.jinja" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">实用工具</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">支持信息包</span>
    </nav>

    <!-- Page Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-text-primary">支持信息包</h1>
            <p class="text-text-secondary mt-1">
                收集诊断数据，用于故障排查及与社区或技术支持分享。
            </p>
        </div>
    </div>

    <!-- Error Message -->
    {% if error %}
    <div class="bg-danger-900/30 border-2 border-danger-500/50 text-danger-400 px-4 py-3 rounded mb-4">
        <strong>错误：</strong> {{ error }}
    </div>
    {% endif %}

    <!-- About Support Bundles -->
    <div class="card-nested bg-info-900/30 border-info-900 mb-4">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
                <h3 class="text-lg font-semibold text-info-400 mb-2">关于支持信息包</h3>
                <p class="text-text-secondary text-sm">
                    支持信息包会将选定的系统诊断信息收集并打包为单个 zip 文件。该文件可分享给社区、
                    论坛帖子或技术支持渠道，以帮助诊断你的 ZFS 配置问题。
                    请在下方选择要包含的项目，然后点击“生成”。
                </p>
            </div>
        </div>
    </div>

    <!-- Privacy Warning -->
    <div class="bg-warning-900/30 border-2 border-warning-500/50 rounded-lg px-4 py-3 mb-6">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
                <h3 class="text-base font-semibold text-warning-400 mb-1">隐私提示</h3>
                <p class="text-warning-400/90 text-sm">
                    生成的信息包将包含此系统的真实数据，包括主机名、
                    IP 地址、存储池名称、数据集名称、挂载路径和系统配置细节。
                    <strong>公开分享之前，请务必检查 zip 文件的内容。</strong>
                    如某些类别包含你不想披露的信息，请在下方取消勾选。
                </p>
            </div>
        </div>
    </div>

    <!-- Main Form -->
    <form method="post" action="/utils/support-bundle/generate" id="bundle-form" hx-disable>
        <!-- Category Sections -->
        {% for category_name, items in categories.items() %}
        <div class="card mb-4 animate-fade-in" style="animation-delay: {{ loop.index0 * 0.05 }}s;">
            <div class="card-body">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-text-primary">{{ category_name }}</h2>
                    <button type="button"
                            class="text-xs text-primary-400 hover:text-primary-300 transition-colors"
                            onclick="toggleCategory(this, '{{ category_name | replace(' ', '_') | replace('/', '_') }}')">
                        全选
                    </button>
                </div>
                <div class="space-y-3">
                    {% for item in items %}
                    <label class="flex items-start gap-3 cursor-pointer group">
                        <input type="checkbox"
                               name="item_{{ item.key }}"
                               class="form-checkbox mt-0.5 category-{{ category_name | replace(' ', '_') | replace('/', '_') }}"
                               checked>
                        <div class="flex-1 min-w-0">
                            <span class="text-text-primary text-sm font-medium group-hover:text-primary-400 transition-colors">
                                {{ item.label }}
                            </span>
                            <p class="text-text-tertiary text-xs mt-0.5">{{ item.description }}</p>
                        </div>
                    </label>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endfor %}

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-3 mt-6">
            <button type="submit"
                    id="generate-btn"
                    class="btn-primary px-6 py-3 inline-flex items-center gap-2 text-base font-medium w-full sm:w-auto justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                生成支持信息包
            </button>

            <div class="flex gap-2">
                <button type="button"
                        class="btn-secondary px-4 py-2 text-sm"
                        onclick="selectAll(true)">
                    全选
                </button>
                <button type="button"
                        class="btn-secondary px-4 py-2 text-sm"
                        onclick="selectAll(false)">
                    取消全选
                </button>
            </div>
        </div>
    </form>

</div>

<script>
    function selectAll(checked) {
        var checkboxes = document.querySelectorAll('#bundle-form input[type="checkbox"]');
        checkboxes.forEach(function(cb) {
            cb.checked = checked;
        });
    }

    function toggleCategory(button, categoryClass) {
        var checkboxes = document.querySelectorAll('.category-' + categoryClass);
        // Determine if we should check or uncheck based on current state
        var allChecked = true;
        checkboxes.forEach(function(cb) {
            if (!cb.checked) allChecked = false;
        });
        var newState = !allChecked;
        checkboxes.forEach(function(cb) {
            cb.checked = newState;
        });
        button.textContent = newState ? '取消全选' : '全选';
    }

    // Show a generating indicator when the form is submitted
    document.getElementById('bundle-form').addEventListener('submit', function() {
        var btn = document.getElementById('generate-btn');
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> 正在生成...';
        // Re-enable after a timeout so the user can retry if the download fails
        setTimeout(function() {
            btn.disabled = false;
            btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg> 生成支持信息包';
        }, 15000);
    });
</script>
{% endblock %}
