{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">实用工具</a> 
        <span class="mx-2">/</span> 
        <a href="/utils/ssh" class="hover:text-primary-400">SSH 连接管理</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">添加连接</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-text-primary">添加 SSH 连接</h1>
        <p class="text-text-secondary mt-1">
            创建新的 SSH 连接并自动完成密钥认证设置
        </p>
    </div>

    <!-- Info Banner -->
    <div class="card-nested bg-warning-900/20 border-warning-700 mb-6">
        <div class="flex gap-3">
            <svg class="w-5 h-5 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="text-sm">
                <p class="font-medium text-warning-400 mb-2">工作原理：</p>
                <ol class="list-decimal list-inside space-y-1 text-text-secondary">
                    <li>输入连接信息和密码（仅使用一次）</li>
                    <li>系统为此连接生成唯一的 SSH 密钥对</li>
                    <li>公钥自动复制到远程服务器</li>
                    <li>密码随即被丢弃，绝不保存</li>
                    <li>之后的所有连接均使用生成的 SSH 密钥</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    {% if error %}
    <div class="card-nested bg-danger-900/30 border-danger-900 mb-6">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="text-sm text-danger-300">
                {{ error }}
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Add Connection Form -->
    <form method="post" action="/utils/ssh/add" class="card">
        <div class="card-body space-y-6">
            <!-- Connection Name -->
            <div>
                <label for="name" class="form-label">
                    连接名称 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="name" 
                    id="name" 
                    required 
                    class="form-input" 
                    placeholder="生产服务器 1"
                >
                <p class="mt-1 text-sm text-text-tertiary">
                    用于标识此连接的易记名称
                </p>
            </div>

            <!-- Host -->
            <div>
                <label for="host" class="form-label">
                    主机（IP 或主机名） <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="host" 
                    id="host" 
                    required 
                    class="form-input" 
                    placeholder="192.168.1.100 or server.example.com"
                >
                <p class="mt-1 text-sm text-text-tertiary">
                    IP 地址或完全限定域名
                </p>
            </div>

            <!-- Port -->
            <div>
                <label for="port" class="form-label">
                    SSH 端口
                </label>
                <input 
                    type="number" 
                    name="port" 
                    id="port" 
                    value="22" 
                    class="form-input"
                >
                <p class="mt-1 text-sm text-text-tertiary">
                    默认 SSH 端口为 22
                </p>
            </div>

            <!-- Username -->
            <div>
                <label for="username" class="form-label">
                    用户名 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="username" 
                    id="username" 
                    required 
                    class="form-input" 
                    placeholder="root or zfsadmin"
                >
                <p class="mt-1 text-sm text-text-tertiary">
                    远程服务器上的用户账号
                </p>
            </div>

            <!-- Password (One-time use) -->
            <div>
                <label for="password" class="form-label">
                    密码 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="password" 
                    name="password" 
                    id="password" 
                    required 
                    class="form-input"
                    autocomplete="new-password"
                >
                <p class="mt-1 text-sm text-text-tertiary">
                    <strong class="text-warning-400">仅使用一次：</strong>仅用于安装 SSH 密钥，随后即被丢弃
                </p>
            </div>

            <!-- Notes (Optional) -->
            <div>
                <label for="notes" class="form-label">
                    备注（可选）
                </label>
                <textarea 
                    name="notes" 
                    id="notes" 
                    rows="3" 
                    class="form-input"
                    placeholder="例如：生产备份服务器，需要 VPN"
                ></textarea>
                <p class="mt-1 text-sm text-text-tertiary">
                    关于此连接的其他备注
                </p>
            </div>
        </div>

        <!-- Form Footer -->
        <div class="card-footer flex justify-end gap-3">
            <a href="/utils/ssh" class="btn-secondary">取消</a>
            <button type="submit" class="btn-primary">创建连接</button>
        </div>
    </form>
</div>
{% endblock %}
