{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">实用工具</a> 
        <span class="mx-2">/</span> 
        <a href="/utils/ssh" class="hover:text-primary-400">SSH 连接管理</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">编辑连接</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-text-primary">编辑 SSH 连接</h1>
        <p class="text-text-secondary mt-1">
            更新连接信息（SSH 密钥无法更改——如需更换请重新创建连接）
        </p>
    </div>

    <!-- Edit Connection Form -->
    <form method="post" action="/utils/ssh/{{ connection.id }}/edit" class="card">
        <div class="card-body space-y-6">
            <!-- Connection Name -->
            <div>
                <label for="name" class="form-label">
                    连接名称 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="name" 
                    id="name" 
                    required 
                    class="form-input" 
                    value="{{ connection.name }}"
                >
            </div>

            <!-- Host -->
            <div>
                <label for="host" class="form-label">
                    主机（IP 或主机名） <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="host" 
                    id="host" 
                    required 
                    class="form-input" 
                    value="{{ connection.host }}"
                >
            </div>

            <!-- Port -->
            <div>
                <label for="port" class="form-label">
                    SSH 端口
                </label>
                <input 
                    type="number" 
                    name="port" 
                    id="port" 
                    class="form-input"
                    value="{{ connection.port }}"
                >
            </div>

            <!-- Username -->
            <div>
                <label for="username" class="form-label">
                    用户名 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    name="username" 
                    id="username" 
                    required 
                    class="form-input" 
                    value="{{ connection.username }}"
                >
            </div>

            <!-- Notes -->
            <div>
                <label for="notes" class="form-label">
                    备注（可选）
                </label>
                <textarea 
                    name="notes" 
                    id="notes" 
                    rows="3" 
                    class="form-input"
                >{{ connection.notes if connection.notes else '' }}</textarea>
            </div>

            <!-- SSH Key Info (Read-only) -->
            <div class="card-nested bg-info-500/10 border-info-500/30">
                <div class="flex gap-3">
                    <svg class="w-5 h-5 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="text-sm">
                        <p class="font-medium text-text-primary mb-2">SSH 密钥信息</p>
                        <p class="text-text-secondary mb-2">指纹：<span class="font-mono text-xs">{{ connection.fingerprint }}</span></p>
                        <p class="text-text-secondary text-xs">如需更换 SSH 密钥，请删除此连接并重新创建。</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Footer -->
        <div class="card-footer flex justify-end gap-3">
            <a href="/utils/ssh" class="btn-secondary">取消</a>
            <button type="submit" class="btn-primary">更新连接</button>
        </div>
    </form>
</div>
{% endblock %}
