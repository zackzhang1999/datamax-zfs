{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">实用工具</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">计划任务</span>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
        <div>
            <h1 class="text-3xl font-bold text-text-primary">计划任务</h1>
            <p class="text-text-secondary text-sm mt-1">
                DataMax-zfs 的所有计划任务集中于此，Linux 上由 systemd 定时器驱动，FreeBSD 和 NetBSD 上由 root 用户的 crontab 驱动
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <!-- One button per task type. Each type has its own form page
                 because a scrub, a SMART test, and a health report need
                 different fields. -->
            <a href="/utils/scheduling/scrub/new" class="btn-primary px-4 py-2 inline-flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                新建数据清洗
            </a>
            <a href="/utils/scheduling/smart/new" class="btn-secondary px-4 py-2 inline-flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                新建 SMART 测试
            </a>
            <a href="/utils/scheduling/health/new" class="btn-secondary px-4 py-2 inline-flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                新建健康检查
            </a>
            <a href="/zfs/replication/syncoid/jobs/create/form" class="btn-secondary px-4 py-2 inline-flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                新建数据复制任务
            </a>
            <form method="post" action="/utils/scheduling/sync" class="inline">
                <button type="submit" class="btn-secondary px-4 py-2 inline-flex items-center gap-2" title="将已保存的计划与操作系统调度器进行核对同步">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    同步系统调度器
                </button>
            </form>
        </div>
    </div>

    <!-- Success/Error Messages -->
    {% if request.query_params.get('message') %}
    <div class="bg-success-900/30 border-2 border-success-500/50 text-success-400 px-4 py-3 rounded mb-4">
        {{ request.query_params.get('message') }}
    </div>
    {% endif %}

    {% if request.query_params.get('error') %}
    <div class="bg-danger-900/30 border-2 border-danger-500/50 text-danger-400 px-4 py-3 rounded mb-4">
        <strong>错误：</strong> {{ request.query_params.get('error') }}
    </div>
    {% endif %}

    <!-- HTMX deferred loading: the task table can require pool and disk queries -->
    <div hx-get="/utils/scheduling/content-partial"
         hx-trigger="load"
         hx-swap="innerHTML">
        <div class="flex flex-col items-center justify-center py-16">
            <svg class="animate-spin h-10 w-10 text-primary-400 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-text-secondary text-lg">正在加载计划任务……</p>
        </div>
    </div>

    <!-- How scheduling works -->
    <div class="mt-6 card-nested bg-info-900/20 border-info-700">
        <h3 class="font-semibold mb-3 text-text-primary">计划任务的运行机制</h3>
        <ul class="space-y-2 text-sm text-text-secondary">
            <li>在 Linux 上，每个已启用的任务都会生成一个名为 webzfs-task-TYPE-ID.timer 的 systemd 定时器，因此即使没有打开浏览器会话，任务也会照常运行。</li>
            <li>在 FreeBSD 和 NetBSD 上，所有已启用的任务集中存放在 root 用户 crontab 中一个由标记界定的区块内，区块之外的行不会被改动。</li>
            <li>每种类型的任务都通过同一个运行器执行，它会记录运行结果，并在已有任务仍在运行时拒绝启动第二个实例。</li>
            <li>在恢复配置备份或手工编辑 JSON 计划文件之后，请使用“同步系统调度器”。</li>
        </ul>
    </div>
</div>
{% endblock %}
