{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">实用工具</a>
        <span class="mx-2">/</span>
        <a href="/utils/scheduling" class="hover:text-primary-400">计划任务</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">{% if task %}编辑 SMART 测试计划{% else %}新建 SMART 测试计划{% endif %}</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-text-primary mb-2">
            {% if task %}编辑 SMART 测试计划{% else %}新建 SMART 测试计划{% endif %}
        </h1>
        <p class="text-text-secondary text-sm">
            在选定的磁盘上启动 SMART 自检。保存后，计划会立即注册到操作系统调度器中。
        </p>
    </div>

    <div class="card mb-6">
        <div class="card-body">
            <form method="post" action="/utils/scheduling/save">
                <input type="hidden" name="task_type" value="smart">
                {% if task %}
                <input type="hidden" name="task_id" value="{{ task.id }}">
                {% endif %}

                <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="form-label" for="disk">磁盘</label>
                        <!-- HTMX deferred loading: probing disks with smartctl
                             wakes idle drives and can take many seconds, so the
                             disk options load after the page has rendered. -->
                        <div hx-get="/utils/scheduling/smart/disk-options-partial?selected={{ task.disk | urlencode if task and task.disk else '' }}"
                             hx-trigger="load"
                             hx-swap="innerHTML">
                            <select id="disk" class="form-select" disabled>
                                <option value="">正在检测磁盘……</option>
                            </select>
                            <p class="text-text-tertiary text-xs mt-1 flex items-center">
                                <svg class="animate-spin h-3 w-3 text-primary-400 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                正在探测支持 SMART 的设备，可能需要片刻。
                            </p>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="test_type">测试类型</label>
                        <select name="test_type" id="test_type" class="form-select">
                            <option value="short" {% if task and task.test_type == 'short' %}selected{% endif %}>短测试（几分钟）</option>
                            <option value="long" {% if task and task.test_type == 'long' %}selected{% endif %}>长测试（数小时）</option>
                        </select>
                    </div>
                </div>

                {% include 'utils/scheduling/schedule_fields.jinja' %}

                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                    <button type="submit" class="btn-primary">
                        {% if task %}保存更改{% else %}创建计划{% endif %}
                    </button>
                    <a href="/utils/scheduling" class="btn-secondary">取消</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card-nested bg-info-900/20 border-info-700">
        <h3 class="font-semibold mb-2 text-text-primary">关于 SMART 测试计划</h3>
        <ul class="space-y-1 text-sm text-text-secondary">
            <li>常见的做法是拆成两个计划：每周一次短测试，每月一次长测试。</li>
            <li>选择“全部磁盘”可用单个任务覆盖所有磁盘；若某块磁盘需要单独的计划，也可以单独选择。</li>
            <li>“全部磁盘”运行时会同时在每块磁盘上启动测试。如果部分磁盘启动失败，该任务会被记录为部分完成而非失败。</li>
            <li>自检期间磁盘仍可正常使用，但在繁忙的磁盘上运行长测试会带来明显的延迟。</li>
            <li>测试完成后，结果会显示在 <a href="/utils/smart" class="text-primary-400 hover:text-primary-300">SMART 监控</a>页面上。</li>
        </ul>
    </div>
</div>
{% endblock %}
