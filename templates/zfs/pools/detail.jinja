{% extends "layout.jinja" %}

{% set props = pool.properties or {} %}
{% set ds_props = dataset_props if dataset_props is defined else {} %}

{% block content %}
<div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">{{ pool.name }}</span>
    </nav>

    <!-- Page Header with Status Badge -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <h1 class="text-3xl font-bold text-text-primary">{{ pool.name }}</h1>
            {% set state = parsed.state %}
            {% if state == 'ONLINE' %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-success-900/50 text-success-400 border border-success-900">在线</span>
            {% elif state == 'DEGRADED' %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-warning-900/50 text-warning-400 border border-warning-900">降级</span>
            {% elif state == 'FAULTED' %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-danger-900/50 text-danger-400 border border-danger-900">故障</span>
            {% elif state == 'SUSPENDED' %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-danger-900/50 text-danger-400 border border-danger-900">已暂停</span>
            {% elif state == 'UNAVAIL' %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-danger-900/50 text-danger-400 border border-danger-900">不可用</span>
            {% else %}
            <span class="px-3 py-1 rounded-full text-sm font-semibold bg-bg-elevated-2 text-text-secondary border border-border-subtle">{{ state }}</span>
            {% endif %}
        </div>
        <div class="flex gap-2">
            <a href="/zfs/pools/{{ pool.name }}/vdevs" class="btn-info inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                管理 VDev
            </a>
            <a href="/zfs/pools/{{ pool.name }}/properties" class="btn-primary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                属性
            </a>
            <a href="/zfs/pools/{{ pool.name }}/history" class="btn-secondary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                历史记录
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    {% if request.query_params.get('message') %}
        {% with message=request.query_params.get('message') %}
            {% include "partials/success.jinja" %}
        {% endwith %}
    {% endif %}
    {% set error_text = (request.query_params.get('error') or '')|lower %}
    {% set is_busy_error = ('busy' in error_text or 'in use' in error_text or 'pool is busy' in error_text or 'unmount' in error_text) %}
    {% if request.query_params.get('error') and not is_busy_error %}
        {% with message=request.query_params.get('error') %}
            {% include "partials/error.jinja" %}
        {% endwith %}
    {% endif %}

    <!-- Export Failed Error Modal (busy pool) -->
    {% if request.query_params.get('error') and is_busy_error %}
    <div id="export-error-modal-overlay" class="fixed inset-0 z-50">
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
        <div class="fixed inset-0 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div class="modal modal-sm w-full max-w-lg border-2 border-danger-500">
                    <!-- Danger Icon -->
                    <div class="flex items-center justify-center w-14 h-14 mx-auto mb-4 rounded-full bg-danger-900/50 border-2 border-danger-500">
                        <svg class="w-7 h-7 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-danger-400 text-center mb-3">导出失败</h3>
                    <p class="text-text-secondary text-center mb-2">
                        存储池 <strong class="font-mono text-text-primary">{{ pool.name }}</strong>
                        仍在使用中，无法导出。
                    </p>
                    <div class="bg-danger-900/20 border border-danger-900 rounded-lg p-3 mb-5">
                        <p class="text-sm text-danger-300 font-mono break-words text-center">{{ request.query_params.get('error') }}</p>
                    </div>
                    <p class="text-sm text-text-secondary text-center mb-5">
                        您可以排查系统，找出占用该存储池的打开文件和 shell，
                        然后重试导出。
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href="/zfs/pools/{{ pool.name }}" class="btn-secondary flex-1 text-center">
                            接受并返回存储池
                        </a>
                        <button type="button"
                                class="btn-danger flex-1 inline-flex items-center justify-center gap-2"
                                onclick="closeExportErrorModal(); openInvestigateModal();">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            排查
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
    window.closeExportErrorModal = function() {
        const overlay = document.getElementById('export-error-modal-overlay');
        if (overlay) { overlay.remove(); }
    };
    </script>
    {% endif %}

    <!-- Export Investigation Modal -->
    <div id="investigate-modal-overlay" class="fixed inset-0 z-50 hidden">
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" onclick="closeInvestigateModal()"></div>
        <div class="fixed inset-0 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div class="modal modal-lg w-full max-w-3xl">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xl font-semibold text-text-primary flex items-center gap-2">
                            <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            导出受阻：是什么在占用 {{ pool.name }}？
                        </h3>
                        <button type="button" class="text-text-tertiary hover:text-text-primary" onclick="closeInvestigateModal()">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div id="investigate-modal-body" class="max-h-[70vh] overflow-y-auto">
                        <div class="flex flex-col items-center justify-center py-12 gap-4">
                            <div class="w-12 h-12 rounded-full border-4 border-danger-900 border-t-danger-500 animate-spin"></div>
                            <span class="text-text-secondary">正在扫描系统中打开的文件和锁...</span>
                        </div>
                    </div>
                    <div class="flex justify-end gap-3 pt-4 mt-4 border-t border-border-subtle">
                        <button type="button" class="btn-secondary" onclick="closeInvestigateModal()">关闭</button>
                        <button type="button" class="btn-secondary flex items-center gap-2" onclick="refreshInvestigateModal()">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            刷新
                        </button>
                        <a href="/zfs/pools/{{ pool.name }}/export/confirm" class="btn-danger">重试导出</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    window.runInvestigateScan = function() {
        const body = document.getElementById('investigate-modal-body');
        if (!body) { return; }
        body.innerHTML = '<div class="flex flex-col items-center justify-center py-12 gap-4">'
            + '<div class="w-12 h-12 rounded-full border-4 border-danger-900 border-t-danger-500 animate-spin"></div>'
            + '<span class="text-text-secondary">正在扫描系统中打开的文件和锁...</span></div>';
        fetch('/zfs/pools/{{ pool.name }}/export/investigate')
            .then(function(response) { return response.text(); })
            .then(function(html) { body.innerHTML = html; })
            .catch(function(err) {
                body.innerHTML = '<div class="alert-danger" role="alert">'
                    + '<p class="text-sm text-danger-300">无法执行排查：'
                    + err + '</p></div>';
            });
    };

    window.openInvestigateModal = function() {
        const overlay = document.getElementById('investigate-modal-overlay');
        if (!overlay) { return; }
        overlay.classList.remove('hidden');
        runInvestigateScan();
    };

    window.refreshInvestigateModal = function() {
        runInvestigateScan();
    };

    window.closeInvestigateModal = function() {
        const overlay = document.getElementById('investigate-modal-overlay');
        if (overlay) { overlay.classList.add('hidden'); }
    };
    </script>

    <!-- Capacity Bar -->
    {% set cap_val = (zfs_cap if zfs_cap else props.get('capacity', {}).get('value', '0%'))|replace('%', '')|int %}
    <div class="card">
        <div class="flex items-center justify-between mb-2">
            <span class="text-text-secondary text-sm font-medium">存储池容量</span>
            <span class="text-text-primary font-semibold">{{ zfs_cap if zfs_cap else props.get('capacity', {}).get('value', '-') }}</span>
        </div>
        <div class="w-full bg-bg-elevated-2 rounded-full h-3 overflow-hidden">
            <div class="h-3 rounded-full transition-all {% if cap_val > 90 %}bg-danger-500{% elif cap_val >= 80 %}bg-warning-500{% else %}bg-success-500{% endif %}"
                 style="width: {{ cap_val }}%"></div>
        </div>
        <div class="flex justify-between mt-2 text-xs text-text-tertiary">
            <span>{{ zfs_used if zfs_used else props.get('allocated', {}).get('value', '-') }} 已用</span>
            <span>{{ zfs_avail if zfs_avail else props.get('free', {}).get('value', '-') }} 可用，共 {{ zfs_total if zfs_total else props.get('size', {}).get('value', '-') }}</span>
        </div>
    </div>

    <!-- Dataset Space Visualizer -->
    <div class="card">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                数据集空间使用情况
            </h2>
            <div class="flex flex-wrap items-center gap-3 text-sm">
                <div id="space-viz-breadcrumb" class="text-text-secondary"></div>
                <label class="inline-flex items-center gap-2 text-text-secondary cursor-pointer select-none">
                    <input type="checkbox" id="space-viz-show-snapshots" checked
                           class="form-checkbox h-4 w-4 rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                    <span>显示快照占用条带</span>
                </label>
                <label class="inline-flex items-center gap-2 text-text-secondary cursor-pointer select-none"
                       title="压缩空闲空间块，使数据集段填充更多行宽。">
                    <input type="checkbox" id="space-viz-collapse-free"
                           class="form-checkbox h-4 w-4 rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                    <span>折叠空闲空间</span>
                </label>
                <button type="button" id="space-viz-back"
                        class="btn-secondary text-sm inline-flex items-center gap-1 disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    返回
                </button>
                <a href="/zfs/datasets?focus={{ pool.name }}"
                   class="btn-primary text-sm inline-flex items-center gap-1"
                   title="打开数据集页面并展开此存储池">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                    </svg>
                    查看数据集
                </a>
            </div>
        </div>
        <div id="space-viz-container"
             class="relative w-full bg-bg-base border border-border-subtle rounded-lg overflow-hidden">
            <div id="space-viz-loading" class="flex items-center justify-center text-text-tertiary text-sm py-12">
                正在加载数据集使用情况...
            </div>
            <svg id="space-viz-svg" class="block w-full" style="display:none;" preserveAspectRatio="none"></svg>
        </div>
        <div id="space-viz-tooltip"
             class="hidden absolute z-30 bg-bg-elevated-2 border border-border-subtle rounded-lg shadow-lg px-3 py-2 text-xs text-text-primary pointer-events-none"
             style="position: fixed; max-width: 320px;">
        </div>
        <p class="text-xs text-text-tertiary mt-3">
            每行代表数据集的一个层级。段宽度与相对于父级已用空间成正比。
            点击某段可深入查看。可视化最多显示四个层级。
        </p>
    </div>

    <!-- Key Metrics Row -->
    {% set compress_val = ds_props.get('compression', {}).get('value', 'off') %}
    {% set compress_ratio = ds_props.get('compressratio', {}).get('value', '-') %}
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">已用</div>
            <div class="text-text-primary text-xl font-bold">{{ zfs_used if zfs_used else props.get('allocated', {}).get('value', '-') }}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">可用</div>
            <div class="text-text-primary text-xl font-bold">{{ zfs_avail if zfs_avail else props.get('free', {}).get('value', '-') }}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">总计</div>
            <div class="text-text-primary text-xl font-bold">{{ zfs_total if zfs_total else props.get('size', {}).get('value', '-') }}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">碎片率</div>
            <div class="text-text-primary text-xl font-bold">{{ props.get('fragmentation', {}).get('value', '-') }}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">压缩</div>
            <div class="text-text-primary text-xl font-bold">{% if compress_val != 'off' %}{{ compress_ratio }}{% else %}关闭{% endif %}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">去重比</div>
            <div class="text-text-primary text-xl font-bold">{{ props.get('dedupratio', {}).get('value', '-') }}</div>
        </div>
        <div class="card text-center">
            <div class="text-text-tertiary text-xs uppercase mb-1">预留空间</div>
            <div class="text-text-primary text-xl font-bold">{{ reservation_value if reservation_value != 'none' and reservation_value != '0' else '无' }}</div>
        </div>
    </div>

    <!-- Status & Errors Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Pool Diagnostics -->
        <div class="card">
            <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                诊断
            </h2>
            <div class="space-y-3">
                {% if parsed.scan_info %}
                <div class="flex items-start gap-2">
                    <span class="text-text-tertiary text-sm w-16 flex-shrink-0 pt-0.5">扫描：</span>
                    <span class="text-text-primary text-sm">{{ parsed.scan_info }}</span>
                </div>
                {% endif %}
                {% if parsed.status_message %}
                <div class="flex items-start gap-2">
                    <span class="text-text-tertiary text-sm w-16 flex-shrink-0 pt-0.5">状态：</span>
                    <span class="text-warning-400 text-sm">{{ parsed.status_message }}</span>
                </div>
                {% endif %}
                {% if parsed.action_message %}
                <div class="flex items-start gap-2">
                    <span class="text-text-tertiary text-sm w-16 flex-shrink-0 pt-0.5">操作：</span>
                    <span class="text-info-400 text-sm">{{ parsed.action_message }}</span>
                </div>
                {% endif %}
                <div class="flex items-start gap-2">
                    <span class="text-text-tertiary text-sm w-16 flex-shrink-0 pt-0.5">错误：</span>
                    {% if parsed.errors_line and 'No known' in parsed.errors_line %}
                    <span class="text-success-400 text-sm">{{ parsed.errors_line }}</span>
                    {% elif parsed.errors_line %}
                    <span class="text-danger-400 text-sm font-semibold">{{ parsed.errors_line }}</span>
                    {% else %}
                    <span class="text-text-tertiary text-sm">-</span>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Error Counters -->
        <div class="card">
            <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                I/O 错误总计
            </h2>
            <div class="grid grid-cols-3 gap-4">
                {% set has_read = parsed.total_read_errors > 0 %}
                {% set has_write = parsed.total_write_errors > 0 %}
                {% set has_cksum = parsed.total_cksum_errors > 0 %}
                <div class="card-nested text-center {% if has_read %}bg-danger-900/20 border-danger-900{% endif %}">
                    <div class="text-text-tertiary text-xs uppercase mb-1">读取</div>
                    <div class="text-2xl font-bold {% if has_read %}text-danger-400{% else %}text-success-400{% endif %}">{{ parsed.total_read_errors }}</div>
                </div>
                <div class="card-nested text-center {% if has_write %}bg-danger-900/20 border-danger-900{% endif %}">
                    <div class="text-text-tertiary text-xs uppercase mb-1">写入</div>
                    <div class="text-2xl font-bold {% if has_write %}text-danger-400{% else %}text-success-400{% endif %}">{{ parsed.total_write_errors }}</div>
                </div>
                <div class="card-nested text-center {% if has_cksum %}bg-danger-900/20 border-danger-900{% endif %}">
                    <div class="text-text-tertiary text-xs uppercase mb-1">校验和</div>
                    <div class="text-2xl font-bold {% if has_cksum %}text-danger-400{% else %}text-success-400{% endif %}">{{ parsed.total_cksum_errors }}</div>
                </div>
            </div>
            <div class="mt-4">
                <h3 class="text-sm font-medium text-text-secondary mb-2">存储池设置</h3>
                <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm">
                    <div class="flex justify-between border-b border-border-subtle py-1">
                        <span class="text-text-tertiary">故障模式：</span>
                        <span class="text-text-primary font-mono">{{ props.get('failmode', {}).get('value', '-') }}</span>
                    </div>
                    <div class="flex justify-between border-b border-border-subtle py-1">
                        <span class="text-text-tertiary">自动替换：</span>
                        <span class="text-text-primary font-mono">{{ props.get('autoreplace', {}).get('value', '-') }}</span>
                    </div>
                    <div class="flex justify-between border-b border-border-subtle py-1">
                        <span class="text-text-tertiary">自动扩容：</span>
                        <span class="text-text-primary font-mono">{{ props.get('autoexpand', {}).get('value', '-') }}</span>
                    </div>
                    <div class="flex justify-between border-b border-border-subtle py-1">
                        <span class="text-text-tertiary">委派：</span>
                        <span class="text-text-primary font-mono">{{ props.get('delegation', {}).get('value', '-') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- VDev Tree -->
    <div class="card">
        <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            VDev 布局
        </h2>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="border-b border-border-subtle">
                        <th class="text-left py-2 px-3 text-text-secondary font-medium">名称</th>
                        <th class="text-left py-2 px-3 text-text-secondary font-medium">状态</th>
                        <th class="text-right py-2 px-3 text-text-secondary font-medium">读取</th>
                        <th class="text-right py-2 px-3 text-text-secondary font-medium">写入</th>
                        <th class="text-right py-2 px-3 text-text-secondary font-medium">校验和</th>
                    </tr>
                </thead>
                <tbody>
                    {# Determine the indent levels: min=pool, next=vdev, deeper=leaf #}
                    {% set min_indent = parsed.vdevs[0].indent if parsed.vdevs else 0 %}
                    {% for vdev in parsed.vdevs %}
                    {% set is_pool_root = (vdev.indent == min_indent) %}
                    {% set is_vdev = (vdev.indent == min_indent + 2) %}
                    {% set is_leaf = (vdev.indent > min_indent + 2) %}
                    {% set has_errors = (vdev.read_errors > 0 or vdev.write_errors > 0 or vdev.cksum_errors > 0) %}
                    {# Show pool root and vdevs always; show leaves only if they have errors #}
                    {% if not is_leaf or has_errors %}
                    <tr class="border-b border-border-subtle/50 hover:bg-bg-elevated-2 transition-colors">
                        <td class="py-2 px-3 font-mono text-text-primary">
                            {% if is_pool_root %}
                            <span class="font-bold">{{ vdev.name }}</span>
                            {% elif is_vdev %}
                            <span class="ml-4 text-primary-400 font-semibold">{{ vdev.name }}</span>
                            {% else %}
                            <span class="ml-8 text-text-secondary">{{ vdev.name }}</span>
                            {% endif %}
                        </td>
                        <td class="py-2 px-3">
                            {% if vdev.state == 'ONLINE' %}
                            <span class="text-success-400 font-medium">在线</span>
                            {% elif vdev.state == 'DEGRADED' %}
                            <span class="text-warning-400 font-semibold">降级</span>
                            {% elif vdev.state == 'FAULTED' or vdev.state == 'UNAVAIL' or vdev.state == 'REMOVED' %}
                            <span class="text-danger-400 font-semibold">{{ vdev.state }}</span>
                            {% else %}
                            <span class="text-text-tertiary">{{ vdev.state }}</span>
                            {% endif %}
                        </td>
                        <td class="py-2 px-3 text-right font-mono {% if vdev.read_errors > 0 %}text-danger-400 font-bold{% else %}text-text-tertiary{% endif %}">{{ vdev.read_errors }}</td>
                        <td class="py-2 px-3 text-right font-mono {% if vdev.write_errors > 0 %}text-danger-400 font-bold{% else %}text-text-tertiary{% endif %}">{{ vdev.write_errors }}</td>
                        <td class="py-2 px-3 text-right font-mono {% if vdev.cksum_errors > 0 %}text-danger-400 font-bold{% else %}text-text-tertiary{% endif %}">{{ vdev.cksum_errors }}</td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Actions + Reservation Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Actions -->
        <div class="card">
            <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                操作
            </h2>
            <div class="grid grid-cols-2 gap-3">
                <!-- Scrub Start -->
                <form method="post" action="/zfs/pools/{{ pool.name }}/scrub" id="form-scrub-start">
                    <button type="button"
                            class="btn-info w-full inline-flex items-center justify-center gap-2"
                            onclick="showConfirm('confirm-scrub-start')">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        开始数据清洗
                    </button>
                </form>

                <!-- Scrub Stop -->
                <form method="post" action="/zfs/pools/{{ pool.name }}/scrub/stop" id="form-scrub-stop">
                    <button type="button"
                            class="btn-secondary w-full inline-flex items-center justify-center gap-2"
                            onclick="showConfirm('confirm-scrub-stop')">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        停止数据清洗
                    </button>
                </form>

                {% if checkpoint_supported %}
                {% if not checkpoint_info or not checkpoint_info.exists %}
                <!-- Checkpoint Create -->
                <form method="post" action="/zfs/pools/{{ pool.name }}/checkpoint" id="form-checkpoint-create">
                    <button type="button"
                            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-emerald-800/40 text-emerald-300 border border-emerald-700/50 hover:bg-emerald-800/60"
                            onclick="showConfirm('confirm-checkpoint-create')">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                        </svg>
                        创建检查点
                    </button>
                </form>
                {% endif %}
                {% endif %}

                <!-- Export -->
                <a href="/zfs/pools/{{ pool.name }}/export/confirm"
                   class="btn-danger w-full inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    导出存储池
                </a>

                <!-- Destroy Pool -->
                <a href="/zfs/pools/{{ pool.name }}/destroy/confirm"
                   class="btn-danger col-span-2 w-full inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    销毁存储池
                </a>
            </div>
            <div class="card-nested mt-4">
                <p class="text-xs text-text-tertiary flex items-start gap-2">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><strong class="text-text-secondary">注意：</strong>“销毁存储池”为不可逆操作，将永久删除该存储池中的全部数据。如需完整保留数据，请先执行“导出存储池”或通过数据复制功能创建备份。</span>
                </p>
            </div>
        </div>

        <!-- Reservation Management -->
        <div class="card">
            <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                存储池预留空间
            </h2>
            {% if reservation_value and reservation_value != 'none' and reservation_value != '0' %}
            <div class="card-nested bg-purple-900/20 border-purple-900 mb-4">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-text-tertiary text-xs uppercase">当前预留空间</div>
                        <div class="text-purple-400 text-xl font-bold mt-1">{{ reservation_value }}</div>
                    </div>
                    <form method="post" action="/zfs/pools/{{ pool.name }}/reservation">
                        <input type="hidden" name="reservation_size" value="none">
                        <button type="submit" class="btn-secondary text-sm">移除</button>
                    </form>
                </div>
            </div>
            {% endif %}
            <form method="post" action="/zfs/pools/{{ pool.name }}/reservation" class="flex flex-col sm:flex-row gap-3 items-end">
                <div class="flex-1 w-full">
                    <label for="reservation_size" class="form-label">设置预留空间</label>
                    <input type="text"
                           id="reservation_size"
                           name="reservation_size"
                           required
                           placeholder="例如 100G、1T 或 none"
                           class="form-input w-full">
                </div>
                <button type="submit" class="btn-primary inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    应用
                </button>
            </form>
            <p class="text-xs text-text-tertiary mt-3">为此存储池的根数据集预留最小空间。可使用大小后缀：K、M、G、T。设为 "none" 可移除。</p>
        </div>
    </div>

    <!-- Checkpoint Card -->
    {% if checkpoint_supported and checkpoint_info and checkpoint_info.exists %}
    <div class="card">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2 bg-warning-900/50 rounded-lg">
                <svg class="w-6 h-6 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-lg font-semibold text-text-primary">活动检查点</h2>
                <p class="text-text-secondary text-sm">此存储池当前存在活动检查点</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div class="card-nested">
                <div class="text-text-tertiary text-xs uppercase mb-1">创建时间</div>
                <div class="text-text-primary font-mono text-sm">{{ checkpoint_info.creation_time or '未知' }}</div>
            </div>
            {% if checkpoint_info.space_used %}
            <div class="card-nested">
                <div class="text-text-tertiary text-xs uppercase mb-1">占用空间</div>
                <div class="text-text-primary font-mono text-sm">{{ checkpoint_info.space_used }}</div>
            </div>
            {% endif %}
        </div>
        <div class="card-nested bg-warning-900/20 border-warning-900 mb-4">
            <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <strong class="text-warning-400 block mb-2">回滚到检查点</strong>
                    <p class="text-text-secondary text-sm mb-3">要回滚到检查点状态，请导出存储池并使用 rewind 标志重新导入。<strong class="text-danger-400">此操作具有破坏性。</strong></p>
                    <pre class="bg-bg-elevated-2 text-text-primary p-3 rounded-lg text-sm font-mono border border-border-subtle overflow-x-auto">zpool export {{ pool.name }}
zpool import --rewind-to-checkpoint {{ pool.name }}</pre>
                </div>
            </div>
        </div>
        <form method="post" action="/zfs/pools/{{ pool.name }}/checkpoint/discard" id="form-checkpoint-discard">
            <button type="button"
                    class="btn-danger inline-flex items-center justify-center gap-2"
                    onclick="showConfirm('confirm-checkpoint-discard')">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                丢弃检查点
            </button>
        </form>
    </div>
    {% endif %}

    <!-- Pool Mountpoint Management -->
    <div class="card">
        <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
            </svg>
            存储池挂载点
        </h2>
        <div class="card-nested mb-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <div class="text-text-tertiary text-xs uppercase">当前挂载点</div>
                    <div class="text-text-primary text-lg font-mono mt-1 break-all">{{ mountpoint_value if mountpoint_value else '-' }}</div>
                </div>
                <div>
                    <div class="text-text-tertiary text-xs uppercase">来源</div>
                    <div class="text-text-primary text-lg font-mono mt-1">{{ mountpoint_source if mountpoint_source else '-' }}</div>
                </div>
            </div>
        </div>
        <form method="post" action="/zfs/pools/{{ pool.name }}/mountpoint" id="form-set-mountpoint" class="flex flex-col sm:flex-row gap-3 items-end">
            <div class="flex-1 w-full">
                <label for="pool_mountpoint" class="form-label">新挂载点</label>
                <input type="text"
                       id="pool_mountpoint"
                       name="mountpoint"
                       required
                       placeholder="例如 /mnt/{{ pool.name }} 或 /{{ pool.name }}"
                       value="{{ mountpoint_value }}"
                       class="form-input w-full font-mono">
            </div>
            <button type="button"
                    class="btn-primary inline-flex items-center gap-2"
                    onclick="showConfirm('confirm-set-mountpoint')">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                应用
            </button>
        </form>
        <div class="card-nested bg-warning-900/20 border-warning-900 mt-4">
            <p class="text-xs text-text-secondary flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <span>
                    <strong class="text-warning-400">警告：</strong>
                    更改存储池挂载点会将存储池根数据集移动到新路径。所有继承挂载点的子数据集
                    都将被重新挂载到新路径下
                    （例如，挂载在
                    <span class="font-mono">{{ mountpoint_value if mountpoint_value else '/' ~ pool.name }}/data</span>
                    的 <span class="font-mono">{{ pool.name }}/data</span>
                    也会相应移动）。拥有自己显式挂载点的子数据集将保持
                    其当前挂载点不变。这可能会破坏依赖现有路径的共享、服务、脚本或其他工作负载。
                </span>
            </p>
        </div>
        <p class="text-xs text-text-tertiary mt-3">
            请使用绝对路径（必须以 <span class="font-mono">/</span> 开头），或使用特殊值
            <span class="font-mono">none</span>（不挂载）或 <span class="font-mono">legacy</span>
            （通过 <span class="font-mono">/etc/fstab</span> 或 <span class="font-mono">mount</span> 管理）。
        </p>
    </div>

    <!-- Full zpool status Output -->
    <div class="card">
        <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            zpool status 原始输出
        </h2>
        <pre class="bg-bg-base text-text-primary p-4 rounded-lg overflow-x-auto text-sm font-mono border border-border-subtle">{{ pool.status_output }}</pre>
    </div>

    <!-- Back -->
    <div>
        <a href="/zfs/pools" class="text-text-secondary hover:text-text-primary inline-flex items-center gap-2 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            返回存储池列表
        </a>
    </div>
</div>

<!-- Confirmation Modals -->
{% set id = 'confirm-scrub-start' %}
{% set title = '开始对存储池进行数据清洗' %}
{% set message = '对存储池 ' ~ pool.name ~ ' 开始数据清洗？此操作将扫描所有数据以验证完整性。' %}
{% set confirm_text = '开始数据清洗' %}
{% set confirm_class = 'info' %}
{% set confirm_action = 'document.getElementById("form-scrub-start").submit()' %}
{% include 'partials/confirm.jinja' %}

{% set id = 'confirm-scrub-stop' %}
{% set title = '停止存储池数据清洗' %}
{% set message = '停止存储池 ' ~ pool.name ~ ' 上正在运行的数据清洗？' %}
{% set confirm_text = '停止数据清洗' %}
{% set confirm_class = 'warning' %}
{% set confirm_action = 'document.getElementById("form-scrub-stop").submit()' %}
{% include 'partials/confirm.jinja' %}

{% set id = 'confirm-set-mountpoint' %}
{% set title = '更改存储池挂载点' %}
{% set message = '要更改存储池 <strong>' ~ pool.name ~ '</strong> 的挂载点吗？<br><br>' ~
    '所有<em>继承</em>挂载点的子数据集都将被重新挂载到新路径下。' ~
    '例如，当前挂载在 ' ~
    '<span class="font-mono">' ~ (mountpoint_value if mountpoint_value else ('/' ~ pool.name)) ~ '/data</span> ' ~
    '的 <span class="font-mono">' ~ pool.name ~ '/data</span> 将移动到新路径。<br><br>' ~
    '<strong class="text-warning-400">警告：</strong>这可能会破坏依赖现有挂载点的共享（NFS、SMB）、服务、' ~
    '计划任务、脚本或其他工作负载。' ~
    '拥有自己显式设置挂载点的子数据集将保留其当前挂载点。' %}
{% set confirm_text = '应用挂载点' %}
{% set confirm_class = 'warning' %}
{% set confirm_action = 'document.getElementById("form-set-mountpoint").submit()' %}
{% include 'partials/confirm.jinja' %}

{% if checkpoint_supported %}
{% set id = 'confirm-checkpoint-create' %}
{% set title = '创建存储池检查点' %}
{% set message = '要为存储池 <strong>' ~ pool.name ~ '</strong> 创建检查点吗？<br><br>检查点会捕获存储池的完整状态。同一时间只能存在一个检查点。' %}
{% set confirm_text = '创建检查点' %}
{% set confirm_class = 'warning' %}
{% set confirm_action = 'document.getElementById("form-checkpoint-create").submit()' %}
{% include 'partials/confirm.jinja' %}

{% set id = 'confirm-checkpoint-discard' %}
{% set title = '丢弃存储池检查点' %}
{% set message = '要丢弃存储池 <strong>' ~ pool.name ~ '</strong> 的检查点吗？<br><br><strong class="text-danger-400">警告：</strong>此操作无法撤销。' %}
{% set confirm_text = '丢弃检查点' %}
{% set confirm_class = 'danger' %}
{% set confirm_action = 'document.getElementById("form-checkpoint-discard").submit()' %}
{% include 'partials/confirm.jinja' %}
{% endif %}

<script>
window.showConfirm = function(dialogId) {
    const dialog = document.getElementById(dialogId);
    if (!dialog) { console.error('Dialog not found:', dialogId); return; }
    if (window.Alpine) {
        const component = window.Alpine.$data(dialog);
        if (component) { component.open = true; return; }
    }
    if (dialog.__x) { dialog.__x.$data.open = true; return; }
    dialog.dispatchEvent(new CustomEvent('open-modal'));
};
</script>

<script>
(function() {
    "use strict";

    var POOL_NAME = {{ pool.name|tojson }};
    var MAX_VISIBLE_DEPTH = 4;
    var ROW_HEIGHT = 56;
    var ROW_GAP = 4;
    var SVG_NS = "http://www.w3.org/2000/svg";

    // Theme-aware palette: derive hue/saturation/lightness from the
    // currently active --primary-500 CSS variable so the visualizer
    // matches whichever theme the user has selected. Falls back to a
    // sensible default if reading the variable fails.
    var THEME = (function() {
        var defaults = { hue: 217, sat: 65, base: 50 };
        try {
            var rootStyle = getComputedStyle(document.documentElement);
            var hex = (rootStyle.getPropertyValue("--primary-500") || "").trim();
            if (!hex) return defaults;
            var rgb = hexToRgb(hex);
            if (!rgb) return defaults;
            var hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
            return {
                hue: Math.round(hsl.h),
                sat: Math.max(35, Math.min(75, Math.round(hsl.s))),
                base: Math.max(35, Math.min(60, Math.round(hsl.l)))
            };
        } catch (e) {
            return defaults;
        }
    })();

    function hexToRgb(hex) {
        var h = hex.replace("#", "").trim();
        if (h.length === 3) {
            h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
        }
        if (h.length !== 6) return null;
        return {
            r: parseInt(h.substring(0, 2), 16),
            g: parseInt(h.substring(2, 4), 16),
            b: parseInt(h.substring(4, 6), 16)
        };
    }

    function rgbToHsl(r, g, b) {
        r /= 255; g /= 255; b /= 255;
        var max = Math.max(r, g, b), min = Math.min(r, g, b);
        var h, s, l = (max + min) / 2;
        if (max === min) {
            h = s = 0;
        } else {
            var d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            switch (max) {
                case r: h = (g - b) / d + (g < b ? 6 : 0); break;
                case g: h = (b - r) / d + 2; break;
                default: h = (r - g) / d + 4;
            }
            h *= 60;
        }
        return { h: h, s: s * 100, l: l * 100 };
    }


    var container = document.getElementById("space-viz-container");
    var loadingEl = document.getElementById("space-viz-loading");
    var svg = document.getElementById("space-viz-svg");
    var tooltip = document.getElementById("space-viz-tooltip");
    var breadcrumb = document.getElementById("space-viz-breadcrumb");
    var backButton = document.getElementById("space-viz-back");
    var snapshotToggle = document.getElementById("space-viz-show-snapshots");
    var collapseFreeToggle = document.getElementById("space-viz-collapse-free");

    if (!container || !svg) return;

    // When the user enables "Collapse free space", the free-space block
    // on the pool row shrinks to roughly the width needed for its label
    // so the dataset blocks can fill the rest of the row. Anything
    // smaller hides the label without losing the space proportions.
    var COLLAPSED_FREE_WIDTH = 140;

    var rootTree = null;
    var viewStack = [];
    var showSnapshotBands = true;
    var collapseFreeSpace = false;

    function formatBytes(bytes) {
        if (bytes === null || bytes === undefined || isNaN(bytes)) return "-";
        var b = Number(bytes);
        if (b < 1024) return b + " B";
        var units = ["KiB", "MiB", "GiB", "TiB", "PiB", "EiB"];
        var v = b / 1024;
        var i = 0;
        while (v >= 1024 && i < units.length - 1) {
            v = v / 1024;
            i++;
        }
        return (v >= 100 ? v.toFixed(0) : v.toFixed(2)) + " " + units[i];
    }

    function shortName(fullName) {
        var idx = fullName.lastIndexOf("/");
        return idx === -1 ? fullName : fullName.substring(idx + 1);
    }

    function hashString(s) {
        var h = 0;
        for (var i = 0; i < s.length; i++) {
            h = ((h << 5) - h) + s.charCodeAt(i);
            h |= 0;
        }
        return Math.abs(h);
    }

    function colorForName(name, depth) {
        // Restrict the hue to a window centered on the theme's primary
        // colour so all segments feel like they belong to the same
        // palette. The window is +/- 80 degrees around the theme hue,
        // which gives enough variation between siblings without
        // wandering into unrelated colours. Lightness steps up per
        // depth so deeper rows are visually distinct from the pool.
        var spread = 160;
        var offset = (hashString(name) % spread) - (spread / 2);
        var hue = (THEME.hue + offset + 360) % 360;
        var sat = THEME.sat - 5 + (hashString(name + ":sat") % 12);
        if (sat < 30) sat = 30;
        if (sat > 70) sat = 70;
        var lightness = THEME.base - 6 + (depth * 5);
        if (lightness < 32) lightness = 32;
        if (lightness > 62) lightness = 62;
        return "hsl(" + hue + ", " + sat + "%, " + lightness + "%)";
    }

    function findNode(tree, name) {
        if (tree.name === name) return tree;
        if (!tree.children) return null;
        for (var i = 0; i < tree.children.length; i++) {
            var found = findNode(tree.children[i], name);
            if (found) return found;
        }
        return null;
    }

    function setBackEnabled(enabled) {
        if (enabled) {
            backButton.removeAttribute("disabled");
        } else {
            backButton.setAttribute("disabled", "disabled");
        }
    }

    function renderBreadcrumb() {
        breadcrumb.innerHTML = "";
        if (viewStack.length === 0) return;
        var parts = viewStack.map(function(name, idx) {
            var label = idx === 0 ? name : shortName(name);
            return '<button type="button" class="hover:text-text-primary underline-offset-2 hover:underline" data-stack-index="' + idx + '">' + label + '</button>';
        });
        breadcrumb.innerHTML = "正在查看：" + parts.join(' <span class="text-text-tertiary">/</span> ');
        var buttons = breadcrumb.querySelectorAll("button[data-stack-index]");
        buttons.forEach(function(btn) {
            btn.addEventListener("click", function() {
                var idx = parseInt(btn.getAttribute("data-stack-index"), 10);
                viewStack = viewStack.slice(0, idx + 1);
                draw();
            });
        });
    }

    function showTooltip(node, event) {
        var lines = [];
        lines.push('<div class="font-semibold text-text-primary mb-1">' + node.name + "</div>");
        lines.push('<div class="grid grid-cols-2 gap-x-3 gap-y-0.5">');
        lines.push('<span class="text-text-tertiary">已用：</span><span>' + formatBytes(node.used) + "</span>");
        lines.push('<span class="text-text-tertiary">引用量：</span><span>' + formatBytes(node.referenced) + "</span>");
        if (node.available > 0) {
            lines.push('<span class="text-text-tertiary">可用：</span><span>' + formatBytes(node.available) + "</span>");
        }
        lines.push('<span class="text-text-tertiary">数据集本身：</span><span>' + formatBytes(node.used_by_dataset) + "</span>");
        lines.push('<span class="text-text-tertiary">快照：</span><span>' + formatBytes(node.used_by_snapshots) + "</span>");
        lines.push('<span class="text-text-tertiary">子数据集：</span><span>' + formatBytes(node.used_by_children) + "</span>");
        lines.push('<span class="text-text-tertiary">压缩率：</span><span>' + (node.compressratio || "-") + "</span>");
        lines.push('<span class="text-text-tertiary">快照数：</span><span>' + (node.snapshot_count || 0) + "</span>");
        lines.push("</div>");
        tooltip.innerHTML = lines.join("");
        tooltip.classList.remove("hidden");
        positionTooltip(event);
    }

    function positionTooltip(event) {
        var pad = 12;
        var x = event.clientX + pad;
        var y = event.clientY + pad;
        var rect = tooltip.getBoundingClientRect();
        if (x + rect.width > window.innerWidth - pad) {
            x = event.clientX - rect.width - pad;
        }
        if (y + rect.height > window.innerHeight - pad) {
            y = event.clientY - rect.height - pad;
        }
        tooltip.style.left = x + "px";
        tooltip.style.top = y + "px";
    }

    function hideTooltip() {
        tooltip.classList.add("hidden");
    }

    function makeRect(x, y, w, h, fill, opts) {
        var rect = document.createElementNS(SVG_NS, "rect");
        rect.setAttribute("x", x);
        rect.setAttribute("y", y);
        rect.setAttribute("width", Math.max(0, w));
        rect.setAttribute("height", h);
        rect.setAttribute("fill", fill);
        if (opts && opts.stroke) rect.setAttribute("stroke", opts.stroke);
        if (opts && opts.strokeWidth) rect.setAttribute("stroke-width", opts.strokeWidth);
        if (opts && opts.opacity !== undefined) rect.setAttribute("opacity", opts.opacity);
        return rect;
    }

    function makeText(x, y, content, opts) {
        var t = document.createElementNS(SVG_NS, "text");
        t.setAttribute("x", x);
        t.setAttribute("y", y);
        t.setAttribute("fill", (opts && opts.fill) || "#fff");
        t.setAttribute("font-size", (opts && opts.fontSize) || 12);
        t.setAttribute("font-family", "ui-sans-serif, system-ui, sans-serif");
        t.setAttribute("dominant-baseline", "middle");
        t.setAttribute("pointer-events", "none");
        if (opts && opts.weight) t.setAttribute("font-weight", opts.weight);
        t.textContent = content;
        return t;
    }

    function drawSegment(parent, node, x, y, width, depth, isFreeSpace) {
        if (width < 1) return;
        var fill = isFreeSpace ? "rgba(120,120,120,0.35)" : colorForName(node.name, depth);
        var group = document.createElementNS(SVG_NS, "g");
        group.style.cursor = isFreeSpace ? "default" : "pointer";

        var rect = makeRect(x, y, width, ROW_HEIGHT, fill, {
            stroke: "rgba(0,0,0,0.45)",
            strokeWidth: 1
        });
        group.appendChild(rect);

        if (!isFreeSpace) {
            var totalUsed = Math.max(1, node.used);
            var bands = [];
            if (showSnapshotBands && node.used_by_snapshots > 0) {
                bands.push({
                    width: width * (node.used_by_snapshots / totalUsed),
                    fill: "rgba(255,255,255,0.18)",
                    pattern: true
                });
            }
            var bandX = x;
            for (var i = 0; i < bands.length; i++) {
                var band = bands[i];
                if (band.width < 0.5) continue;
                var bandRect = makeRect(
                    bandX + width - band.width,
                    y,
                    band.width,
                    ROW_HEIGHT,
                    band.fill,
                    { opacity: 0.85 }
                );
                group.appendChild(bandRect);
            }
        }

        var label = isFreeSpace
            ? "空闲 " + formatBytes(node.used)
            : shortName(node.name);
        if (width > 50) {
            var textColor = isFreeSpace ? "#cbd5e1" : "#ffffff";
            var t = makeText(x + 6, y + ROW_HEIGHT / 2, label, {
                fontSize: 12,
                fill: textColor,
                weight: depth === 0 ? "600" : "500"
            });
            group.appendChild(t);
        }

        if (!isFreeSpace) {
            group.addEventListener("mouseenter", function(ev) { showTooltip(node, ev); });
            group.addEventListener("mousemove", function(ev) { positionTooltip(ev); });
            group.addEventListener("mouseleave", hideTooltip);
            group.addEventListener("click", function() {
                if (depth === 0) return;
                viewStack.push(node.name);
                draw();
            });
        }

        parent.appendChild(group);
    }

    function layoutLevel(parentSvg, node, x, y, width, depth, maxDepth) {
        // Bottom row is the pool/root: split into used vs free if available.
        if (depth === 0 && node.available > 0) {
            var totalCapacity = node.used + node.available;
            if (totalCapacity > 0) {
                var usedWidth;
                var freeWidth;
                if (collapseFreeSpace) {
                    // Reserve a fixed slice for the free-space label and
                    // give the rest of the row to the dataset segments.
                    // Cap the slice at half the row so a tiny pool with
                    // mostly-free space does not collapse to nothing.
                    freeWidth = Math.min(COLLAPSED_FREE_WIDTH, width * 0.5);
                    usedWidth = width - freeWidth;
                } else {
                    usedWidth = width * (node.used / totalCapacity);
                    freeWidth = width - usedWidth;
                }
                drawSegment(parentSvg, node, x, y, usedWidth, depth, false);
                drawSegment(
                    parentSvg,
                    { name: "free", used: node.available },
                    x + usedWidth,
                    y,
                    freeWidth,
                    depth,
                    true
                );
                if (depth + 1 < maxDepth) {
                    layoutChildren(parentSvg, node, x, y, usedWidth, depth + 1, maxDepth);
                }
                return;
            }
        }

        drawSegment(parentSvg, node, x, y, width, depth, false);
        if (depth + 1 < maxDepth) {
            layoutChildren(parentSvg, node, x, y, width, depth + 1, maxDepth);
        }
    }

    function layoutChildren(parentSvg, node, parentX, parentY, parentWidth, depth, maxDepth) {
        if (!node.children || node.children.length === 0) return;
        var totalChildUsed = 0;
        for (var i = 0; i < node.children.length; i++) {
            totalChildUsed += Math.max(0, node.children[i].used);
        }
        if (totalChildUsed <= 0) return;

        // Each row is drawn above the previous one (icicle layout).
        var rowY = parentY - (ROW_HEIGHT + ROW_GAP);
        // Children only occupy the share of the parent's width that they
        // actually consume; the remainder is "owned by the dataset itself".
        var consumedFraction = totalChildUsed / Math.max(1, node.used);
        if (consumedFraction > 1) consumedFraction = 1;
        var childAreaWidth = parentWidth * consumedFraction;
        var cursorX = parentX;
        for (var j = 0; j < node.children.length; j++) {
            var child = node.children[j];
            var childWidth = childAreaWidth * (Math.max(0, child.used) / totalChildUsed);
            drawSegment(parentSvg, child, cursorX, rowY, childWidth, depth, false);
            if (depth + 1 < maxDepth) {
                layoutChildren(parentSvg, child, cursorX, rowY, childWidth, depth + 1, maxDepth);
            }
            cursorX += childWidth;
        }
    }

    function computeMaxDepth(node, current) {
        var d = current || 0;
        if (!node.children || node.children.length === 0) return d;
        var deepest = d;
        for (var i = 0; i < node.children.length; i++) {
            var sub = computeMaxDepth(node.children[i], d + 1);
            if (sub > deepest) deepest = sub;
        }
        return deepest;
    }

    function draw() {
        if (!rootTree) return;
        var currentName = viewStack[viewStack.length - 1];
        var node = findNode(rootTree, currentName);
        if (!node) {
            viewStack = [rootTree.name];
            node = rootTree;
        }
        setBackEnabled(viewStack.length > 1);
        renderBreadcrumb();

        // Clear any prior render.
        while (svg.firstChild) svg.removeChild(svg.firstChild);

        var width = container.clientWidth || 800;
        var depthCap = Math.min(MAX_VISIBLE_DEPTH, computeMaxDepth(node, 1));
        var rows = depthCap;
        var totalHeight = rows * ROW_HEIGHT + (rows - 1) * ROW_GAP;
        if (totalHeight < 80) totalHeight = 80;

        svg.setAttribute("viewBox", "0 0 " + width + " " + totalHeight);
        svg.setAttribute("width", width);
        svg.setAttribute("height", totalHeight);
        svg.style.height = totalHeight + "px";

        var rootY = totalHeight - ROW_HEIGHT;
        layoutLevel(svg, node, 0, rootY, width, 0, depthCap);

        loadingEl.style.display = "none";
        svg.style.display = "block";
    }

    function loadTree() {
        var url = "/zfs/pools/" + encodeURIComponent(POOL_NAME) + "/space-tree";
        fetch(url, { credentials: "same-origin" })
            .then(function(resp) { return resp.json(); })
            .then(function(data) {
                if (!data || !data.success) {
                    loadingEl.textContent = "加载数据集使用情况失败" +
                        (data && data.error ? "：" + data.error : "");
                    return;
                }
                rootTree = data.tree;
                viewStack = [rootTree.name];
                draw();
            })
            .catch(function(err) {
                loadingEl.textContent = "加载数据集使用情况失败：" + err;
            });
    }

    backButton.addEventListener("click", function() {
        if (viewStack.length > 1) {
            viewStack.pop();
            draw();
        }
    });

    snapshotToggle.addEventListener("change", function() {
        showSnapshotBands = !!snapshotToggle.checked;
        draw();
    });

    if (collapseFreeToggle) {
        collapseFreeSpace = !!collapseFreeToggle.checked;
        collapseFreeToggle.addEventListener("change", function() {
            collapseFreeSpace = !!collapseFreeToggle.checked;
            draw();
        });
    }

    var resizeTimer = null;
    window.addEventListener("resize", function() {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
            if (rootTree) draw();
        }, 150);
    });

    loadTree();
})();
</script>
{% endblock %}
