    }

    if (allDisks.length === 0) {
        html = '<p class="text-text-tertiary text-sm text-center py-4">此系统上未检测到磁盘。</p>';
    }

    container.innerHTML = html;
}

function renderDiskButtonsInto(containerId, disksList, onClick) {
    var container = document.getElementById(containerId);
    if (!container) return;

    if (disksList.length === 0) {
        container.innerHTML = '<span class="text-xs text-text-tertiary italic">没有未使用的可用磁盘</span>';
        return;
    }

    var html = '';
    disksList.forEach(function(disk) {
        var btnId = containerId + '-' + disk.name;
        html += '<button type="button" id="' + btnId + '" class="disk-btn px-2 py-1 text-xs font-mono rounded bg-bg-elevated-2 text-text-secondary border border-success-900/50 hover:border-primary-500 hover:text-primary-400 transition-colors" title="' + escAttr(disk.model) + ' - ' + escAttr(disk.size) + ' ' + escAttr(disk.type) + '" data-device="' + escAttr(disk.device_path) + '">';
        html += escHtml(disk.name) + ' (' + escHtml(disk.size) + ')';
        html += '</button>';
    });
    container.innerHTML = html;

    // Attach click handlers
    disksList.forEach(function(disk) {
        var btnId = containerId + '-' + disk.name;
        var btn = document.getElementById(btnId);
        if (btn) {
            btn.addEventListener('click', function() { onClick(disk); });
        }
    });
}

function renderPoolDeviceButtonsInto(containerId, poolDevices, onClick) {
    var container = document.getElementById(containerId);
    if (!container) return;

    if (!poolDevices || poolDevices.length === 0) {
        container.innerHTML = '<span class="text-xs text-text-tertiary italic">未找到存储池设备</span>';
        return;
    }

    var html = '';
    poolDevices.forEach(function(devName, idx) {
        var btnId = containerId + '-' + idx;
        html += '<button type="button" id="' + btnId + '" class="disk-btn px-2 py-1 text-xs font-mono rounded bg-bg-elevated-2 text-text-secondary border border-info-900/50 hover:border-info-500 hover:text-info-400 transition-colors" data-device="' + escAttr(devName) + '">';
        html += escHtml(devName);
        html += '</button>';
    });
    container.innerHTML = html;

    poolDevices.forEach(function(devName, idx) {
        var btnId = containerId + '-' + idx;
        var btn = document.getElementById(btnId);
        if (btn) {
            btn.addEventListener('click', function() { onClick(devName); });
        }
    });
}

// ==================== Disk-in-Use Check ====================
async function runDiskCheck() {
    // Get the modal's Alpine component to control state
    var modalEl = document.getElementById('confirm-check-disks');
    var modalData = null;
    if (window.Alpine) {
        modalData = window.Alpine.$data(modalEl);
    } else if (modalEl.__x) {
        modalData = modalEl.__x.$data;
    }

    try {
        var response = await fetch('/zfs/pools/' + poolName + '/vdevs/check-disk-usage');
        var data = await response.json();

        if (data.success && data.disk_status && pageData) {
            // Update disk statuses in our cached page data
            pageData.all_disks.forEach(function(disk) {
                var status = data.disk_status[disk.device_path];
                if (status) {
                    if (status.in_active_pool) {
                        disk.in_use = true;
                        disk.status_detail = 'active';
                        disk.pool_name = status.pool_name;
                    } else if (status.has_zfs_label) {
                        disk.status_detail = 'labeled';
                        disk.label_pool = status.pool_name;
                    }
                }
            });

            // Re-render disk buttons with updated status
            renderDiskButtons(pageData.all_disks, pageData.pool_devices);
        }

        // Unlock operation cards now that disks have been checked
        unlockOperationCards();

        // Transition modal to complete state
        if (modalData) {
            modalData.state = 'complete';
        }
    } catch (err) {
        console.error('Error checking disk usage:', err);
        // Transition modal to error state
        if (modalData) {
            modalData.errorMsg = '检查磁盘使用情况时出错：' + (err.message || '未知错误');
            modalData.state = 'error';
        }
    }
}

// ==================== 设备 Action Helpers ====================
function appendDevice(inputId, devicePath) {
    var input = document.getElementById(inputId);
    if (input.value && input.value.trim() !== '') {
        input.value = input.value.trim() + ',' + devicePath;
    } else {
        input.value = devicePath;
    }
}

function prepareDeviceAction(action, deviceName) {
    if (action === 'offline') {
        document.getElementById('offline-device').value = deviceName;
        showConfirm('confirm-offline');
    } else if (action === 'online') {
