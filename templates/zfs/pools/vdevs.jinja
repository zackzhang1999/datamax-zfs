// ==================== Operation Card Gating ====================
// Cards are locked until disk check is completed
function lockOperationCards() {
    if (disksChecked) return;
    var cardIds = ['card-attach', 'card-replace', 'card-add-aux'];
    cardIds.forEach(function(id) {
        var card = document.getElementById(id);
        if (!card) return;
        // Only lock if not already disabled by pool type constraints
        if (card.style.opacity === '0.4') return;
        card.style.position = 'relative';
        // Add overlay
        var overlay = document.createElement('div');
        overlay.id = id + '-lock-overlay';
        overlay.className = 'absolute inset-0 bg-bg-base/70 backdrop-blur-[3px] z-30 rounded-xl flex items-center justify-center cursor-not-allowed';
        overlay.innerHTML = '<div class="text-center p-6"><svg class="w-12 h-12 mx-auto text-info-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg><p class="text-info-400 text-sm font-semibold">请先运行“检测正在使用的磁盘”</p></div>';
        card.appendChild(overlay);
    });
}

function unlockOperationCards() {
    disksChecked = true;
    var cardIds = ['card-attach', 'card-replace', 'card-add-aux'];
    cardIds.forEach(function(id) {
        var overlay = document.getElementById(id + '-lock-overlay');
        if (overlay) overlay.remove();
    });
    // Re-apply pool type constraints (attach may still be disabled for raidz)
    if (pageData && pageData.topology) {
        // Attach constraint is already applied; nothing extra needed here
    }
}

// ==================== Pool Type Constraints ====================
function applyPoolTypeConstraints(topology) {
    // Determine the primary data vdev type from the pool topology
    var dataVdevs = topology.data_vdevs || [];
    var poolDataType = null;
    var hasMirrorOrSingle = false;
    var hasRaidz = false;

    dataVdevs.forEach(function(vdev) {
        var vtype = (vdev.type || '').toLowerCase();
        if (vtype === 'mirror' || vtype === 'single' || vtype === '') {
            hasMirrorOrSingle = true;
            if (!poolDataType) poolDataType = vtype || 'single';
        } else if (vtype.indexOf('raidz') === 0) {
            hasRaidz = true;
            if (!poolDataType) poolDataType = vtype;
        }
    });

    // Check if pool has any mirror vdevs
    var hasMirror = false;
    dataVdevs.forEach(function(vdev) {
        if ((vdev.type || '').toLowerCase() === 'mirror') hasMirror = true;
    });

    // 1. Grey out "附加设备（镜像）" card if pool uses raidz vdevs
    //    Attach only works for single/mirror vdevs
    var attachCard = document.getElementById('form-attach');
    if (attachCard) {
        var attachCardParent = attachCard.closest('.card');
        if (hasRaidz && !hasMirrorOrSingle) {
            // All data vdevs are raidz - disable attach
            attachCardParent.style.opacity = '0.4';
            attachCardParent.style.pointerEvents = 'none';
            // Add explanation banner
            var notice = document.createElement('div');
            notice.className = 'bg-bg-elevated rounded-lg border border-border-subtle p-3 text-xs text-text-tertiary mb-4';
            notice.innerHTML = '<strong class="text-text-secondary">不可用：</strong> 此存储池使用 RAIDZ VDEV。附加（镜像）仅适用于单磁盘或镜像 VDEV。';
            attachCard.parentElement.insertBefore(notice, attachCard);
        }
    }

    // 2. Grey out "使设备上线" section if no devices are offline
    var hasOfflineDevice = false;
    var allSections = ['data_vdevs', 'log_vdevs', 'cache_vdevs', 'spare_vdevs', 'special_vdevs', 'dedup_vdevs'];
    allSections.forEach(function(secKey) {
        var vdevs = topology[secKey] || [];
        vdevs.forEach(function(vdev) {
            (vdev.devices || []).forEach(function(dev) {
                if (dev.state === 'OFFLINE') hasOfflineDevice = true;
            });
        });
    });

    var onlineSection = document.getElementById('online-section');
    if (onlineSection && !hasOfflineDevice) {
        onlineSection.style.opacity = '0.4';
        onlineSection.style.pointerEvents = 'none';
        var onlineNotice = document.createElement('div');
        onlineNotice.className = 'bg-bg-elevated rounded-lg border border-border-subtle p-2 text-xs text-text-tertiary mb-2';
        onlineNotice.innerHTML = '<strong class="text-text-secondary">不可用：</strong> 此存储池当前没有处于离线状态的设备。';
        onlineSection.parentElement.insertBefore(onlineNotice, onlineSection);
    }

    // 3. Grey out "从镜像中分离" section if pool has no mirror vdevs
    var detachSection = document.getElementById('detach-section');
    if (detachSection && !hasMirror) {
        detachSection.style.opacity = '0.4';
        detachSection.style.pointerEvents = 'none';
        // Add explanation notice
        var detachNotice = document.createElement('div');
        detachNotice.className = 'bg-bg-elevated rounded-lg border border-border-subtle p-2 text-xs text-text-tertiary mb-2';
        detachNotice.innerHTML = '<strong class="text-text-secondary">不可用：</strong> 此存储池没有镜像 VDEV。分离仅适用于镜像中的设备。';
        detachSection.parentElement.insertBefore(detachNotice, detachSection);
    }

    // 4. Disable "更换设备" card entirely on single-disk pools.
    //    Replace requires redundancy to read from while resilvering, so a
    //    single-disk pool cannot meaningfully use this operation.
    if (pageData && pageData.is_single_disk_pool) {
        var replaceCard = document.getElementById('card-replace');
        if (replaceCard) {
            // Show the contextual notice that was already in the markup.
            var singleDiskNotice = document.getElementById('replace-single-disk-notice');
            if (singleDiskNotice) singleDiskNotice.classList.remove('hidden');
            // Grey out and disable interaction with the form portion only,
            // so the user can still read the notice clearly.
            var replaceForm = document.getElementById('form-replace');
            if (replaceForm) {
                replaceForm.style.opacity = '0.4';
                replaceForm.style.pointerEvents = 'none';
            }
        }
    }

}


// ==================== Auxiliary VDev Helpers ====================

function formatBytesHuman(bytes) {
    if (!bytes || bytes <= 0) return '';
    var units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    var i = 0;
    var val = bytes;
    while (val >= 1024 && i < units.length - 1) { val /= 1024; i++; }
    if (i <= 1) return Math.round(val) + ' ' + units[i];
    return val.toFixed(1) + ' ' + units[i];
}

function validateAndShowAddVdev() {
    // Client-side validation: block submission if spare devices are too small
    var errorEl = document.getElementById('add-vdev-validation-error');
    if (errorEl) { errorEl.classList.add('hidden'); errorEl.innerHTML = ''; }

    var typeSelect = document.getElementById('add-vdev-type');
    var vdevType = typeSelect ? typeSelect.value : '';
    var devicesInput = document.getElementById('add-devices');
    var devicesStr = devicesInput ? devicesInput.value.trim() : '';

    if (!devicesStr) {
        showConfirm('confirm-add-vdev');
        return;
    }

    if (vdevType === 'spare' && pageData && pageData.min_data_device_size > 0) {
        var minSize = pageData.min_data_device_size;
        // Build a lookup from device_path and name to size_bytes
        var sizeLookup = {};
        (pageData.all_disks || []).forEach(function(disk) {
            sizeLookup[disk.device_path] = disk.size_bytes || 0;
            sizeLookup[disk.name] = disk.size_bytes || 0;
        });

        var deviceList = devicesStr.split(',').map(function(d) { return d.trim(); }).filter(function(d) { return d.length > 0; });
        var tooSmall = [];
        deviceList.forEach(function(dev) {
            var size = sizeLookup[dev];
            if (size === undefined) {
                // Try basename of the path
                var base = dev.split('/').pop();
                size = sizeLookup[base];
            }
            if (size !== undefined && size > 0 && size < minSize) {
                tooSmall.push(dev + ' (' + formatBytesHuman(size) + ')');
            }
        });

        if (tooSmall.length > 0) {
            if (errorEl) {
                errorEl.innerHTML = '无法添加热备盘：' + escHtml(tooSmall.join(', ')) +
                    ' 小于最小的数据设备（' + formatBytesHuman(minSize) +
                    '）。热备盘必须与最小设备等大或更大。';
                errorEl.classList.remove('hidden');
            }
            return;
        }
    }

    // Validation passed
    showConfirm('confirm-add-vdev');
}

function getDeviceSizeBytes(deviceIdentifier) {
    // Look up a disk size in bytes for either an unused disk or a pool
    // device. Pool devices may use /dev/disk/by-id/ identifiers that are
    // not present in all_disks, so we also check the server-resolved
    // pool_device_sizes map keyed by the exact pool device name.
    if (!pageData || !deviceIdentifier) return 0;
    var ident = String(deviceIdentifier).trim();
    if (!ident) return 0;
    var poolSizes = pageData.pool_device_sizes || {};
    if (poolSizes[ident]) return poolSizes[ident];
    var base = ident.split('/').pop();
    if (poolSizes[base]) return poolSizes[base];
    var disks = pageData.all_disks || [];
    for (var i = 0; i < disks.length; i++) {
        var d = disks[i];
        if (d.device_path === ident || d.name === ident ||
            d.device_path === base || d.name === base) {
            return d.size_bytes || 0;
        }
    }
    return 0;
}


function refreshAttachFreeDisks() {
    // Render the 附加设备 "可用（未使用）ZFS 磁盘" buttons,
    // filtering out any disk that is smaller than the currently selected
    // existing device. Disks with unknown size remain selectable.
    if (!pageData) return;
    var existingInput = document.getElementById('attach-existing');
    var existingValue = existingInput ? existingInput.value.trim() : '';
    var existingSize = existingValue ? getDeviceSizeBytes(existingValue) : 0;

    var freeDisksList = [];
    var tooSmallDisks = [];
    (pageData.all_disks || []).forEach(function(disk) {
        if (disk.is_system_disk || disk.in_use) return;
        if (existingSize > 0 && (disk.size_bytes || 0) > 0 &&
            (disk.size_bytes || 0) < existingSize) {
            tooSmallDisks.push(disk);
            return;
        }
        freeDisksList.push(disk);
    });

    renderDiskButtonsInto('attach-free-disks', freeDisksList, function(disk) {
        document.getElementById('attach-new').value = disk.device_path;
    });

    var warningEl = document.getElementById('attach-size-warning');
    if (warningEl) {
        if (existingSize > 0 && tooSmallDisks.length > 0) {
            var names = tooSmallDisks.map(function(d) {
                return d.name + ' (' + d.size + ')';
            }).join(', ');
            warningEl.innerHTML = '<span class="text-warning-400">以下磁盘太小，无法附加（至少需要 ' +
                formatBytesHuman(existingSize) + '): </span><span class="text-text-tertiary">' +
                escHtml(names) + '</span>';
            warningEl.classList.remove('hidden');
        } else {
            warningEl.innerHTML = '';
            warningEl.classList.add('hidden');
        }
    }
}

function validateAndShowAttach() {
    // Client-side validation: block submission if the selected new device is
    // smaller than the existing device.
    var errorEl = document.getElementById('attach-validation-error');
    if (errorEl) { errorEl.classList.add('hidden'); errorEl.innerHTML = ''; }

    var existingInput = document.getElementById('attach-existing');
    var newInput = document.getElementById('attach-new');
    var existingValue = existingInput ? existingInput.value.trim() : '';
    var newValue = newInput ? newInput.value.trim() : '';

    if (!existingValue || !newValue) {
        showConfirm('confirm-attach');
        return;
    }

    var existingSize = getDeviceSizeBytes(existingValue);
    var newSize = getDeviceSizeBytes(newValue);

    if (existingSize > 0 && newSize > 0 && newSize < existingSize) {
        if (errorEl) {
            errorEl.innerHTML = '无法附加：' + escHtml(newValue) + ' (' +
                formatBytesHuman(newSize) + '）小于 ' + escHtml(existingValue) +
                ' (' + formatBytesHuman(existingSize) + '). The attached disk must be the same size or larger.';
            errorEl.classList.remove('hidden');
        }
        return;
    }

    showConfirm('confirm-attach');
}

function refreshReplaceFreeDisks() {
    // Render the 更换设备 "可用（未使用）ZFS 磁盘" buttons,
    // filtering out any disk that is smaller than the device being replaced.
    if (!pageData) return;
    var oldInput = document.getElementById('replace-old');
    var oldValue = oldInput ? oldInput.value.trim() : '';
    var oldSize = oldValue ? getDeviceSizeBytes(oldValue) : 0;

    var freeDisksList = [];
    var tooSmallDisks = [];
    (pageData.all_disks || []).forEach(function(disk) {
        if (disk.is_system_disk || disk.in_use) return;
        if (oldSize > 0 && (disk.size_bytes || 0) > 0 &&
            (disk.size_bytes || 0) < oldSize) {
            tooSmallDisks.push(disk);
            return;
        }
        freeDisksList.push(disk);
    });

    renderDiskButtonsInto('replace-free-disks', freeDisksList, function(disk) {
        document.getElementById('replace-new').value = disk.device_path;
    });

    var warningEl = document.getElementById('replace-size-warning');
    if (warningEl) {
        if (oldSize > 0 && tooSmallDisks.length > 0) {
            var names = tooSmallDisks.map(function(d) {
                return d.name + ' (' + d.size + ')';
            }).join(', ');
            warningEl.innerHTML = '<span class="text-warning-400">以下磁盘太小，无法作为更换设备使用（至少需要 ' +
                formatBytesHuman(oldSize) + '): </span><span class="text-text-tertiary">' +
                escHtml(names) + '</span>';
            warningEl.classList.remove('hidden');
        } else {
            warningEl.innerHTML = '';
            warningEl.classList.add('hidden');
        }
    }
}

function validateAndShowReplace() {
    // Client-side validation: block submission for single-disk pools and
    // when the selected replacement is smaller than the device being replaced.
    var errorEl = document.getElementById('replace-validation-error');
    if (errorEl) { errorEl.classList.add('hidden'); errorEl.innerHTML = ''; }

    if (pageData && pageData.is_single_disk_pool) {
        if (errorEl) {
            errorEl.innerHTML = '单磁盘存储池没有冗余，因此无法更换设备。请先使用“附加设备”创建镜像。';
            errorEl.classList.remove('hidden');
        }
        return;
    }

    var oldInput = document.getElementById('replace-old');
    var newInput = document.getElementById('replace-new');
    var oldValue = oldInput ? oldInput.value.trim() : '';
    var newValue = newInput ? newInput.value.trim() : '';

    if (!oldValue || !newValue) {
        showConfirm('confirm-replace');
        return;
    }

    var oldSize = getDeviceSizeBytes(oldValue);
    var newSize = getDeviceSizeBytes(newValue);

    if (oldSize > 0 && newSize > 0 && newSize < oldSize) {
        if (errorEl) {
            errorEl.innerHTML = '无法更换：' + escHtml(newValue) + ' (' +
                formatBytesHuman(newSize) + '）小于 ' + escHtml(oldValue) +
                ' (' + formatBytesHuman(oldSize) + '). The replacement disk must be the same size or larger.';
            errorEl.classList.remove('hidden');
        }
        return;
    }

    showConfirm('confirm-replace');
}


function refreshAddVdevDisks() {

    // Re-render the Add VDev disk buttons, filtering for spare size when applicable
    if (!pageData) return;
    var typeSelect = document.getElementById('add-vdev-type');
    var vdevType = typeSelect ? typeSelect.value : '';
    var minSize = pageData.min_data_device_size || 0;

    // Build free disks list (same logic as renderDiskButtons)
    var freeDisksList = [];
    var tooSmallDisks = [];
    (pageData.all_disks || []).forEach(function(disk) {
        if (disk.is_system_disk || disk.in_use) return;
        if (vdevType === 'spare' && minSize > 0 && (disk.size_bytes || 0) < minSize) {
            tooSmallDisks.push(disk);
            return;
        }
        freeDisksList.push(disk);
    });

    renderDiskButtonsInto('add-vdev-disks', freeDisksList, function(disk) {
        appendDevice('add-devices', disk.device_path);
    });

    // Show a warning message if disks were filtered out for spares
    var warningEl = document.getElementById('spare-size-warning');
    if (!warningEl) {
        // Create the warning element if it does not exist
        var container = document.getElementById('add-vdev-disks');
        if (container) {
            var div = document.createElement('div');
            div.id = 'spare-size-warning';
            div.className = 'mt-2 text-xs';
            container.parentNode.insertBefore(div, container.nextSibling);
            warningEl = div;
        }
    }
    if (warningEl) {
        if (vdevType === 'spare' && tooSmallDisks.length > 0) {
            var names = tooSmallDisks.map(function(d) { return d.name + ' (' + d.size + ')'; }).join(', ');
            warningEl.innerHTML = '<span class="text-warning-400">以下磁盘太小，无法用作热备盘（最小 ' +
                formatBytesHuman(minSize) + '): </span><span class="text-text-tertiary">' +
                escHtml(names) + '</span>';
            warningEl.classList.remove('hidden');
        } else {
            warningEl.innerHTML = '';
            warningEl.classList.add('hidden');
        }
    }
}

function updateAuxLayoutOptions() {
    var typeSelect = document.getElementById('add-vdev-type');
    var layoutSection = document.getElementById('aux-layout-section');
    var layoutSelect = document.getElementById('add-vdev-layout');
    var hint = document.getElementById('aux-layout-hint');
    if (!typeSelect || !layoutSection) return;

    var vdevType = typeSelect.value;

    // Clear and rebuild options based on type
    layoutSelect.innerHTML = '';

    if (vdevType === 'spare') {
        // Spares: individual disks only, no layout concept
        layoutSection.style.opacity = '0.4';
        layoutSection.style.pointerEvents = 'none';
        var opt = document.createElement('option');
        opt.value = 'individual'; opt.textContent = '单块磁盘（每块磁盘都是一个独立的热备盘）';
        layoutSelect.appendChild(opt);
        hint.textContent = '热备盘始终以单块磁盘的形式添加，每块设备都会成为独立的热备盘。';
    } else if (vdevType === 'cache') {
        // L2ARC: single disk or stripe only, cannot be mirrored
        layoutSection.style.opacity = '1';
        layoutSection.style.pointerEvents = 'auto';
        var optSingle = document.createElement('option');
        optSingle.value = 'single'; optSingle.textContent = '单块磁盘';
        var optStripe = document.createElement('option');
        optStripe.value = 'stripe'; optStripe.textContent = '条带（多块磁盘）';
        layoutSelect.appendChild(optSingle);
        layoutSelect.appendChild(optStripe);
        hint.textContent = 'L2ARC 缓存不能配置镜像，请使用单块磁盘或将多块磁盘条带化。';
    } else if (vdevType === 'log') {
        // SLOG: single disk or mirror only, cannot be striped
        layoutSection.style.opacity = '1';
        layoutSection.style.pointerEvents = 'auto';
        var optSingle = document.createElement('option');
        optSingle.value = 'single'; optSingle.textContent = '单块磁盘';
        var optMirror = document.createElement('option');
        optMirror.value = 'mirror'; optMirror.textContent = '镜像（推荐）';
        layoutSelect.appendChild(optSingle);
        layoutSelect.appendChild(optMirror);
        optMirror.selected = true;
        hint.textContent = '出于数据安全考虑，SLOG 应配置镜像。SLOG 丢失可能导致待处理的同步写入数据丢失。';
    } else if (vdevType === 'special') {
        // Special metadata: single disk (not recommended) or mirror matching pool redundancy
        layoutSection.style.opacity = '1';
        layoutSection.style.pointerEvents = 'auto';
        var optSingle = document.createElement('option');
        optSingle.value = 'single'; optSingle.textContent = '单块磁盘（不推荐）';
        var optMirror = document.createElement('option');
        optMirror.value = 'mirror'; optMirror.textContent = '镜像（必须与存储池冗余级别一致）';
        layoutSelect.appendChild(optSingle);
        layoutSelect.appendChild(optMirror);
        optMirror.selected = true;
        hint.textContent = '特殊元数据 VDEV 必须配置镜像以匹配存储池的冗余级别（镜像深度、raidz1/2/3）。在没有冗余的情况下丢失特殊 VDEV 将损坏存储池。';
    } else if (vdevType === 'dedup') {
        // Dedup: individual disks, ZFS handles allocation. Should match pool redundancy.
        layoutSection.style.opacity = '0.4';
        layoutSection.style.pointerEvents = 'none';
        var opt = document.createElement('option');
        opt.value = 'individual'; opt.textContent = '单块磁盘（由 ZFS 管理分配）';
        layoutSelect.appendChild(opt);
        hint.textContent = '去重 VDEV 应与存储池的冗余级别匹配（raidz1/2/3 或镜像深度）。ZFS 会在内部处理设备分配。允许使用单块磁盘，但不推荐。';
    }
    // Refresh the Add VDev disk list (filters undersized disks when spare is selected)
    refreshAddVdevDisks();
}

function renderRemovableVdevs(topology) {
    var container = document.getElementById('remove-aux-container');
    var form = document.getElementById('form-remove-aux');
    var removable = [];

    // Collect removable auxiliary vdevs: spare, cache, log
    var removableSections = [
        { key: 'spare_vdevs', label: '热备盘', color: 'warning' },
        { key: 'cache_vdevs', label: '缓存（L2ARC）', color: 'success' },
        { key: 'log_vdevs', label: '日志（SLOG）', color: 'info' }
    ];

    removableSections.forEach(function(sec) {
        var vdevs = topology[sec.key] || [];
        vdevs.forEach(function(vdev) {
            // For single-device vdevs (like spares), list each device
            if (vdev.devices && vdev.devices.length === 1 && (!vdev.type || vdev.type === 'single' || vdev.type === '')) {
                removable.push({
                    name: vdev.devices[0].name,
                    label: sec.label,
                    color: sec.color
                });
            } else {
                // For mirror/multi-device vdevs, use the vdev name
                removable.push({
                    name: vdev.name,
                    label: sec.label + (vdev.type === 'mirror' ? '（镜像）' : ''),
                    color: sec.color
                });
            }
        });
    });

    if (removable.length === 0) {
        container.innerHTML = '<p class="text-text-tertiary text-sm mb-4">此存储池中未找到可移除的辅助 VDEV。只有热备盘、缓存和日志 VDEV 可以移除。</p>';
        form.classList.add('hidden');
        return;
    }

    var html = '<div class="mb-4">';
    html += '<p class="text-xs text-text-tertiary mb-2">点击 VDEV 以选择要移除的项目：</p>';
    html += '<div class="flex flex-wrap gap-2">';
    removable.forEach(function(item, idx) {
        var btnId = 'remove-aux-btn-' + idx;
        html += '<button type="button" id="' + btnId + '" class="disk-btn px-3 py-1.5 text-xs font-mono rounded bg-bg-elevated-2 text-text-secondary border border-' + item.color + '-900/50 hover:border-danger-500 hover:text-danger-400 transition-colors" data-device="' + escAttr(item.name) + '">';
        html += '<span class="text-' + item.color + '-400 font-semibold">' + escHtml(item.label) + '</span> ';
        html += escHtml(item.name);
        html += '</button>';
    });
    html += '</div></div>';
    container.innerHTML = html;

    // Show the form
    form.classList.remove('hidden');

    // Attach click handlers
    removable.forEach(function(item, idx) {
        var btnId = 'remove-aux-btn-' + idx;
        var btn = document.getElementById(btnId);
        if (btn) {
            btn.addEventListener('click', function() {
                document.getElementById('remove-device').value = item.name;
            });
        }
    });
}

function selectRemoveVdev(deviceName) {
    document.getElementById('remove-device').value = deviceName;
}

// ==================== Utility ====================
function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function escAttr(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ==================== Warning Acknowledgment ====================
var ACK_TIMEOUT_MS = 5 * 60 * 1000; // 5 minutes
var ACK_STORAGE_KEY = 'vdev-warning-ack-' + poolName;

function isAckValid() {
    try {
        var stored = sessionStorage.getItem(ACK_STORAGE_KEY);
        if (!stored) return false;
        var ackTime = parseInt(stored, 10);
        if (isNaN(ackTime)) return false;
        return (Date.now() - ackTime) < ACK_TIMEOUT_MS;
    } catch (e) {
        return false;
    }
}

function dismissWarningAndLoad() {
    document.getElementById('vdev-warning-banner').style.display = 'none';
    document.getElementById('vdev-locked-overlay').style.display = 'none';
    document.getElementById('vdev-page-content').style.display = 'block';
    loadPageData();
}


async function acknowledgeWarning() {
    var btn = document.getElementById('btn-acknowledge');
    btn.disabled = true;
    btn.innerHTML = '<div class="loading-spinner loading-spinner-sm"></div> 正在记录确认…';

    try {
        await fetch('/zfs/pools/' + poolName + '/vdevs/acknowledge', { method: 'POST' });
    } catch (err) {
        console.error('Failed to log acknowledgment:', err);
    }

    // Store acknowledgment timestamp (5-minute timeout)
    try {
        sessionStorage.setItem(ACK_STORAGE_KEY, String(Date.now()));
    } catch (e) {
        // sessionStorage may be unavailable; proceed anyway
    }

    dismissWarningAndLoad();
}

// ==================== Init ====================
// If the user acknowledged within the last 5 minutes, skip the warning
if (isAckValid()) {
    dismissWarningAndLoad();
}
</script>
