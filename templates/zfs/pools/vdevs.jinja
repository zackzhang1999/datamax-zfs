{% extends "layout.jinja" %}

{% block content %}
<div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/zfs/pools/{{ pool_name }}" class="hover:text-text-primary transition-colors">{{ pool_name }}</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">VDEV 管理</span>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-text-primary">VDEV 管理</h1>
            <p class="text-text-secondary mt-1">存储池： <span class="font-semibold text-text-primary">{{ pool_name }}</span></p>
        </div>
        <a href="/zfs/pools/{{ pool_name }}" class="btn-secondary inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Pool
        </a>
    </div>

    <!-- Data Safety Warning Banner with Acknowledgment Gate -->
    <div id="vdev-warning-banner" class="bg-danger-900/20 border-2 border-danger-500 rounded-xl p-4">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="flex-1">
                <h3 class="text-sm font-semibold text-danger-400 mb-1">警告：数据丢失风险</h3>
                <p class="text-xs text-text-secondary mb-3">错误选择磁盘或不当的 VDEV 操作可能导致 <strong class="text-danger-300">不可逆的数据损坏或丢失</strong>。确认任何更改前，请仔细核对所有设备名称和操作参数；修改存储池拓扑前，请确保您已核实哪些磁盘正在使用并拥有最新的备份。</p>
                <button type="button" id="btn-acknowledge"
                        class="btn-danger text-sm inline-flex items-center gap-2"
                        onclick="acknowledgeWarning()">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    I Understand the Risks -- Proceed
                </button>
            </div>
        </div>
    </div>

    <!-- Greyed out placeholder when not acknowledged -->
    <div id="vdev-locked-overlay" class="relative">
        <div class="absolute inset-0 bg-bg-base/70 backdrop-blur-[1px] z-40 rounded-xl cursor-not-allowed"></div>
        <div class="opacity-30 pointer-events-none select-none">
            <div class="card p-8 text-center">
                <svg class="w-16 h-16 mx-auto text-text-tertiary mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                <p class="text-text-tertiary text-sm">请先确认上述数据安全警告，才能使用 VDEV 管理操作。</p>
            </div>
        </div>
    </div>

    <!-- All page content gated behind acknowledgment (hidden until acknowledged) -->
    <div id="vdev-page-content" style="display: none;">

    <!-- Success/Error Messages -->
    {% if request.query_params.get('message') %}
    <div class="alert-success animate-slide-in" role="alert">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="flex-1 ml-3">
                <div class="text-sm text-success-300">{{ request.query_params.get('message') }}</div>
            </div>
            <button type="button" class="flex-shrink-0 ml-4 inline-flex text-success-400 hover:text-success-300 p-1.5 rounded-lg" onclick="this.closest('.alert-success').remove()">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </button>
        </div>
    </div>
    {% endif %}
    {% if request.query_params.get('error') %}
    <div class="alert-danger animate-slide-in" role="alert">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <svg class="w-5 h-5 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="flex-1 ml-3">
                <pre class="whitespace-pre-wrap font-mono text-xs text-danger-300">{{ request.query_params.get('error') }}</pre>
            </div>
            <button type="button" class="flex-shrink-0 ml-4 inline-flex text-danger-400 hover:text-danger-300 p-1.5 rounded-lg" onclick="this.closest('.alert-danger').remove()">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </button>
        </div>
    </div>
    {% endif %}

    <!-- Loading 状态 -->
    <div id="loading-state" class="card">
        <div class="flex items-center justify-center py-12">
            <div class="flex flex-col items-center gap-4">
                <div class="loading-spinner loading-spinner-lg"></div>
                <p class="text-text-secondary text-sm">正在加载存储池拓扑和磁盘信息…</p>
                <p class="text-text-tertiary text-xs">在磁盘较多的系统上，此操作可能需要一些时间。</p>
            </div>
        </div>
    </div>

    <!-- Error 状态 (hidden by default) -->
    <div id="error-state" class="card hidden">
        <div class="flex items-center justify-center py-12">
            <div class="flex flex-col items-center gap-4 text-center">
                <svg class="w-12 h-12 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p class="text-text-primary font-semibold">数据加载失败</p>
                <p id="error-state-message" class="text-text-secondary text-sm"></p>
                <button type="button" onclick="loadPageData()" class="btn-primary">重试</button>
            </div>
        </div>
    </div>

    <!-- Main Content (hidden until data loads) -->
    <div id="main-content" class="space-y-6 hidden">

        <!-- Resilvering Status Banner -->
        <div id="resilver-banner" class="card bg-info-900/20 border border-info-700/50 hidden">
            <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-info-400 flex-shrink-0 mt-0.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                <div>
                    <h3 class="text-info-400 font-semibold">正在数据修复（Resilver）</h3>
                    <p id="resilver-info" class="text-text-secondary text-sm mt-1"></p>
                </div>
            </div>
        </div>

        <!-- Pool Topology -->
        <div class="card">
            <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                Pool Topology
            </h2>
            <div id="topology-container">
                <p class="text-text-tertiary text-sm">没有可用的拓扑信息。</p>
            </div>
        </div>

        <!-- 磁盘状态 Legend + Detect Button -->
        <div class="card">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                    <svg class="w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                    </svg>
                    System Disks
                </h2>
                <div class="flex flex-col items-end gap-1">
                    <button type="button"
                            onclick="showConfirm('confirm-check-disks')"
                            class="btn-warning text-sm py-2 px-3 inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        检测正在使用的磁盘
                    </button>
                    <span class="text-xs text-text-tertiary italic">（仅 Linux）</span>
                </div>
            </div>

            <!-- 磁盘状态 Legend -->
            <div class="p-3 bg-bg-elevated rounded-lg border border-border-subtle mb-4">
                <h3 class="text-xs font-semibold text-text-primary mb-2 uppercase tracking-wider">磁盘状态</h3>
                <div class="space-y-2 text-xs">
                    <div class="flex items-center gap-2">
                        <div class="w-5 h-5 rounded border-2 flex-shrink-0" style="border-color: #dc2626; background-color: rgba(153, 27, 27, 0.5);"></div>
                        <span class="text-text-secondary"><strong>操作系统/系统磁盘</strong> - 不可使用（包含操作系统/交换空间）</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-5 h-5 rounded border-2 flex-shrink-0" style="border-color: #f87171; background-color: rgba(153, 27, 27, 0.3);"></div>
                        <span class="text-text-secondary">正在使用的存储池 - 无法用于添加/附加</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-5 h-5 rounded border-2 flex-shrink-0" style="border-color: #fbbf24; background-color: rgba(120, 53, 15, 0.3);"></div>
                        <span class="text-text-secondary">带有 ZFS 标签 - 请谨慎使用</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-5 h-5 rounded border-2 flex-shrink-0 bg-success-900/30" style="border-color: #4ade80;"></div>
                        <span class="text-text-secondary">可用 - 可自由使用</span>
                    </div>
                </div>
            </div>

            <!-- Available Disks (populated by JS) -->
            <div id="available-disks-container">
                <p class="text-text-tertiary text-sm text-center py-4">磁盘数据将随页面数据一起加载。</p>
            </div>
        </div>

        <!-- Operations Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- 附加设备 (Create/Extend 镜像) -->
            <div id="card-attach" class="card">
                <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                    </svg>
                    附加设备（镜像）
                </h2>
                <div class="mb-4 p-3 bg-info-900/20 border border-info-700/40 rounded-lg text-xs text-info-300">
                    <strong class="text-info-200">大小要求：</strong> 新设备的大小必须与现有设备相同或更大，较小的磁盘无法附加。
                </div>
                <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/attach" id="form-attach">
                    <div class="space-y-3">
                        <div>
                            <label for="attach-existing" class="form-label">存储池中的现有设备</label>
                            <input type="text" id="attach-existing" name="existing_device" required
                                   placeholder="例如：/dev/sda 或 sda"
                                   class="form-input w-full">
                            <p class="text-xs text-text-tertiary mt-1">该设备已在存储池中，用于组成镜像</p>
                        </div>
                        <div>
                            <label class="form-label">存储池设备</label>
                            <div id="attach-pool-devices" class="flex flex-wrap gap-1.5">
                                <span class="text-xs text-text-tertiary">正在加载…</span>
                            </div>
                        </div>
                        <div>
                            <label for="attach-new" class="form-label">要附加的新设备</label>
                            <input type="text" id="attach-new" name="new_device" required
                                   placeholder="例如：/dev/sdb"
                                   class="form-input w-full">
                        </div>
                        <div>
                            <label class="form-label">可用（未使用）ZFS 磁盘</label>
                            <p class="text-xs text-warning-400 mb-1">这些磁盘可能正被其他文件系统使用，使用前请核实。 小于所选现有设备的磁盘不可选择。</p>
                            <div id="attach-free-disks" class="flex flex-wrap gap-1.5">
                                <span class="text-xs text-text-tertiary">正在加载…</span>
                            </div>
                            <div id="attach-size-warning" class="mt-2 text-xs hidden"></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="attach-force" name="force" value="true"
                                   class="rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                            <label for="attach-force" class="text-sm text-text-secondary">强制</label>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn-primary inline-flex items-center gap-2"
                                onclick="validateAndShowAttach()">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"></path>
                            </svg>
                            附加设备
                        </button>
                        <div id="attach-validation-error" class="hidden mt-2 p-2 rounded bg-danger-500/10 border border-danger-500/30 text-danger-300 text-sm"></div>
                    </div>
                </form>
            </div>


            <!-- 更换设备 -->
            <div id="card-replace" class="card">
                <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                    更换设备
                </h2>
                <div class="mb-4 p-3 bg-info-900/20 border border-info-700/40 rounded-lg text-xs text-info-300">
                    <strong class="text-info-200">大小要求：</strong> 更换设备的大小必须与被更换设备相同或更大，较小的磁盘无法使用。
                </div>
                <div id="replace-single-disk-notice" class="mb-4 p-3 bg-bg-elevated rounded-lg border border-border-subtle text-xs text-text-tertiary hidden">
                    <strong class="text-text-secondary">不可用：</strong> Replace is disabled because this pool consists of a single disk with no redundancy. Use 附加设备 to add a mirror first, or create a new pool with redundancy.
                </div>
                <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/replace" id="form-replace">
                    <div class="space-y-3">
                        <div>
                            <label for="replace-old" class="form-label">要更换的设备（存储池内）</label>
                            <input type="text" id="replace-old" name="old_device" required
                                   placeholder="例如：/dev/sda 或 sda"
                                   class="form-input w-full">
                        </div>
                        <div>
                            <label class="form-label">存储池设备</label>
                            <div id="replace-pool-devices" class="flex flex-wrap gap-1.5">
                                <span class="text-xs text-text-tertiary">正在加载…</span>
                            </div>
                        </div>
                        <div>
                            <label for="replace-new" class="form-label">更换设备（未使用）</label>
                            <input type="text" id="replace-new" name="new_device" required
                                   placeholder="例如：/dev/sdb"
                                   class="form-input w-full">
                        </div>
                        <div>
                            <label class="form-label">可用（未使用）ZFS 磁盘</label>
                            <p class="text-xs text-warning-400 mb-1">这些磁盘可能正被其他文件系统使用，使用前请核实。 小于被更换设备的磁盘不可选择。</p>
                            <div id="replace-free-disks" class="flex flex-wrap gap-1.5">
                                <span class="text-xs text-text-tertiary">正在加载…</span>
                            </div>
                            <div id="replace-size-warning" class="mt-2 text-xs hidden"></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="replace-force" name="force" value="true"
                                   class="rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                            <label for="replace-force" class="text-sm text-text-secondary">强制</label>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn-info inline-flex items-center gap-2"
                                onclick="validateAndShowReplace()">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                            </svg>
                            更换设备
                        </button>
                        <div id="replace-validation-error" class="hidden mt-2 p-2 rounded bg-danger-500/10 border border-danger-500/30 text-danger-300 text-sm"></div>
                    </div>
                </form>
            </div>


            <!-- 分离 / Remove / Online / Offline -->
            <div class="card">
                <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    设备 Operations
                </h2>
                <div class="space-y-4">
                    <!-- 分离 -->
                    <div class="card-nested" id="detach-section">
                        <h3 class="text-sm font-semibold text-text-primary mb-2">从镜像中分离</h3>
                        <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/detach" id="form-detach">
                            <div class="flex flex-col sm:flex-row gap-2">
                                <input type="text" id="detach-device" name="device" required
                                       placeholder="要分离的设备"
                                       class="form-input flex-1">
                                <button type="button" class="btn-danger inline-flex items-center gap-2"
                                        onclick="showConfirm('confirm-detach')">
                                    分离
                                </button>
                            </div>
                            <p class="text-xs text-text-tertiary mt-1">仅适用于镜像 VDEV 中的设备。</p>
                        </form>
                    </div>

                    <!-- Online -->
                    <div class="card-nested" id="online-section">
                        <h3 class="text-sm font-semibold text-text-primary mb-2">使设备上线</h3>
                        <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/online" id="form-online">
                            <div class="flex flex-col sm:flex-row gap-2 items-end">
                                <div class="flex-1 w-full">
                                    <input type="text" id="online-device" name="device" required
                                           placeholder="要使上线的设备"
                                           class="form-input w-full">
                                </div>
                                <button type="button" class="btn-success inline-flex items-center gap-2"
                                        onclick="showConfirm('confirm-online')">
                                    Online
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Offline -->
                    <div class="card-nested">
                        <h3 class="text-sm font-semibold text-text-primary mb-2">使设备下线</h3>
                        <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/offline" id="form-offline">
                            <div class="flex flex-col sm:flex-row gap-2 items-end">
                                <div class="flex-1 w-full">
                                    <input type="text" id="offline-device" name="device" required
                                           placeholder="要使下线的设备"
                                           class="form-input w-full">
                                </div>
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" id="offline-temp" name="temporary" value="true"
                                           class="rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                                    <label for="offline-temp" class="text-sm text-text-secondary whitespace-nowrap">临时</label>
                                </div>
                                <button type="button" class="btn-warning inline-flex items-center gap-2"
                                        onclick="showConfirm('confirm-offline')">
                                    Offline
                                </button>
                            </div>
                            <p class="text-xs text-text-tertiary mt-1">临时：设备将在重启后自动上线。</p>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Auxiliary VDEV 管理 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- 添加辅助 VDEV -->
            <div id="card-add-aux" class="card">
                <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    添加辅助 VDEV
                </h2>
                <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/add" id="form-add-vdev">
                    <div class="space-y-3">
                        <div>
                            <label for="add-vdev-type" class="form-label">VDEV 类型</label>
                            <select id="add-vdev-type" name="vdev_type" class="form-input w-full" onchange="updateAuxLayoutOptions()">
                                <optgroup label="可移除（可添加和移除）">
                                    <option value="spare">热备盘</option>
                                    <option value="cache">缓存（L2ARC）</option>
                                    <option value="log">日志（SLOG）</option>
                                </optgroup>
                                <optgroup label="永久性（一旦添加便无法移除）">
                                    <option value="special">特殊元数据 VDEV</option>
                                    <option value="dedup">去重 VDEV</option>
                                </optgroup>
                            </select>
                        </div>
                        <div id="aux-layout-section">
                            <label for="add-vdev-layout" class="form-label">布局</label>
                            <select id="add-vdev-layout" name="vdev_layout" class="form-input w-full">
                                <option value="stripe">条带（单块磁盘或多块磁盘条带化）</option>
                                <option value="mirror">镜像</option>
                            </select>
                            <p id="aux-layout-hint" class="text-xs text-text-tertiary mt-1">热备盘会忽略布局设置（热备盘始终为单块磁盘）。</p>
                        </div>
                        <div>
                            <label for="add-devices" class="form-label">设备</label>
                            <input type="text" id="add-devices" name="devices" required
                                   placeholder="例如：/dev/sdb,/dev/sdc"
                                   class="form-input w-full">
                            <p class="text-xs text-text-tertiary mt-1">设备路径的逗号分隔列表。镜像请提供 2 个或更多设备。</p>
                        </div>
                        <div>
                            <label class="form-label">可用（未使用）ZFS 磁盘</label>
                            <p class="text-xs text-warning-400 mb-1">这些磁盘可能正被其他文件系统使用，使用前请核实。</p>
                            <div id="add-vdev-disks" class="flex flex-wrap gap-1.5">
                                <span class="text-xs text-text-tertiary">正在加载…</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="add-force" name="force" value="true"
                                   class="rounded border-border-subtle bg-bg-elevated-2 text-primary-500 focus:ring-primary-500">
                            <label for="add-force" class="text-sm text-text-secondary">强制（即使设备看似正在使用也使用）</label>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn-success inline-flex items-center gap-2"
                                onclick="validateAndShowAddVdev()">
                                onclick="showConfirm('confirm-add-vdev')">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            添加辅助 VDEV
                        </button>
                        <div id="add-vdev-validation-error" class="hidden mt-2 p-2 rounded bg-danger-500/10 border border-danger-500/30 text-danger-300 text-sm"></div>
                    </div>
                </form>
            </div>

            <!-- Remove Auxiliary VDev -->
            <div class="card">
                <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Remove Auxiliary VDev
                </h2>
                <div id="remove-aux-container">
                    <p class="text-text-tertiary text-sm">正在加载可移除的 VDEV…</p>
                </div>
                <form method="post" action="/zfs/pools/{{ pool_name }}/vdevs/remove" id="form-remove-aux" class="hidden">
                    <div class="space-y-3">
                        <div>
                            <label for="remove-device" class="form-label">要移除的 VDEV / 设备</label>
                            <input type="text" id="remove-device" name="device" required
                                   placeholder="从上方列表中选择"
                                   class="form-input w-full" readonly>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn-danger inline-flex items-center gap-2"
                                onclick="showConfirm('confirm-remove-aux')">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            Remove VDev
                        </button>
                    </div>
                </form>
                <div class="mt-4 p-3 bg-bg-elevated rounded-lg border border-border-subtle">
                    <p class="text-xs text-text-tertiary">
                        <strong class="text-text-secondary">可移除：</strong> 热备盘、缓存（L2ARC）、日志（SLOG）VDEV。<br>
                        <strong class="text-warning-400">不可移除：</strong> 特殊元数据、去重和 BRT VDEV 一旦添加便无法移除。
                    </p>
                </div>
            </div>
        </div>

        <!-- Safety Notes -->
        <div class="card-nested">
            <h3 class="text-sm font-semibold text-text-primary mb-2">操作说明</h3>
            <ul class="text-xs text-text-tertiary space-y-1 list-disc list-inside">
                <li><strong class="text-text-secondary">添加辅助 VDEV:</strong> 添加热备盘、缓存、日志、特殊或去重 VDEV。热备盘、缓存和日志之后可移除；特殊和去重 VDEV 为永久性。</li>
                <li><strong class="text-text-secondary">移除辅助 VDEV：</strong> 从存储池中移除热备盘、缓存或日志 VDEV。</li>
                <li><strong class="text-text-secondary">附加：</strong> 将磁盘附加到现有设备上，以创建或扩展镜像，并触发数据修复（resilver）。</li>
                <li><strong class="text-text-secondary">分离:</strong> 从镜像中移除一块设备，镜像会继续使用其余设备运行。</li>
                <li><strong class="text-text-secondary">更换：</strong> 用一块新磁盘替换原磁盘，存储池会将数据修复到新磁盘上。</li>
                <li><strong class="text-text-secondary">上线/下线：</strong> 控制设备在存储池中的可用状态，而无需将其从拓扑中移除。</li>
            </ul>
        </div>

        <!-- Back -->
        <div>
            <a href="/zfs/pools/{{ pool_name }}" class="text-text-secondary hover:text-text-primary inline-flex items-center gap-2 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to Pool Detail
            </a>
        </div>
    </div>
</div>

</div> <!-- end #vdev-page-content -->

