<script>
var pageData = null;
var poolName = '{{ pool_name }}';
var disksChecked = false;

// ==================== Modal Helper ====================
window.showConfirm = function(dialogId) {
    var dialog = document.getElementById(dialogId);
    if (!dialog) { console.error('Dialog not found:', dialogId); return; }
    if (window.Alpine) {
        var component = window.Alpine.$data(dialog);
        if (component) { component.open = true; return; }
    }
    if (dialog.__x) { dialog.__x.$data.open = true; return; }
    dialog.dispatchEvent(new CustomEvent('open-modal'));
};

// ==================== Async Page Load ====================
async function loadPageData() {
    document.getElementById('loading-state').classList.remove('hidden');
    document.getElementById('error-state').classList.add('hidden');
    document.getElementById('main-content').classList.add('hidden');

    try {
        var response = await fetch('/zfs/pools/' + poolName + '/vdevs/data');
        var data = await response.json();

        if (!data.success) {
            throw new Error(data.error || '未知错误');
        }

        pageData = data;
        renderTopology(data.topology);
        renderDiskButtons(data.all_disks, data.pool_devices);
        renderResilverBanner(data.topology);
        applyPoolTypeConstraints(data.topology);
        renderRemovableVdevs(data.topology);
        updateAuxLayoutOptions();
        // Wire up the existing-device input to re-filter the available disks
        // so that disks smaller than the existing device cannot be selected.
        var existingInput = document.getElementById('attach-existing');
        if (existingInput && !existingInput.dataset.attachListenerWired) {
            existingInput.addEventListener('input', refreshAttachFreeDisks);
            existingInput.addEventListener('change', refreshAttachFreeDisks);
            existingInput.dataset.attachListenerWired = '1';
        }
        refreshAttachFreeDisks();

        // Same wiring for the Replace card "设备 to Replace" input.
        var replaceOldInput = document.getElementById('replace-old');
        if (replaceOldInput && !replaceOldInput.dataset.replaceListenerWired) {
            replaceOldInput.addEventListener('input', refreshReplaceFreeDisks);
            replaceOldInput.addEventListener('change', refreshReplaceFreeDisks);
            replaceOldInput.dataset.replaceListenerWired = '1';
        }
        refreshReplaceFreeDisks();



        document.getElementById('loading-state').classList.add('hidden');
        document.getElementById('main-content').classList.remove('hidden');

        // Lock operation cards until disk check is completed
        lockOperationCards();
    } catch (err) {
        document.getElementById('loading-state').classList.add('hidden');
        document.getElementById('error-state').classList.remove('hidden');
        document.getElementById('error-state-message').textContent = err.message || '获取数据失败';
    }
}

// ==================== Resilver Banner ====================
function renderResilverBanner(topology) {
    var banner = document.getElementById('resilver-banner');
    var info = topology.scan_info || '';
    if (info.toLowerCase().indexOf('resilver') !== -1) {
        document.getElementById('resilver-info').textContent = info;
        banner.classList.remove('hidden');
    } else {
        banner.classList.add('hidden');
    }
}

// ==================== Topology Rendering ====================
function renderTopology(topology) {
    var container = document.getElementById('topology-container');
    var html = '';

    var sections = [
        { key: 'data_vdevs', label: 'Data VDevs', color: 'primary' },
        { key: 'log_vdevs', label: '日志（SLOG）VDEV', color: 'info' },
        { key: 'cache_vdevs', label: '缓存（L2ARC）VDEV', color: 'success' },
        { key: 'spare_vdevs', label: '热备盘', color: 'warning' },
        { key: 'special_vdevs', label: '特殊 VDEV', color: 'purple' },
        { key: 'dedup_vdevs', label: '去重 VDEV', color: 'indigo' }
    ];

    var hasAny = false;
    sections.forEach(function(sec) {
        var vdevs = topology[sec.key] || [];
        if (vdevs.length === 0) return;
        hasAny = true;

        html += '<div class="mb-6 last:mb-0">';
        html += '<h3 class="text-sm font-semibold text-' + sec.color + '-400 uppercase tracking-wider mb-3">' + sec.label + '</h3>';

        vdevs.forEach(function(vdev) {
            var typeBadge = '';
            if (vdev.type === 'mirror') {
                typeBadge = '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-primary-900/50 text-primary-400 border border-primary-900">镜像</span>';
            } else if (vdev.type && vdev.type.indexOf('raidz') === 0) {
                typeBadge = '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-purple-900/50 text-purple-400 border border-purple-900">' + vdev.type.toUpperCase() + '</span>';
            } else {
                typeBadge = '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-bg-elevated-2 text-text-secondary border border-border-subtle">单盘</span>';
            }

            var stateBadge = stateHtml(vdev.state);

            html += '<div class="card-nested mb-3">';
            html += '<div class="flex items-center justify-between mb-2"><div class="flex items-center gap-2">' + typeBadge + '<span class="text-text-primary font-mono text-sm">' + escHtml(vdev.name) + '</span></div><div>' + stateBadge + '</div></div>';

            // 设备 table
            html += '<div class="overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b border-border-subtle">';
            html += '<th class="text-left py-1.5 px-2 text-text-tertiary font-medium text-xs">设备</th>';
            html += '<th class="text-left py-1.5 px-2 text-text-tertiary font-medium text-xs">状态</th>';
            html += '<th class="text-right py-1.5 px-2 text-text-tertiary font-medium text-xs">读取</th>';
            html += '<th class="text-right py-1.5 px-2 text-text-tertiary font-medium text-xs">写入</th>';
            html += '<th class="text-right py-1.5 px-2 text-text-tertiary font-medium text-xs">校验和</th>';
            html += '<th class="text-right py-1.5 px-2 text-text-tertiary font-medium text-xs">操作</th>';
            html += '</tr></thead><tbody>';

            (vdev.devices || []).forEach(function(dev) {
                var errClass = function(v) { return v > 0 ? 'text-danger-400' : 'text-text-tertiary'; };
                html += '<tr class="border-b border-border-subtle/30">';
                html += '<td class="py-1.5 px-2 font-mono text-text-primary text-xs">' + escHtml(dev.name);
                if (dev.notes) html += ' <span class="text-info-400">(' + escHtml(dev.notes) + ')</span>';
                html += '</td>';
                html += '<td class="py-1.5 px-2">' + stateHtml(dev.state) + '</td>';
                html += '<td class="py-1.5 px-2 text-right font-mono text-xs ' + errClass(dev.read_errors) + '">' + dev.read_errors + '</td>';
                html += '<td class="py-1.5 px-2 text-right font-mono text-xs ' + errClass(dev.write_errors) + '">' + dev.write_errors + '</td>';
                html += '<td class="py-1.5 px-2 text-right font-mono text-xs ' + errClass(dev.cksum_errors) + '">' + dev.cksum_errors + '</td>';
                html += '<td class="py-1.5 px-2 text-right"><div class="flex items-center justify-end gap-1">';

                // Action buttons
                if (dev.state === 'ONLINE') {
                    html += '<button type="button" class="text-text-tertiary hover:text-warning-400 transition-colors p-0.5" title="下线" onclick="prepareDeviceAction(\'offline\', \'' + escAttr(dev.name) + '\')"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg></button>';
                } else if (dev.state === 'OFFLINE') {
                    html += '<button type="button" class="text-text-tertiary hover:text-success-400 transition-colors p-0.5" title="上线" onclick="prepareDeviceAction(\'online\', \'' + escAttr(dev.name) + '\')"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>';
                }
                html += '<button type="button" class="text-text-tertiary hover:text-info-400 transition-colors p-0.5" title="更换设备" onclick="prepareReplace(\'' + escAttr(dev.name) + '\')"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg></button>';
                if (vdev.type === 'mirror') {
                    html += '<button type="button" class="text-text-tertiary hover:text-danger-400 transition-colors p-0.5" title="从镜像中分离" onclick="prepareDetach(\'' + escAttr(dev.name) + '\')"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></button>';
                }
                html += '</div></td></tr>';
            });
            html += '</tbody></table></div>';

            // Quick attach link for single/mirror data vdevs
            if (sec.key === 'data' && (vdev.type === 'single' || vdev.type === 'mirror')) {
                var firstDev = (vdev.devices && vdev.devices.length > 0) ? vdev.devices[0].name : '';
                var attachLabel = vdev.type === 'single' ? '附加磁盘以创建镜像' : '附加磁盘以扩展镜像';
                html += '<div class="mt-2 pt-2 border-t border-border-subtle/30"><button type="button" class="text-xs text-primary-400 hover:text-primary-300 transition-colors inline-flex items-center gap-1" onclick="prepareAttach(\'' + escAttr(firstDev) + '\')"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>' + attachLabel + '</button></div>';
            }

            html += '</div>';
        });
        html += '</div>';
    });

    if (!hasAny) {
        html = '<p class="text-text-tertiary text-sm">没有可用的拓扑信息。</p>';
    }
    container.innerHTML = html;
}

function stateHtml(state) {
    if (state === 'ONLINE') return '<span class="text-success-400 text-xs font-medium">在线</span>';
    if (state === 'DEGRADED') return '<span class="text-warning-400 text-xs font-semibold">降级</span>';
    if (state === 'FAULTED' || state === 'UNAVAIL' || state === 'REMOVED') return '<span class="text-danger-400 text-xs font-semibold">' + (state === 'FAULTED' ? '故障' : state === 'UNAVAIL' ? '不可用' : '已移除') + '</span>';
    if (state === 'OFFLINE') return '<span class="text-text-tertiary text-xs font-medium">离线</span>';
    return '<span class="text-text-tertiary text-xs">' + (state || '') + '</span>';
}

// ==================== Disk Button Rendering ====================
function renderDiskButtons(allDisks, poolDevices) {
    // Categorize disks
    var freeDisksList = [];
    var systemDisksList = [];
    var inUseDisksList = [];

    allDisks.forEach(function(disk) {
        if (disk.is_system_disk) {
            systemDisksList.push(disk);
        } else if (disk.in_use) {
            inUseDisksList.push(disk);
        } else {
            freeDisksList.push(disk);
        }
    });

    // Render the system disks summary area
    renderAvailableDisksSection(allDisks, freeDisksList, systemDisksList, inUseDisksList);

    // Render free disk buttons for Add VDev. The full list is rendered here;
    // the spare-size filter is applied separately by refreshAddVdevDisks().
    renderDiskButtonsInto('add-vdev-disks', freeDisksList, function(disk) {
        appendDevice('add-devices', disk.device_path);
    });

    // Re-apply the auxiliary vdev type filter so spares filter undersized disks
    // even after a re-render triggered by a disk check.
    refreshAddVdevDisks();

    // Render free disk buttons for Attach (new device). The size filter against
    // the existing device is applied by refreshAttachFreeDisks().
    refreshAttachFreeDisks();

    // Render pool device buttons for Attach (existing device).
    // Selecting a pool device updates the size filter for available disks.
    renderPoolDeviceButtonsInto('attach-pool-devices', poolDevices, function(devName) {
        document.getElementById('attach-existing').value = devName;
        refreshAttachFreeDisks();
    });

    // If there is exactly one possible existing device, pre-populate the
    // input so the size filter for "Available Disks" activates immediately
    // without requiring the user to click the pool device button first.
    var attachExistingEl = document.getElementById('attach-existing');
    if (attachExistingEl && !attachExistingEl.value && poolDevices && poolDevices.length === 1) {
        attachExistingEl.value = poolDevices[0];
    }

    // Render pool device buttons for Replace (old device).
    // Selecting a pool device updates the size filter for available disks.
    renderPoolDeviceButtonsInto('replace-pool-devices', poolDevices, function(devName) {
        document.getElementById('replace-old').value = devName;
        refreshReplaceFreeDisks();
    });

    // Same auto-populate behavior for the Replace card so the size filter
    // applies as soon as the page loads.
    var replaceOldEl = document.getElementById('replace-old');
    if (replaceOldEl && !replaceOldEl.value && poolDevices && poolDevices.length === 1) {
        replaceOldEl.value = poolDevices[0];
    }

    // Render free disk buttons for Attach with the now-populated existing
    // device value, then the same for Replace. These calls must happen
    // after the auto-populate above so the filter sees the value.
    refreshAttachFreeDisks();
    refreshReplaceFreeDisks();
}



