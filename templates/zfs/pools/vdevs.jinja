    }

    // In-use disks
    if (inUseDisksList.length > 0) {
        html += '<div class="mb-4"><h3 class="text-sm font-semibold text-danger-400 mb-2">正在使用的磁盘（' + inUseDisksList.length + '）</h3>';
        html += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">';
        inUseDisksList.forEach(function(disk) {
            html += '<div class="disk-btn disk-btn-active px-3 py-2 text-xs font-mono rounded-lg border-2">';
            html += '<div class="font-semibold">' + escHtml(disk.name) + '</div>';
            html += '<div class="text-text-tertiary">' + escHtml(disk.size) + ' ' + escHtml(disk.type) + '</div>';
            html += '</div>';
        });
        html += '</div></div>';
    }

    // System disks
    if (systemDisksList.length > 0) {
        html += '<div><h3 class="text-sm font-semibold text-danger-400 mb-2">系统磁盘（' + systemDisksList.length + '）</h3>';
        html += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">';
        systemDisksList.forEach(function(disk) {
            html += '<div class="disk-btn disk-btn-system px-3 py-2 text-xs font-mono rounded-lg border-2">';
            html += '<div class="font-semibold">' + escHtml(disk.name) + '</div>';
            html += '<div class="text-text-tertiary">' + escHtml(disk.size) + '</div>';
            if (disk.system_usage) html += '<div class="text-danger-300 text-xs mt-1">' + escHtml(disk.system_usage) + '</div>';
            html += '</div>';
        });
