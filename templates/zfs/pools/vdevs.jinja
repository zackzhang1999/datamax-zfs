        html += '<p class="text-xs text-warning-400 mb-2">这些磁盘可能正被其他文件系统使用，使用前请核实。</p>';
        html += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">';
        freeDisksList.forEach(function(disk) {
            html += '<div class="disk-btn px-3 py-2 text-xs font-mono rounded-lg bg-bg-elevated-2 text-text-primary border-2 border-success-900/50">';
            html += '<div class="font-semibold">' + escHtml(disk.name) + '</div>';
            html += '<div class="text-text-tertiary">' + escHtml(disk.size) + ' ' + escHtml(disk.type) + '</div>';
            if (disk.model && disk.model !== 'Unknown') html += '<div class="text-text-tertiary truncate" title="' + escAttr(disk.model) + '">' + escHtml(disk.model) + '</div>';
            html += '</div>';
