{% extends "layout.jinja" %}

{% block content %}
<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/zfs/pools/{{ pool_name }}" class="hover:text-text-primary transition-colors">{{ pool_name }}</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">导出</span>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-text-primary">导出存储池</h1>
        <p class="text-text-secondary mt-1">安全导出存储池以便维护或迁移</p>
    </div>

    <!-- Warning -->
    <div class="bg-warning-900/20 border-2 border-warning-500 rounded-xl p-6">
        <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <div class="flex-1">
                <h3 class="text-lg font-semibold text-warning-400 mb-2">警告：关键操作</h3>
                <p class="text-text-secondary mb-3">您即将导出存储池 <strong class="font-mono text-text-primary">{{ pool_name }}</strong>。</p>
                <ul class="text-sm text-text-secondary space-y-2">
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-warning-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                        <span>此存储池中的所有数据集将被卸载</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-warning-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                        <span>重新导入之前，该存储池将无法访问</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-warning-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                        <span>任何正在使用该存储池数据集的活动进程都将被中断</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-success-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>数据将安全保留在磁盘上，以后可以重新导入</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Confirmation Form -->
    <div class="card">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-text-primary mb-4">确认导出</h2>
            
            <form method="post" action="/zfs/pools/{{ pool_name }}/export" class="space-y-4" id="form-export-pool" hx-boost="false">
                <p class="text-sm text-text-secondary">
                    这将卸载存储池中的所有数据集，并将其从活动存储池列表中移除。
                    该存储池可以随时重新导入，不会删除任何数据。
                </p>

                <!-- Buttons -->
                <div class="flex justify-end gap-3 pt-4">
                    <a href="/zfs/pools/{{ pool_name }}" class="btn-secondary">
                        取消
                    </a>
                    <button type="button" 
                            class="btn-danger"
                            onclick="showConfirm('confirm-export-pool')">
                        导出存储池
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Information -->
    <div class="card-nested">
        <h3 class="text-sm font-semibold text-text-primary mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            导出存储池时会发生什么？
        </h3>
        <ol class="text-sm text-text-secondary space-y-2">
            <li class="flex items-start gap-2">
                <span class="text-text-tertiary font-medium">1.</span>
                <span>存储池中的所有数据集被卸载</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-text-tertiary font-medium">2.</span>
                <span>存储池从活动存储池列表中移除</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-text-tertiary font-medium">3.</span>
                <span>存储池的配置写入磁盘</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-text-tertiary font-medium">4.</span>
                <span>存储池可以在本机或其他系统上重新导入</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-text-tertiary font-medium">5.</span>
                <span>不会删除任何数据——所有内容都保留在物理磁盘上</span>
            </li>
        </ol>
    </div>
</div>

<!-- Export In-Progress Overlay -->
<div id="export-progress-overlay" class="modal-overlay" style="display: none;">
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="modal modal-sm text-center">
                <div class="flex items-center justify-center mb-4">
                    <div class="loading-spinner"></div>
                </div>
                <h3 class="text-xl font-semibold text-text-primary mb-2">正在导出存储池</h3>
                <p class="text-text-secondary">
                    正在导出存储池 <strong class="font-mono text-text-primary">{{ pool_name }}</strong>。
                    卸载所有数据集可能需要一些时间，请稍候。
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
{% set id = 'confirm-export-pool' %}
{% set title = '导出 ZFS 存储池' %}
{% set message = '确定要导出 ' ~ pool_name ~ ' 吗？所有数据集将被卸载，在重新导入之前该存储池将无法访问。' %}
{% set confirm_text = '导出存储池' %}
{% set confirm_class = 'danger' %}
{% set confirm_action = 'submitExportForm()' %}
{% include 'partials/confirm.jinja' %}


<script>
// Show the export in-progress overlay so the user knows the operation is running.
window.showExportProgress = function() {
    const overlay = document.getElementById('export-progress-overlay');
    if (overlay) {
        overlay.style.display = 'block';
    }
};

// Show the overlay whenever the export form is actually submitted, regardless
// of how the submit was triggered. This guarantees the progress modal appears.
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('form-export-pool');
    if (form) {
        form.addEventListener('submit', function() {
            window.showExportProgress();
        });
    }
});

// Submit the export form as a normal (non-boosted) navigation. Using
// requestSubmit() fires the form's submit event so the progress overlay is
// shown, and performs a full-page POST so the server's 303 redirect is
// followed by the browser instead of being intercepted by htmx boosting.
window.submitExportForm = function() {
    const form = document.getElementById('form-export-pool');
    if (!form) { return; }
    window.showExportProgress();
    if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
    } else {
        form.submit();
    }
};


// Ensure showConfirm function is available
window.showConfirm = function(dialogId) {

    const dialog = document.getElementById(dialogId);
    
    if (!dialog) {
        console.error('Dialog not found:', dialogId);
        return;
    }
    
    // Try using Alpine's global Alpine object if available
    if (window.Alpine) {
        // Use Alpine.$data to access the component's data
        const component = window.Alpine.$data(dialog);
        if (component) {
            component.open = true;
            return;
        }
    }
    
    // Fallback to __x property
    if (dialog.__x) {
        dialog.__x.$data.open = true;
        return;
    }
    
    // If neither works, try dispatching an event
    dialog.dispatchEvent(new CustomEvent('open-modal'));
    console.warn('Could not open modal using Alpine.js, tried dispatching event');
};
</script>

{% endblock %}
