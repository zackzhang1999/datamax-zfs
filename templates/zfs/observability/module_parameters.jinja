{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="container-page max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li class="flex items-center">
                <a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">首页</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="flex items-center">
                <a href="/zfs/observability" class="text-primary-400 hover:text-primary-300 transition-colors">运行观测</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li>
                <span class="text-text-primary font-medium">模块参数</span>
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-text-primary mb-2">ZFS 内核模块参数</h1>
            <p class="text-text-secondary">查看当前 ZFS 内核模块配置参数</p>
        </div>
        <div class="flex gap-2">
            {% if openzfs_man_url %}
            <a href="{{ openzfs_man_url }}" 
               target="_blank"
               rel="noopener noreferrer"
               class="btn-secondary flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                OpenZFS 手册页
            </a>
            {% endif %}
            <a href="/zfs/observability/module-parameters/download" 
               class="btn-success flex items-center gap-2"
               hx-boost="false">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                下载
            </a>
        </div>
    </div>

    <!-- Error Message -->
    {% if error %}
    <div class="bg-danger-900/30 border-l-4 border-danger-500 text-danger-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div><strong class="font-semibold">错误：</strong> {{ error }}</div>
        </div>
    </div>
    {% endif %}

    {% if parameters.get('error') %}
    <div class="bg-warning-900/30 border-l-4 border-warning-500 text-warning-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div><strong class="font-semibold">警告：</strong> {{ parameters.error }}</div>
        </div>
    </div>
    {% else %}
    
    <!-- Warning Banner -->
    <div class="bg-warning-900/30 border-l-4 border-warning-500 p-4 rounded mb-8">
        <div class="flex items-start">
            <svg class="w-6 h-6 text-warning-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
                <h3 class="text-sm font-semibold text-warning-400 mb-2">注意：需要专业知识</h3>
                <p class="text-sm text-warning-400">修改 ZFS 模块参数需要专业知识。不正确的取值可能导致系统不稳定或数据损坏。在进行任何修改之前，请务必查阅 ZFS 文档。</p>
            </div>
        </div>
    </div>

    <!-- Search Filter -->
    <div class="card mb-8">
        <div class="p-6">
            <label for="paramSearch" class="form-label">
                搜索参数
                <span id="search-count" class="text-text-tertiary text-sm font-normal ml-2"></span>
            </label>
            <div class="relative">
                <input type="text" 
                    id="paramSearch" 
                    placeholder="输入以筛选参数..." 
                    class="form-input pr-10"
                    hx-trigger="keyup changed delay:300ms"
                    hx-get="/zfs/observability/module-parameters/filter"
                    hx-target="#parametersTableBody"
                    hx-swap="innerHTML"
                    hx-include="[name='search']">
                <div class="absolute right-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-text-tertiary htmx-indicator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs text-text-tertiary mt-2">输入即可实时筛选参数</p>
        </div>
    </div>

    <!-- Parameters Table -->
    <div class="card overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary flex items-center gap-2">
                <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                当前模块参数
                <span class="text-sm font-normal text-text-secondary ml-2">（共 {{ parameters|length }} 个）</span>
            </h2>
        </div>
        
        {% if parameters %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-subtle" id="parametersTable">
                <thead class="bg-bg-elevated-2">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">参数名称</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">当前值</th>
                    </tr>
                </thead>
                <tbody class="bg-bg-elevated divide-y divide-border-subtle">
                    {% for name, value in parameters.items() %}
                    {% if name != 'error' %}
                    <tr class="hover:bg-bg-elevated-2 transition-colors parameter-row">
                        <td class="px-6 py-4 text-sm font-medium text-text-primary parameter-name">{{ name }}</td>
                        <td class="px-6 py-4 text-sm text-text-secondary font-mono">{{ value }}</td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="p-12 text-center">
            <svg class="w-16 h-16 mx-auto text-text-tertiary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-text-secondary text-lg mb-2">没有可用的模块参数</p>
            <p class="text-text-tertiary text-sm">无法读取 ZFS 模块参数</p>
        </div>
        {% endif %}
    </div>

    <!-- Information Box -->
    <div class="card-nested bg-info-900/20 border-info-500/20">
        <h3 class="text-lg font-semibold text-info-400 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            关于模块参数
        </h3>
        <div class="text-sm text-info-400 space-y-3">
            <p><strong>来源：</strong> <code class="bg-gray-900 px-2 py-0.5 rounded">/sys/module/zfs/parameters/</code></p>
            <p>这些参数在内核层面控制 ZFS 行为的各个方面。常见参数包括：</p>
            <ul class="list-disc list-inside ml-4 space-y-1.5">
                <li><strong>zfs_arc_max:</strong> ARC 最大大小（字节）</li>
                <li><strong>zfs_arc_min:</strong> ARC 最小大小（字节）</li>
                <li><strong>zfs_txg_timeout:</strong> 事务组超时时间（秒）</li>
                <li><strong>zfs_prefetch_disable:</strong> 禁用预取（0=启用，1=禁用）</li>
            </ul>
            <p class="mt-3"><strong>修改参数的方法：</strong>以 root 身份执行 <code class="bg-gray-900 px-1.5 py-0.5 rounded">echo value > /sys/module/zfs/parameters/param_name</code>。</p>
            <p><strong>重要提示：</strong>修改仅在运行时生效，重启后不会保留，除非将其写入模块配置文件（例如 <code class="bg-gray-900 px-1.5 py-0.5 rounded">/etc/modprobe.d/zfs.conf</code>）。</p>
        </div>
    </div>
    {% endif %}
</div>

<script>
// Simple search filter for parameters
document.getElementById('paramSearch')?.addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.parameter-row');
    
    rows.forEach(row => {
        const paramName = row.querySelector('.parameter-name').textContent.toLowerCase();
        if (paramName.includes(searchTerm)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});
</script>
{% endblock %}
