{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="container-page max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li class="flex items-center">
                <a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">首页</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="flex items-center">
                <a href="/zfs/observability" class="text-primary-400 hover:text-primary-300 transition-colors">运行观测</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li>
                <span class="text-text-primary font-medium">ARC 概览</span>
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-text-primary mb-2">ARC 概览</h1>
            <p class="text-text-secondary">自适应替换缓存（ARC）统计与性能指标</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <a href="/zfs/observability/arc-realtime"
               class="btn-secondary flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                实时统计
            </a>
            <a href="/zfs/observability/arc-summary/download" 
               class="btn-success flex items-center gap-2"
               hx-boost="false">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                下载
            </a>
            <div class="flex flex-col text-xs text-text-tertiary leading-tight">
                <span>上次更新：<span id="updateTime">刚刚</span></span>
                <span>每 5 分钟自动刷新（<span id="nextRefresh">5:00</span>）</span>
            </div>
            <button onclick="refreshStats()" class="btn-primary flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                刷新
            </button>
        </div>
    </div>

    <!-- Error Message -->
    {% if error %}
    <div class="bg-danger-900/30 border-l-4 border-danger-500 text-danger-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div><strong class="font-semibold">错误：</strong> {{ error }}</div>
        </div>
    </div>
    {% endif %}

    {% if arc_stats.get('error') %}
    <div class="bg-warning-900/30 border-l-4 border-warning-500 text-warning-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div><strong class="font-semibold">警告：</strong> {{ arc_stats.error }}</div>
        </div>
    </div>
    {% else %}
    
    <!-- System Info -->
    <div class="bg-primary-900/20 border border-primary-500/30 rounded-lg p-4 mb-6">
        <p class="text-sm text-primary-300">
            <strong>系统：</strong> {{ system }}
            {% if system == 'Linux' %}
            - 读取自 <code>/proc/spl/kstat/zfs/arcstats</code>
            {% elif system == 'FreeBSD' %}
            - 读取自 <code>sysctl kstat.zfs.misc.arcstats</code>
            {% elif system == 'NetBSD' %}
            - 读取自 <code>sysctl kstat.zfs.misc.arcstats</code>
            {% else %}
            - ARC 统计数据来源因平台而异
            {% endif %}
        </p>
    </div>
    
    <!-- Key Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="card">
            <div class="card-body">
                <h3 class="text-sm font-medium text-text-secondary mb-2">ARC 大小</h3>
                <p class="text-3xl font-bold text-text-primary">{{ arc_stats.get('size_human', 'N/A') }}</p>
                <p class="text-sm text-text-secondary mt-1">上限 {{ arc_stats.get('c_max_human', 'N/A') }}</p>
                {% if arc_stats.get('size') and arc_stats.get('c_max') %}
                <div class="mt-3 bg-bg-elevated-3 rounded-full h-2">
                    <div class="bg-primary-500 h-2 rounded-full" style="width: {{ (arc_stats.size / arc_stats.c_max * 100)|round(1) }}%"></div>
                </div>
                <p class="text-xs text-text-secondary mt-1">{{ (arc_stats.size / arc_stats.c_max * 100)|round(1) }}% 已用</p>
                {% endif %}
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <h3 class="text-sm font-medium text-text-secondary mb-2">命中率</h3>
                <p class="text-3xl font-bold {% if arc_stats.get('hit_rate', 0) >= 80 %}text-success-400{% elif arc_stats.get('hit_rate', 0) >= 60 %}text-warning-400{% else %}text-danger-400{% endif %}">
                    {% if arc_stats.get('hit_rate') %}
                        {{ "%.2f"|format(arc_stats.hit_rate) }}%
                    {% else %}
                        N/A
                    {% endif %}
                </p>
                <p class="text-sm text-text-secondary mt-1">缓存效率</p>
                {% if arc_stats.get('hit_rate') %}
                <div class="mt-3 bg-bg-elevated-3 rounded-full h-2">
                    <div class="{% if arc_stats.hit_rate >= 80 %}bg-success-500{% elif arc_stats.hit_rate >= 60 %}bg-warning-500{% else %}bg-danger-500{% endif %} h-2 rounded-full" style="width: {{ arc_stats.hit_rate }}%"></div>
                </div>
                {% endif %}
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <h3 class="text-sm font-medium text-text-secondary mb-2">缓存命中</h3>
                <p class="text-3xl font-bold text-success-400">
                    {% if arc_stats.get('hits') %}
                        {{ "{:,}".format(arc_stats.hits) }}
                    {% else %}
                        N/A
                    {% endif %}
                </p>
                <p class="text-sm text-text-secondary mt-1">成功读取</p>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <h3 class="text-sm font-medium text-text-secondary mb-2">缓存未命中</h3>
                <p class="text-3xl font-bold text-danger-400">
                    {% if arc_stats.get('misses') %}
                        {{ "{:,}".format(arc_stats.misses) }}
                    {% else %}
                        N/A
                    {% endif %}
                </p>
                <p class="text-sm text-text-secondary mt-1">需要读取磁盘</p>
            </div>
        </div>
    </div>

    <!-- SSD Cache (L2ARC) -->
    <div class="card mb-8">
        <div class="px-6 py-4 border-b border-border-subtle flex items-center justify-between gap-3 flex-wrap">
            <h3 class="text-lg font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                SSD 缓存（L2ARC）
            </h3>
            {% if arc_stats.get('l2arc_active') %}
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-success-900/50 text-success-400 border border-success-800">
                正在使用 SSD 缓存
            </span>
            {% else %}
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-bg-elevated-3 text-text-tertiary border border-border-subtle">
                未配置或暂无缓存数据
            </span>
            {% endif %}
        </div>
        {% if arc_stats.get('l2arc_active') %}
        <div class="p-6 space-y-6">
            <!-- Top metrics -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="card-nested">
                    <h4 class="text-sm font-medium text-text-secondary mb-2">缓存大小</h4>
                    <p class="text-3xl font-bold text-text-primary">{{ arc_stats.get('l2_size_human', '0 B') }}</p>
                    <p class="text-sm text-text-secondary mt-1">实际存储 {{ arc_stats.get('l2_asize_human', '0 B') }}</p>
                    {% if arc_stats.get('l2_hdr_size', 0) %}
                    <p class="text-xs text-text-tertiary mt-0.5">头部 {{ arc_stats.get('l2_hdr_size_human', '0 B') }}</p>
                    {% endif %}
                </div>
                <div class="card-nested">
                    <h4 class="text-sm font-medium text-text-secondary mb-2">命中率</h4>
                    {% set l2_hit_rate = arc_stats.get('l2_hit_rate', 0) %}
                    <p class="text-3xl font-bold {% if l2_hit_rate >= 80 %}text-success-400{% elif l2_hit_rate >= 60 %}text-warning-400{% else %}text-danger-400{% endif %}">
                        {{ "%.2f"|format(l2_hit_rate) }}%
                    </p>
                    <p class="text-sm text-text-secondary mt-1">SSD 缓存效率</p>
                    <div class="mt-3 bg-bg-elevated-3 rounded-full h-2">
                        <div class="{% if l2_hit_rate >= 80 %}bg-success-500{% elif l2_hit_rate >= 60 %}bg-warning-500{% else %}bg-danger-500{% endif %} h-2 rounded-full" style="width: {{ l2_hit_rate }}%"></div>
                    </div>
                </div>
                <div class="card-nested">
                    <h4 class="text-sm font-medium text-text-secondary mb-2">SSD 缓存命中</h4>
                    <p class="text-3xl font-bold text-success-400">{{ arc_stats.get('l2_hits_human', '0') }}</p>
                    <p class="text-sm text-text-secondary mt-1">由 SSD 直接提供</p>
                </div>
                <div class="card-nested">
                    <h4 class="text-sm font-medium text-text-secondary mb-2">SSD 缓存未命中</h4>
                    <p class="text-3xl font-bold text-danger-400">{{ arc_stats.get('l2_misses_human', '0') }}</p>
                    <p class="text-sm text-text-secondary mt-1">回退到磁盘读取</p>
                </div>
            </div>

            <!-- Lifetime I/O details -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="card-nested">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-success-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                        </svg>
                        <div>
                            <div class="text-sm font-medium text-text-primary">累计从 SSD 读取</div>
                            <div class="text-xs text-text-tertiary mt-0.5">{{ arc_stats.get('l2_read_bytes_human', '0 B') }}</div>
                        </div>
                    </div>
                </div>
                <div class="card-nested">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                        </svg>
                        <div>
                            <div class="text-sm font-medium text-text-primary">累计写入 SSD</div>
                            <div class="text-xs text-text-tertiary mt-0.5">{{ arc_stats.get('l2_write_bytes_human', '0 B') }}</div>
                        </div>
                    </div>
                </div>
                <div class="card-nested">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        <div>
                            <div class="text-sm font-medium text-text-primary">填充操作次数（feeds）</div>
                            <div class="text-xs text-text-tertiary mt-0.5">{{ arc_stats.get('l2_feeds_human', '0') }} 次</div>
                        </div>
                    </div>
                </div>
                <div class="card-nested">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
                        </svg>
                        <div>
                            <div class="text-sm font-medium text-text-primary">写入操作次数</div>
                            <div class="text-xs text-text-tertiary mt-0.5">{{ arc_stats.get('l2_writes_sent_human', '0') }} 次</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="p-6">
            <div class="text-center py-6">
                <svg class="w-10 h-10 mx-auto text-text-tertiary mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <p class="text-text-secondary font-medium">未检测到 SSD 缓存（L2ARC）活动</p>
                <p class="text-text-tertiary text-sm mt-2 max-w-lg mx-auto">
                    请确认存储池是否添加了 L2ARC 缓存设备（刚添加的设备需要一段时间才会产生统计）。可在
                    <a href="/zfs/pools" class="text-primary-400 hover:text-primary-300">存储池页面</a>
                    选择对应存储池并进入“管理 VDev”中添加缓存（L2ARC）设备。
                </p>
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Cache Type Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- MRU/MFU Distribution -->
        <div class="card">
            <div class="px-6 py-4 border-b border-border-subtle">
                <h3 class="text-lg font-semibold text-text-primary">缓存分布（MRU 与 MFU）</h3>
            </div>
            <div class="p-6">
                {% if arc_stats.get('mru_hits') and arc_stats.get('mfu_hits') %}
                {% set mru_total = arc_stats.mru_hits %}
                {% set mfu_total = arc_stats.mfu_hits %}
                {% set total_hits = mru_total + mfu_total %}
                {% if total_hits > 0 %}
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">MRU（最近使用）</span>
                            <span class="text-text-secondary">{{ "{:,}".format(mru_total) }} ({{ (mru_total / total_hits * 100)|round(1) }}%)</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-6">
                            <div class="bg-primary-500 h-6 rounded-full flex items-center justify-end pr-2" style="width: {{ (mru_total / total_hits * 100)|round(1) }}%">
                                <span class="text-white text-xs font-bold">{{ (mru_total / total_hits * 100)|round(1) }}%</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">MFU（最常使用）</span>
                            <span class="text-text-secondary">{{ "{:,}".format(mfu_total) }} ({{ (mfu_total / total_hits * 100)|round(1) }}%)</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-6">
                            <div class="bg-success-500 h-6 rounded-full flex items-center justify-end pr-2" style="width: {{ (mfu_total / total_hits * 100)|round(1) }}%">
                                <span class="text-white text-xs font-bold">{{ (mfu_total / total_hits * 100)|round(1) }}%</span>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% else %}
                <p class="text-text-secondary text-center py-4">MRU/MFU 数据不可用</p>
                {% endif %}
            </div>
        </div>

        <!-- Demand vs Prefetch -->
        <div class="card">
            <div class="px-6 py-4 border-b border-border-subtle">
                <h3 class="text-lg font-semibold text-text-primary">访问类型分布</h3>
            </div>
            <div class="p-6">
                {% if arc_stats.get('demand_data_hits') and arc_stats.get('demand_metadata_hits') %}
                {% set demand_hits = arc_stats.get('demand_data_hits', 0) + arc_stats.get('demand_metadata_hits', 0) %}
                {% set prefetch_hits = arc_stats.get('prefetch_data_hits', 0) + arc_stats.get('prefetch_metadata_hits', 0) %}
                {% set total = demand_hits + prefetch_hits %}
                {% if total > 0 %}
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">按需（请求触发）</span>
                            <span class="text-text-secondary">{{ "{:,}".format(demand_hits) }} ({{ (demand_hits / total * 100)|round(1) }}%)</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-6">
                            <div class="bg-purple-500 h-6 rounded-full flex items-center justify-end pr-2" style="width: {{ (demand_hits / total * 100)|round(1) }}%">
                                <span class="text-white text-xs font-bold">{{ (demand_hits / total * 100)|round(1) }}%</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">预取（预测性）</span>
                            <span class="text-text-secondary">{{ "{:,}".format(prefetch_hits) }} ({{ (prefetch_hits / total * 100)|round(1) }}%)</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-6">
                            <div class="bg-warning-500 h-6 rounded-full flex items-center justify-end pr-2" style="width: {{ (prefetch_hits / total * 100)|round(1) }}%">
                                <span class="text-white text-xs font-bold">{{ (prefetch_hits / total * 100)|round(1) }}%</span>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% else %}
                <p class="text-text-secondary text-center py-4">访问类型数据不可用</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Miss Breakdown and Ghost Hit Detail -->
    {% set total_misses = arc_stats.get('misses', 0) %}
    {% set mru_ghost = arc_stats.get('mru_ghost_hits', 0) %}
    {% set mfu_ghost = arc_stats.get('mfu_ghost_hits', 0) %}
    {% set ghost_total = mru_ghost + mfu_ghost %}
    {% set cold_misses = total_misses - ghost_total if total_misses >= ghost_total else 0 %}
    {% set total_requests = arc_stats.get('hits', 0) + total_misses %}
    {% set miss_rate = (total_misses / total_requests * 100) if total_requests > 0 else 0 %}
    {% set ghost_rate = (ghost_total / total_requests * 100) if total_requests > 0 else 0 %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- Summary Rates -->
        <div class="card">
            <div class="px-6 py-4 border-b border-border-subtle">
                <h3 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                    <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                    未命中与 Ghost 命中率
                </h3>
            </div>
            <div class="pt-6 px-6 pb-3">
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-bg-elevated-2 border border-border-subtle rounded-lg p-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wide mb-2">未命中率</div>
                        <div class="text-3xl font-bold text-danger-400 mb-1">{{ "%.2f"|format(miss_rate) }}%</div>
                        <div class="text-sm text-text-secondary">{{ "{:,}".format(total_misses) }} 次未命中</div>
                    </div>
                    <div class="bg-bg-elevated-2 border border-border-subtle rounded-lg p-4">
                        <div class="text-xs text-text-tertiary uppercase tracking-wide mb-2">Ghost 命中率</div>
                        <div class="text-3xl font-bold text-warning-400 mb-1">{{ "%.2f"|format(ghost_rate) }}%</div>
                        <div class="text-sm text-text-secondary">{{ "{:,}".format(ghost_total) }} 次险些命中</div>
                    </div>
                </div>
                <p class="text-xs text-text-tertiary mt-4" style="margin-bottom: 0;">Ghost 命中表示 ARC 剔除了随后很快又需要的数据。</p>
            </div>
        </div>

        <!-- Miss Breakdown -->
        <div class="card">
            <div class="px-6 py-4 border-b border-border-subtle">
                <h3 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                    <svg class="w-5 h-5 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    未命中明细
                </h3>
            </div>
            <div class="p-6">
                {% if total_misses > 0 %}
                {% set cold_pct = (cold_misses / total_misses * 100) if total_misses > 0 else 0 %}
                {% set ghost_pct = (ghost_total / total_misses * 100) if total_misses > 0 else 0 %}
                <div class="space-y-5">
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">冷未命中</span>
                            <span class="text-text-secondary">{{ "%.1f"|format(cold_pct) }}%</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-2.5 mb-1">
                            <div class="bg-danger-500 h-2.5 rounded-full transition-all duration-300" style="width: {{ [cold_pct, 1]|max }}%"></div>
                        </div>
                        <p class="text-xs text-text-tertiary">{{ "{:,}".format(cold_misses) }} - 数据从未缓存或早已被剔除</p>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-2">
                            <span class="font-medium text-text-primary">Ghost 命中（险些命中）</span>
                            <span class="text-text-secondary">{{ "%.1f"|format(ghost_pct) }}%</span>
                        </div>
                        <div class="bg-bg-elevated-3 rounded-full h-2.5 mb-1">
                            <div class="bg-warning-500 h-2.5 rounded-full transition-all duration-300" style="width: {{ [ghost_pct, 1]|max }}%"></div>
                        </div>
                        <p class="text-xs text-text-tertiary">{{ "{:,}".format(ghost_total) }} - 曾缓存过，但过早被剔除</p>
                    </div>
                </div>
                {% else %}
                <p class="text-text-secondary text-center py-4">暂无未命中数据</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Ghost Hit Detail (MFU vs MRU) -->
    <div class="card mb-8">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h3 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
                Ghost 命中详情
            </h3>
        </div>
        <div class="p-6">
            {% if ghost_total > 0 %}
            {% set mfu_ghost_pct = (mfu_ghost / ghost_total * 100) if ghost_total > 0 else 0 %}
            {% set mru_ghost_pct = (mru_ghost / ghost_total * 100) if ghost_total > 0 else 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-bg-elevated-2 border border-border-subtle rounded-lg p-4">
                    <div class="flex justify-between items-baseline mb-2">
                        <span class="text-sm font-medium text-text-primary">MFU Ghost 命中</span>
                        <span class="text-2xl font-bold text-text-primary">{{ "%.1f"|format(mfu_ghost_pct) }}%</span>
                    </div>
                    <div class="bg-bg-elevated-3 rounded-full h-2 mb-2">
                        <div class="bg-purple-500 h-2 rounded-full transition-all duration-300" style="width: {{ [mfu_ghost_pct, 1]|max }}%"></div>
                    </div>
                    <p class="text-xs text-text-tertiary">{{ "{:,}".format(mfu_ghost) }} - 常用数据被挤出缓存</p>
                </div>
                <div class="bg-bg-elevated-2 border border-border-subtle rounded-lg p-4">
                    <div class="flex justify-between items-baseline mb-2">
                        <span class="text-sm font-medium text-text-primary">MRU Ghost 命中</span>
                        <span class="text-2xl font-bold text-text-primary">{{ "%.1f"|format(mru_ghost_pct) }}%</span>
                    </div>
                    <div class="bg-bg-elevated-3 rounded-full h-2 mb-2">
                        <div class="bg-primary-500 h-2 rounded-full transition-all duration-300" style="width: {{ [mru_ghost_pct, 1]|max }}%"></div>
                    </div>
                    <p class="text-xs text-text-tertiary">{{ "{:,}".format(mru_ghost) }} - 近期访问的数据被频繁换出</p>
                </div>
            </div>
            {% else %}
            <p class="text-text-secondary text-center py-4">暂无 Ghost 命中数据</p>
            {% endif %}
        </div>
    </div>

    <!-- Detailed Statistics by Category -->
    <div class="card mb-8">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary">详细统计</h2>
        </div>
        
        <div class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Memory Statistics -->
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-text-primary flex items-center gap-2">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
                        </svg>
                        内存统计
                    </h3>
                    <div class="space-y-2">
                        {% for key in ['size', 'c', 'c_min', 'c_max', 'p', 'mru_size', 'mfu_size'] %}
                        {% if arc_stats.get(key) %}
                        <div class="flex justify-between text-sm py-2 border-b border-border-subtle">
                            <span class="text-text-secondary">{{ key }}</span>
                            <span class="font-mono text-text-primary">{{ "{:,}".format(arc_stats[key]) }}</span>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- Hit/Miss Statistics -->
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-text-primary flex items-center gap-2">
                        <svg class="w-5 h-5 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        命中/未命中统计
                    </h3>
                    <div class="space-y-2">
                        {% for key in ['hits', 'misses', 'demand_data_hits', 'demand_data_misses', 'demand_metadata_hits', 'demand_metadata_misses', 'prefetch_data_hits', 'prefetch_data_misses'] %}
                        {% if arc_stats.get(key) %}
                        <div class="flex justify-between text-sm py-2 border-b border-border-subtle">
                            <span class="text-text-secondary">{{ key }}</span>
                            <span class="font-mono text-text-primary">{{ "{:,}".format(arc_stats[key]) }}</span>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- MRU/MFU Statistics -->
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-text-primary flex items-center gap-2">
                        <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
                        </svg>
                        MRU/MFU 统计
                    </h3>
                    <div class="space-y-2">
                        {% for key in ['mru_hits', 'mru_ghost_hits', 'mfu_hits', 'mfu_ghost_hits'] %}
                        {% if arc_stats.get(key) %}
                        <div class="flex justify-between text-sm py-2 border-b border-border-subtle">
                            <span class="text-text-secondary">{{ key }}</span>
                            <span class="font-mono text-text-primary">{{ "{:,}".format(arc_stats[key]) }}</span>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- I/O Statistics -->
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-text-primary flex items-center gap-2">
                        <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                        </svg>
                        I/O 统计
                    </h3>
                    <div class="space-y-2">
                        {% for key in ['iohits', 'demand_data_iohits', 'demand_metadata_iohits', 'prefetch_data_iohits', 'prefetch_metadata_iohits'] %}
                        {% if arc_stats.get(key) %}
                        <div class="flex justify-between text-sm py-2 border-b border-border-subtle">
                            <span class="text-text-secondary">{{ key }}</span>
                            <span class="font-mono text-text-primary">{{ "{:,}".format(arc_stats[key]) }}</span>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- All Other Statistics -->
            <div class="mt-8">
                <h3 class="text-lg font-semibold mb-4 text-text-primary">其他统计</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6">
                    {% for key, value in arc_stats.items() %}
                    {% if key not in ['error', 'size_human', 'c_max_human', 'hit_rate', 'size', 'c', 'c_min', 'c_max', 'p', 'mru_size', 'mfu_size', 'hits', 'misses', 'demand_data_hits', 'demand_data_misses', 'demand_metadata_hits', 'demand_metadata_misses', 'prefetch_data_hits', 'prefetch_data_misses', 'mru_hits', 'mru_ghost_hits', 'mfu_hits', 'mfu_ghost_hits', 'iohits', 'demand_data_iohits', 'demand_metadata_iohits', 'prefetch_data_iohits', 'prefetch_metadata_iohits'] %}
                    <div class="flex justify-between text-sm py-2 border-b border-border-subtle">
                        <span class="text-text-secondary">{{ key }}</span>
                        <span class="font-mono text-text-primary text-xs">{{ value }}</span>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- Information Box -->
    <div class="card-nested bg-info-900/20 border-info-500/20">
        <h3 class="text-lg font-semibold text-info-400 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            关于 ARC
        </h3>
        <div class="text-sm text-info-400 space-y-3">
            <p>自适应替换缓存（ARC）是 ZFS 的智能缓存机制，将频繁访问的数据存储在内存中，以加快读取速度。</p>
            <p class="font-semibold">关键概念：</p>
            <ul class="list-disc list-inside ml-4 space-y-1.5">
                <li><strong>命中率：</strong>由缓存直接满足的数据请求百分比。越高越好（通常 80% 以上）。良好的命中率可显著减少磁盘 I/O。</li>
                <li><strong>MRU（最近使用）：</strong>近期访问过的数据，可能很快会被再次访问。</li>
                <li><strong>MFU（最常使用）：</strong>长期以来被频繁访问的数据，很可能再次被需要。</li>
                <li><strong>大小：</strong>当前内存占用。会根据系统内存压力和负载动态调整。</li>
                <li><strong>按需命中：</strong>对显式请求数据的缓存命中。</li>
                <li><strong>预取命中：</strong>对预测性加载数据的缓存命中。</li>
            </ul>
        </div>
    </div>
    {% endif %}
</div>

<script>
// ARC Summary auto-refresh: fixed 5 minute interval, not user-configurable.
const REFRESH_INTERVAL_MS = 5 * 60 * 1000;
const lastRefreshTime = new Date();
const nextRefreshAt = new Date(lastRefreshTime.getTime() + REFRESH_INTERVAL_MS);

function refreshStats() {
    window.location.reload();
}

function pad(n) {
    return n.toString().padStart(2, '0');
}

function updateTimeDisplay() {
    const now = new Date();
    const sinceLast = Math.floor((now - lastRefreshTime) / 1000);
    const lastEl = document.getElementById('updateTime');
    if (lastEl) {
        if (sinceLast < 60) {
            lastEl.textContent = sinceLast <= 0 ? '刚刚' : sinceLast + ' 秒前';
        } else {
            const minutes = Math.floor(sinceLast / 60);
            const seconds = sinceLast % 60;
            lastEl.textContent = minutes + ' 分 ' + pad(seconds) + ' 秒前';
        }
    }

    const remainingMs = Math.max(0, nextRefreshAt - now);
    const remainingSeconds = Math.ceil(remainingMs / 1000);
    const minutes = Math.floor(remainingSeconds / 60);
    const seconds = remainingSeconds % 60;
    const nextEl = document.getElementById('nextRefresh');
    if (nextEl) {
        nextEl.textContent = minutes + ':' + pad(seconds);
    }
}

const refreshTimer = setTimeout(refreshStats, REFRESH_INTERVAL_MS);
const timeDisplayInterval = setInterval(updateTimeDisplay, 1000);
updateTimeDisplay();

window.addEventListener('beforeunload', () => {
    clearTimeout(refreshTimer);
    clearInterval(timeDisplayInterval);
});
</script>
{% endblock %}
