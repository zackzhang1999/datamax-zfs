{% extends "layout.jinja" %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm text-text-secondary mb-4 flex items-center gap-2">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/zfs/snapshots" class="hover:text-text-primary transition-colors">快照</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-text-primary">重命名</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-text-primary">重命名快照</h1>
        <p class="text-text-secondary mt-2">更改现有快照的名称</p>
    </div>

    <!-- Error Message -->
    {% if error %}
    {% include "partials/error.jinja" %}
    {% endif %}

    <!-- Info Box -->
    <div class="card-nested bg-info-900/20 border-info-900 mb-6">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="text-sm">
                <strong class="text-info-400">关于重命名：</strong>
                <span class="text-text-secondary">重命名快照只会更改其名称，不会更改其内容或属性。
                快照将保留在同一数据集上，并维持其所有数据和关联关系。</span>
            </div>
        </div>
    </div>

    <!-- Current Snapshot Info -->
    <div class="card mb-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-3">当前快照：</h3>
        <div class="bg-bg-elevated-2 rounded-lg p-3">
            <code class="text-success-400">{{ snapshot_name }}</code>
        </div>
        <p class="text-text-secondary text-xs mt-2">
            当前名称：<span class="text-text-primary font-semibold">{{ current_name }}</span>
        </p>
    </div>

    <!-- Rename Form -->
    <div class="card">
        <form method="post" action="/zfs/snapshots/{{ snapshot_name }}/rename">
            <!-- New Snapshot Name -->
            <div class="mb-6">
                <label for="new_name" class="form-label">
                    新快照名称 <span class="text-danger-400">*</span>
                </label>
                <input 
                    type="text" 
                    id="new_name" 
                    name="new_name" 
                    value="{{ new_name or '' }}"
                    required
                    placeholder="例如：renamed-backup-2025 或 new-snapshot-name"
                    pattern="[a-zA-Z0-9_.\-]+"
                    class="form-input"
                >
                <p class="text-text-tertiary text-xs mt-1">
                    只输入快照名称（不含 @ 和数据集）。只能使用字母数字、连字符、下划线和句点。
                </p>
            </div>

            <!-- Recursive Option -->
            <div class="mb-6">
                <label class="flex items-center cursor-pointer">
                    <input 
                        type="checkbox" 
                        name="recursive" 
                        value="true"
                        {% if recursive %}checked{% endif %}
                        class="form-checkbox"
                    >
                    <span class="ml-2 text-sm text-text-primary">
                        对所有后代数据集递归重命名
                    </span>
                </label>
                <p class="text-text-tertiary text-xs mt-1 ml-6">
                    勾选后，如果该快照属于某组递归快照，所有子数据集上同名的快照也会被一并重命名。
                </p>
            </div>

            <!-- Preview -->
            <div class="card-nested mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    预览
                </h3>
                <div class="space-y-2 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="text-text-secondary">当前：</span>
                        <code class="text-danger-400 bg-bg-elevated-2 px-2 py-1 rounded">{{ snapshot_name }}</code>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                        </svg>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-text-secondary">新：</span>
                        <code class="text-success-400 bg-bg-elevated-2 px-2 py-1 rounded" id="preview-new">
                            {{ snapshot_name.rsplit('@', 1)[0] }}@<span id="new-name-preview">{{ new_name or 'new-name' }}</span>
                        </code>
                    </div>
                </div>
            </div>

            <!-- Important Notes -->
            <div class="card-nested bg-warning-900/20 border-warning-900 mb-6">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <div class="text-sm">
                        <strong class="text-warning-400">重要提示：</strong>
                        <ul class="mt-2 space-y-1 text-text-secondary">
                            <li class="flex items-start gap-2">
                                <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                                <span>引用此快照的克隆和书签将继续正常工作</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                                <span>如果数据复制任务引用了此快照名称，可能需要更新</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                                <span>自动化工具（如 Sanoid）可能会失去对已重命名快照的跟踪</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                                <span>请考虑对使用该快照名称的任何脚本或监控的影响</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Naming Guidelines -->
            <div class="card-nested mb-6">
                <h3 class="text-sm font-semibold text-text-primary mb-2 flex items-center gap-2">
                    <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    命名指南
                </h3>
                <ul class="text-xs text-text-secondary space-y-1">
                    <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>选择能表明快照用途或时间的描述性名称</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>与你的命名约定保持一致</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>使用可排序的日期格式（YYYY-MM-DD 或 YYYYMMDD）</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>避免使用连字符、下划线和句点以外的特殊字符</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-3 h-3 text-text-tertiary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>名称保持简短但有含义</span>
                    </li>
                </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-4">
                <button 
                    type="submit"
                    class="btn-primary flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    重命名快照
                </button>
                <a 
                    href="/zfs/snapshots/{{ snapshot_name }}/detail" 
                    class="btn-secondary flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    取消
                </a>
            </div>
        </form>
    </div>
</div>

<script>
// Live preview of new snapshot name
document.getElementById('new_name').addEventListener('input', function(e) {
    const newNamePreview = document.getElementById('new-name-preview');
    newNamePreview.textContent = e.target.value || 'new-name';
});
</script>
{% endblock %}
