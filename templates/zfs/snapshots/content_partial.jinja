<div class="space-y-6">
    {% if error %}
        {% with message=error %}
            {% include "partials/error.jinja" %}
        {% endwith %}
    {% endif %}

    {% if snapshots %}
    <!-- Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card">
            <div class="p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-text-tertiary text-sm">快照总数</div>
                        <div class="text-2xl font-bold text-text-primary mt-1">{{ snapshots|length }}</div>
                    </div>
                    <div class="p-3 bg-primary-900/50 rounded-lg">
                        <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-text-tertiary text-sm">数据集</div>
                        <div class="text-2xl font-bold text-text-primary mt-1">{{ snapshots|map(attribute='dataset')|unique|list|length }}</div>
                    </div>
                    <div class="p-3 bg-info-900/50 rounded-lg">
                        <svg class="w-6 h-6 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-text-tertiary text-sm">总已用</div>
                        <div class="text-lg font-bold text-text-primary mt-1">
                            {% set total_used = [] %}
                            {% for snap in snapshots %}
                                {% if snap.used != '-' %}
                                    {% set _ = total_used.append(snap.used) %}
                                {% endif %}
                            {% endfor %}
                            已统计 {{ total_used|length }} 项
                        </div>
                    </div>
                    <div class="p-3 bg-success-900/50 rounded-lg">
                        <svg class="w-6 h-6 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-text-tertiary text-sm">筛选视图</div>
                        <div class="text-lg font-semibold text-text-primary mt-1">
                            {% if selected_dataset %}
                                {{ selected_dataset }}
                            {% else %}
                                全部数据集
                            {% endif %}
                        </div>
                    </div>
                    <div class="p-3 bg-warning-900/50 rounded-lg">
                        <svg class="w-6 h-6 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Snapshots Table -->
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                全部快照 ({{ snapshots|length }})
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-bg-elevated-2">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            快照名称
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            数据集
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            已用
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            引用量
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            创建时间
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">
                            操作
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    {% for snapshot in snapshots %}
                    <tr class="hover:bg-bg-elevated-2 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/zfs/snapshots/{{ snapshot.name }}/detail" class="text-primary-400 hover:text-primary-300 font-semibold transition-colors">
                                {{ snapshot.snapshot }}
                            </a>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/zfs/datasets/{{ snapshot.dataset }}" class="text-text-secondary hover:text-text-primary text-sm transition-colors">
                                {{ snapshot.dataset }}
                            </a>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-primary font-mono">
                            {{ snapshot.used }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-primary font-mono">
                            {{ snapshot.refer }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-tertiary">
                            {{ snapshot.creation }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex justify-end gap-2">
                                <a href="/zfs/snapshots/{{ snapshot.name }}/detail" 
                                   class="p-1.5 text-info-400 hover:text-info-300 hover:bg-info-900/20 rounded transition-colors" 
                                   title="查看详细信息">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                </a>
                                {% set bmark_key = snapshot.dataset ~ '#' ~ snapshot.snapshot %}
                                {% if bmark_key in bookmark_set %}
                                <span class="p-1.5 text-purple-400 rounded cursor-default" title="已添加书签">
                                    <svg class="w-4 h-4" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                                    </svg>
                                </span>
                                {% else %}
                                <form method="post" action="/zfs/snapshots/{{ snapshot.name }}/bookmark" class="inline">
                                    <button type="submit" 
                                            class="p-1.5 text-purple-400 hover:text-purple-300 hover:bg-purple-900/20 rounded transition-colors"
                                            title="创建书签">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                                        </svg>
                                    </button>
                                </form>
                                {% endif %}
                                <a href="/zfs/snapshots/{{ snapshot.name }}/clone/form" 
                                   class="p-1.5 text-success-400 hover:text-success-300 hover:bg-success-900/20 rounded transition-colors" 
                                   title="克隆">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                    </svg>
                                </a>
                                <a href="/zfs/snapshots/{{ snapshot.name }}/rollback/confirm" 
                                   class="p-1.5 text-warning-400 hover:text-warning-300 hover:bg-warning-900/20 rounded transition-colors" 
                                   title="回滚">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                                    </svg>
                                </a>
                                <a href="/zfs/snapshots/{{ snapshot.name }}/rename/form" 
                                   class="p-1.5 text-primary-400 hover:text-primary-300 hover:bg-primary-900/20 rounded transition-colors" 
                                   title="重命名">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                                <a href="/zfs/snapshots/{{ snapshot.name }}/destroy/confirm" 
                                   class="p-1.5 text-danger-400 hover:text-danger-300 hover:bg-danger-900/20 rounded transition-colors" 
                                   title="销毁">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Action Legend -->
    <div class="card-nested">
        <h3 class="text-sm font-semibold text-text-primary mb-4 inline-flex items-center gap-2">
            <svg class="w-4 h-4 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            操作图标
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6 gap-3 text-xs text-text-secondary">
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>查看详细信息</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
                <span>创建书签</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span>克隆到新数据集</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                </svg>
                <span>回滚数据集</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                <span>重命名快照</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                <span>销毁快照</span>
            </div>
        </div>
    </div>

    {# Bookmarks Section #}
    {% if bookmarks %}
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
                书签 ({{ bookmarks|length }})
            </h2>
            <p class="text-text-tertiary text-sm mt-1">书签是指向快照的轻量级引用，用于增量数据复制。即使源快照被删除，书签仍然保留。</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-bg-elevated-2">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">书签名称</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">数据集</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">创建时间</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">操作</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    {% for bm in bookmarks %}
                    <tr class="hover:bg-bg-elevated-2 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-purple-400 font-semibold inline-flex items-center gap-2">
                                <svg class="w-4 h-4" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                                </svg>
                                {{ bm.bookmark }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/zfs/datasets/{{ bm.dataset }}" class="text-text-secondary hover:text-text-primary text-sm transition-colors">
                                {{ bm.dataset }}
                            </a>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-text-tertiary">
                            {{ bm.creation }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <form method="post" action="/zfs/snapshots/bookmarks/destroy" class="inline" id="form-destroy-bookmark-{{ loop.index }}">
                                <input type="hidden" name="bookmark_name" value="{{ bm.name }}">
                                <button type="button"
                                        class="p-1.5 text-danger-400 hover:text-danger-300 hover:bg-danger-900/20 rounded transition-colors"
                                        title="销毁书签"
                                        onclick="showConfirm('modal-destroy-bookmark-{{ loop.index }}')">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% else %}
    <!-- No Snapshots -->
    <div class="card text-center py-12">
        <svg class="w-16 h-16 mx-auto text-text-tertiary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
        </svg>
        <div class="text-text-secondary text-lg mb-2">
            {% if selected_dataset %}
                未找到数据集的快照：<span class="text-text-primary font-semibold">{{ selected_dataset }}</span>
            {% else %}
                此系统上未找到任何 ZFS 快照
            {% endif %}
        </div>
        <p class="text-text-tertiary mb-6 max-w-md mx-auto">
            快照是数据集在某一时间点的副本，用于保存数据的当时状态。
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/zfs/snapshots/create/form" class="btn-success inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                创建你的第一个快照
            </a>
            {% if selected_dataset %}
            <a href="/zfs/snapshots" class="btn-secondary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                查看全部快照
            </a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<!-- Bookmark Destroy Confirmation Modals -->
{% if bookmarks %}
    {% for bm in bookmarks %}
    {% set id = 'modal-destroy-bookmark-' ~ loop.index %}
    {% set title = '销毁书签' %}
    {% set message = '销毁书签 "' ~ bm.name ~ '"？这将移除该书签引用，但不会影响原始快照。' %}
    {% set confirm_text = '销毁' %}
    {% set confirm_class = 'danger' %}
    {% set confirm_action = 'document.getElementById("form-destroy-bookmark-' ~ loop.index|string ~ '").submit()' %}
    {% include 'partials/confirm.jinja' %}
    {% endfor %}
{% endif %}

<script>
window.showConfirm = function(dialogId) {
    const dialog = document.getElementById(dialogId);
    if (!dialog) {
        console.error('Dialog not found:', dialogId);
        return;
    }
    if (window.Alpine) {
        const component = window.Alpine.$data(dialog);
        if (component) {
            component.open = true;
            return;
        }
    }
    if (dialog.__x) {
        dialog.__x.$data.open = true;
        return;
    }
    dialog.dispatchEvent(new CustomEvent('open-modal'));
};
</script>
