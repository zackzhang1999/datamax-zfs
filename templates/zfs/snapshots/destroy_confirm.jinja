{% extends "layout.jinja" %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/zfs/snapshots" class="hover:text-text-primary transition-colors">快照</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">销毁</span>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-danger-400 inline-flex items-center gap-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            销毁快照
        </h1>
        <p class="text-danger-300 mt-2 font-semibold">此操作无法撤销！</p>
    </div>

    <!-- Error Message -->
    {% if error %}
        {% with message=error %}
            {% include "partials/error.jinja" %}
        {% endwith %}
    {% endif %}

    <!-- Warning Box -->
    <div class="card-nested bg-danger-900/30 border-danger-600 border-2">
        <h3 class="text-lg font-bold mb-3 text-danger-300 inline-flex items-center gap-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            破坏性操作警告
        </h3>
        <p class="text-danger-200 mb-3">
            你即将<strong>永久销毁</strong>以下快照：
        </p>
        <div class="bg-danger-950 border border-danger-700 rounded-lg p-4">
            <p class="text-danger-300 font-mono text-lg break-all">
                {{ snapshot_name }}
            </p>
        </div>
    </div>

    <!-- Consequences -->
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                此操作的后果
            </h2>
        </div>
        <div class="p-6">
            <ul class="space-y-3 text-text-secondary">
                <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>该快照将被<strong class="text-text-primary">永久删除</strong>，无法恢复</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>你将<strong class="text-text-primary">失去回滚到</strong>此时间点的能力</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>从此快照创建的任何<strong class="text-text-primary">克隆</strong>都可能受到影响</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>此快照占用的空间将被<strong class="text-text-primary">释放</strong>（可能需要一些时间）</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-warning-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <span>如果快照存在<strong class="text-text-primary">保留标记（hold）</strong>，则在释放保留标记之前无法销毁</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Confirmation Form -->
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                需要确认
            </h2>
        </div>
        <div class="p-6">
            <form method="post" action="/zfs/snapshots/{{ snapshot_name }}/destroy" class="space-y-6">
                <!-- Defer Destroy Option -->
                <div>
                    <label class="flex items-start cursor-pointer">
                        <input 
                            type="checkbox" 
                            name="defer" 
                            value="true"
                            class="form-checkbox mt-0.5"
                        >
                        <span class="ml-2">
                            <span class="text-sm text-text-primary font-medium block">如果快照存在克隆，则延迟销毁</span>
                            <span class="text-text-tertiary text-xs block mt-0.5">
                                勾选后，如果该快照存在任何克隆，它将被标记为延迟销毁。
                                当所有克隆都被销毁后，它将自动被销毁。
                            </span>
                        </span>
                    </label>
                </div>

                <!-- Type Confirmation -->
                <div>
                    <label for="confirm" class="form-label">
                        输入<strong>完整的快照名称</strong>以确认：<span class="text-danger-400">*</span>
                    </label>
                    <div class="bg-bg-elevated-3 border border-border-default rounded-lg p-3 mb-3">
                        <code class="text-success-400 text-sm font-mono break-all">{{ snapshot_name }}</code>
                    </div>
                    <input 
                        type="text" 
                        id="confirm" 
                        name="confirm" 
                        required
                        placeholder="在此输入快照名称……"
                        class="form-input w-full border-danger-600 focus:border-danger-500 focus:ring-danger-500/20"
                        autocomplete="off"
                    >
                    <p class="text-text-tertiary text-xs mt-1">
                        你必须准确输入上面的快照名称才能继续销毁。
                    </p>
                </div>

                <!-- Final Warning -->
                <div class="card-nested bg-warning-900/20 border-warning-700">
                    <p class="text-sm text-warning-300 inline-flex items-start gap-2">
                        <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <span>
                            <strong>最后警告：</strong>此操作<strong>不可撤销</strong>。
                            请确认这是正确的快照，并确保在需要时已有其他备份。
                        </span>
                    </p>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <button 
                        type="submit"
                        class="btn-danger inline-flex items-center justify-center gap-2 font-bold"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        是，销毁快照
                    </button>
                    <a 
                        href="/zfs/snapshots" 
                        class="btn-secondary inline-flex items-center justify-center gap-2"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        取消（推荐）
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Safety Tips -->
    <div class="card-nested">
        <h3 class="text-sm font-semibold text-text-primary mb-3 inline-flex items-center gap-2">
            <svg class="w-4 h-4 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            销毁快照之前
        </h3>
        <ul class="text-xs text-text-secondary space-y-2">
            <li class="flex items-start gap-2">
                <svg class="w-3 h-3 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span>确认已为关键数据准备了其他备份</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-3 h-3 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span>检查是否有克隆依赖于此快照</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-3 h-3 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span>考虑该快照的留存时间和用途</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-3 h-3 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span>查看快照空间占用情况——销毁可能会释放大量空间</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-3 h-3 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <span>如果不确定，请先<a href="/zfs/snapshots/{{ snapshot_name }}/detail" class="text-primary-400 hover:text-primary-300 transition-colors">查看快照详细信息</a></span>
            </li>
        </ul>
    </div>
</div>

<!-- Confirmation Modal -->
{% set modal_id = 'confirm-destroy-snapshot' %}
{% set modal_title = '需要最终确认' %}
{% set modal_message = '你确定要销毁快照 ' ~ snapshot_name ~ ' 吗？此操作不可撤销且无法恢复。此快照中的所有数据都将永久丢失！' %}
{% set confirm_text = '是，永久销毁' %}
{% set confirm_class = 'danger' %}
{% set action_url = '/zfs/snapshots/' ~ snapshot_name ~ '/destroy' %}
{% set method = 'post' %}
{% include 'partials/confirm.jinja' %}

{% endblock %}
