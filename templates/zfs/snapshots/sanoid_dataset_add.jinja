{% extends "layout.jinja" %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm text-text-secondary mb-4 flex items-center gap-2">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">存储池</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/zfs/snapshots" class="hover:text-text-primary transition-colors">快照</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/zfs/snapshots/sanoid" class="hover:text-text-primary transition-colors">Sanoid</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-text-primary">添加数据集</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-text-primary">添加数据集到 Sanoid</h1>
        <p class="text-text-secondary mt-2">为数据集配置自动快照策略</p>
    </div>

    <!-- Error Message -->
    {% if error %}
    {% include "partials/error.jinja" %}
    {% endif %}

    <!-- Info Box -->
    <div class="card-nested bg-info-900/20 border-info-900 mb-6">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="text-sm">
                <strong class="text-info-400">提示：</strong>
                <span class="text-text-secondary">将数据集添加到 Sanoid 后，将根据所选模板策略启用自动快照创建和清理。</span>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="card">
        <form method="post" action="/zfs/snapshots/sanoid/dataset/add">
            <!-- Dataset Selection -->
            <div class="mb-6">
                <label for="dataset_name" class="form-label">
                    数据集 <span class="text-danger-400">*</span>
                </label>
                {% if datasets and datasets|length > 0 %}
                <select 
                    id="dataset_name" 
                    name="dataset_name" 
                    required
                    class="form-select"
                >
                    <option value="">-- 请选择数据集 --</option>
                    {% for ds in datasets %}
                    <option value="{{ ds.name }}">{{ ds.name }}</option>
                    {% endfor %}
                </select>
                <p class="text-text-tertiary text-xs mt-1">
                    选择要启用自动快照的数据集
                </p>
                {% else %}
                <div class="card-nested bg-warning-900/20 border-warning-900">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-warning-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        <div class="text-sm">
                            <strong class="text-warning-400">警告：</strong>
                            <span class="text-text-secondary">未找到数据集。</span>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Template Selection -->
            <div class="mb-6">
                <label for="template" class="form-label">
                    快照策略模板 <span class="text-danger-400">*</span>
                </label>
                {% if templates and templates|length > 0 %}
                <select 
                    id="template" 
                    name="template" 
                    required
                    onchange="showTemplateInfo()"
                    class="form-select"
                >
                    <option value="">-- 请选择模板 --</option>
                    {% for template_name, config in templates.items() %}
                    <option value="{{ template_name.replace('template_', '') }}" data-config='{{ config|tojson }}'>
                        {{ template_name.replace('template_', '') }}
                    </option>
                    {% endfor %}
                </select>
                <p class="text-text-tertiary text-xs mt-1">
                    选择一个留存策略模板，它定义了快照的创建频率和保留时长
                </p>
                <div id="template_info" class="mt-3 hidden card-nested bg-primary-900/20 border-primary-900"></div>
                {% else %}
                <div class="card-nested bg-warning-900/20 border-warning-900">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-warning-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        <div class="text-sm">
                            <strong class="text-warning-400">警告：</strong>
                            <span class="text-text-secondary">未找到模板。<a href="/zfs/snapshots/sanoid/template/create" class="text-primary-400 hover:text-primary-300">请先创建一个模板</a>。</span>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Recursive Option -->
            <div class="mb-6">
                <label for="recursive" class="form-label">
                    递归模式 <span class="text-danger-400">*</span>
                </label>
                <select 
                    id="recursive" 
                    name="recursive" 
                    required
                    class="form-select"
                >
                    <option value="no">否 —— 仅此数据集</option>
                    <option value="yes">是 —— 分别处理子数据集</option>
                    <option value="zfs">ZFS —— 原子化递归快照</option>
                </select>
                <div class="mt-2 card-nested text-xs space-y-2">
                    <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-text-tertiary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <div>
                            <strong class="text-text-primary">no:</strong>
                            <span class="text-text-secondary">仅为此数据集创建快照</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-text-tertiary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <div>
                            <strong class="text-text-primary">yes:</strong>
                            <span class="text-text-secondary">分别为子数据集创建快照（新增的子数据集立即应用策略）</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-text-tertiary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <div>
                            <strong class="text-text-primary">zfs:</strong>
                            <span class="text-text-secondary">使用 ZFS 递归标志（原子化、一致的快照）</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-4">
                {% if templates and templates|length > 0 and datasets and datasets|length > 0 %}
                <button 
                    type="submit"
                    class="btn-success flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    添加数据集
                </button>
                {% else %}
                <button 
                    type="button"
                    disabled
                    title="请先创建一个快照策略模板"
                    class="btn-success flex items-center gap-2 opacity-50 cursor-not-allowed"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    添加数据集
                </button>
                {% endif %}
                <a 
                    href="/zfs/snapshots/sanoid" 
                    class="btn-secondary flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    取消
                </a>
            </div>
        </form>
    </div>
</div>

<script>
function showTemplateInfo() {
    const select = document.getElementById('template');
    const infoDiv = document.getElementById('template_info');
    const option = select.options[select.selectedIndex];
    
    if (option.value) {
        const config = JSON.parse(option.getAttribute('data-config'));
        let html = '<div class="flex items-center gap-2 mb-2"><svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><strong class="text-primary-400">留存策略：</strong></div><div class="grid grid-cols-2 gap-2 text-xs">';
        
        if (config.frequently && config.frequently !== '0') html += `<div class="text-text-secondary">高频（15 分钟）：<span class="text-info-400 font-semibold">${config.frequently}</span></div>`;
        if (config.hourly && config.hourly !== '0') html += `<div class="text-text-secondary">每小时：<span class="text-info-400 font-semibold">${config.hourly}</span></div>`;
        if (config.daily && config.daily !== '0') html += `<div class="text-text-secondary">每天：<span class="text-success-400 font-semibold">${config.daily}</span></div>`;
        if (config.weekly && config.weekly !== '0') html += `<div class="text-text-secondary">每周：<span class="text-warning-400 font-semibold">${config.weekly}</span></div>`;
        if (config.monthly && config.monthly !== '0') html += `<div class="text-text-secondary">每月：<span class="text-purple-400 font-semibold">${config.monthly}</span></div>`;
        if (config.yearly && config.yearly !== '0') html += `<div class="text-text-secondary">每年：<span class="text-primary-400 font-semibold">${config.yearly}</span></div>`;
        
        html += '</div>';
        infoDiv.innerHTML = html;
        infoDiv.classList.remove('hidden');
    } else {
        infoDiv.classList.add('hidden');
    }
}
</script>
{% endblock %}
