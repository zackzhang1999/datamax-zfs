{% extends "layout_main.jinja" %}

{% block content %}
<div class="container-page max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="面包屑">
        <ol class="flex items-center space-x-2">
            <li><a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">首页</a></li>
            <li class="text-text-tertiary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li><a href="/zfs/replication" class="text-primary-400 hover:text-primary-300 transition-colors">数据复制</a></li>
            <li class="text-text-tertiary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="text-text-primary font-medium">ZFS 发送/接收</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-text-primary mb-2">ZFS 发送/接收</h1>
        <p class="text-text-secondary">在本地或向远程系统复制 ZFS 快照</p>
    </div>

    <!-- Messages -->
    {% if error %}
        <div id="error-message" class="bg-danger-900/30 border border-danger-700 text-danger-400 px-4 py-3 rounded-lg mb-6 flex items-center">
            <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><strong>错误：</strong> {{ error }}</span>
        </div>
    {% endif %}

    <!-- Replication Form -->
    <div class="card mb-6">
        <div class="card-body">
            <form method="post" action="/zfs/replication/send-receive/execute" id="replication-form">
                <!-- Source Snapshot -->
                <div class="mb-6">
                    <label class="form-label" for="source">
                        源快照 <span class="text-danger-400">*</span>
                    </label>
                    <select name="source" id="source" required class="form-select">
                        <option value="">-- 选择快照 --</option>
                        {% for snapshot in snapshots %}
                        <option value="{{ snapshot.name }}">{{ snapshot.name }}</option>
                        {% endfor %}
                    </select>
                    <p class="text-text-tertiary text-xs mt-1">选择要复制的源快照</p>
                </div>

                <!-- Replication Type -->
                <div class="mb-6">
                    <label class="form-label" for="replication_type">
                        复制类型 <span class="text-danger-400">*</span>
                    </label>
                    <select name="replication_type" id="replication_type" required class="form-select">
                        <option value="local">本地（同一系统）</option>
                        <option value="push">推送（本地 → 远程）</option>
                    </select>
                </div>

                <!-- Remote Options (shown when push is selected) -->
                <div id="remote-options" class="hidden mb-6">
                    <div class="card-nested mb-6">
                        <h3 class="font-semibold text-lg mb-4 text-text-primary flex items-center">
                            <svg class="w-5 h-5 mr-2 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                            </svg>
                            远程连接
                        </h3>
                        
                        <!-- SSH Connection Dropdown -->
                        <div class="mb-4">
                            <label class="form-label" for="ssh_connection">
                                SSH 连接 <span class="text-danger-400">*</span>
                            </label>
                            {% if ssh_connections and ssh_connections|length > 0 %}
                            <select name="ssh_connection_id" id="ssh_connection" class="form-select">
                                <option value="">-- 选择 SSH 连接 --</option>
                                {% for conn in ssh_connections %}
                                <option value="{{ conn.id }}" 
                                        data-host="{{ conn.host }}" 
                                        data-username="{{ conn.username }}" 
                                        data-port="{{ conn.port }}">
                                    {{ conn.name }} ({{ conn.username }}@{{ conn.host }}{% if conn.port != 22 %}:{{ conn.port }}{% endif %})
                                </option>
                                {% endfor %}
                            </select>
                            <p class="text-text-tertiary text-xs mt-1">选择一个已配置的 SSH 连接</p>
                            {% else %}
                            <div class="bg-warning-900/30 border border-warning-700 text-warning-400 px-4 py-3 rounded-lg">
                                <div class="flex items-start">
                                    <svg class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                    </svg>
                                    <div>
                                        <p class="font-medium">尚未配置 SSH 连接</p>
                                        <p class="text-sm mt-1">使用远程复制前需要先配置 SSH 连接。</p>
                                        <a href="/utils/ssh/add" class="btn-warning btn-sm mt-2 inline-flex items-center gap-2">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                            </svg>
                                            添加 SSH 连接
                                        </a>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </div>

                        <!-- Hidden fields to store connection details for form submission -->
                        <input type="hidden" name="remote_host" id="remote_host" value="">
                        <input type="hidden" name="remote_port" id="remote_port" value="22">
                        
                        <!-- Connection Info Display -->
                        <div id="connection-info" class="hidden mb-4 bg-bg-elevated-2 p-3 rounded-lg border border-border-subtle">
                            <div class="text-sm">
                                <span class="text-text-tertiary">已选择：</span>
                                <span id="connection-display" class="text-text-primary font-mono ml-2"></span>
                            </div>
                        </div>
                        
                        <div class="flex items-center gap-4">
                            <button type="button" id="test-connection-btn" class="btn-success" disabled>
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                                测试连接并加载数据集
                            </button>
                            <span id="connection-status"></span>
                        </div>
                    </div>
                </div>

                <!-- Target Dataset -->
                <div class="mb-6">
                    <label class="form-label" for="target">
                        目标数据集 <span class="text-danger-400">*</span>
                    </label>
                    <select name="target" id="target" required class="form-select">
                        <option value="">-- 选择目标数据集 --</option>
                    </select>
                    <p class="text-text-tertiary text-xs mt-1">选择用于数据复制的目标数据集</p>
                </div>

                <!-- Compression -->
                <div class="mb-6">
                    <label class="form-label" for="compression">
                        压缩
                    </label>
                    <select name="compression" id="compression" class="form-select">
                        {% for method in compression_methods %}
                        <option value="{{ method }}" {% if method == 'lz4' %}selected{% endif %}>{{ method }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Options -->
                <div class="space-y-3 mb-6">
                    <label class="flex items-center">
                        <input type="checkbox" name="incremental" value="true" class="form-checkbox">
                        <span class="ml-3 text-text-secondary">增量（使用最近的公共快照）</span>
                    </label>

                    <label class="flex items-center">
                        <input type="checkbox" name="recursive" value="true" class="form-checkbox">
                        <span class="ml-3 text-text-secondary">递归（包含子数据集）</span>
                    </label>

                    <label class="flex items-center">
                        <input type="checkbox" name="raw" value="true" class="form-checkbox">
                        <span class="ml-3 text-text-secondary">原始发送（<code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-w</code> 标志，加密数据集必需）</span>
                    </label>

                    <label class="flex items-center">
                        <input type="checkbox" name="large_blocks" value="true" class="form-checkbox">
                        <span class="ml-3 text-text-secondary">大块（<code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-L</code> 标志，recordsize 大于 128 KiB 的数据集必需）</span>
                    </label>
                    <p id="large-blocks-hint" class="hidden text-xs text-info-400">
                        由于源数据集的 recordsize 大于 128 KiB，已自动启用大块选项。
                    </p>
                </div>

                <!-- Command Preview -->
                <div class="mb-6 pt-4 border-t border-border-subtle">
                    <label class="form-label flex items-center">
                        <svg class="w-4 h-4 mr-2 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        命令预览
                    </label>
                    <div id="command-preview" class="bg-bg-elevated-2 rounded-lg p-4 font-mono text-sm text-info-400 border border-border-default overflow-x-auto whitespace-pre-wrap">
                        <span class="text-text-tertiary">请选择源快照和目标数据集以预览命令。</span>
                    </div>
                    <p class="text-text-tertiary text-xs mt-1">这是将要执行的命令。如果找到公共快照，实际命令可能会包含增量标志。</p>
                </div>

                <!-- Confirmation Checkbox -->
                <div class="mb-6">
                    <label class="flex items-center">
                        <input type="checkbox" id="confirm-command" class="form-checkbox">
                        <span class="ml-3 text-text-secondary font-medium">我已检查上述复制命令并希望继续</span>
                    </label>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                    <button type="submit" id="execute-btn" disabled class="btn-primary inline-flex items-center gap-2 htmx-loading opacity-50 cursor-not-allowed">
                        <span class="htmx-indicator">
                            <div class="loading-spinner loading-spinner-sm"></div>
                        </span>
                        <span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                            </svg>
                        </span>
                        <span>执行数据复制</span>
                    </button>
                    <a href="/zfs/replication" class="btn-secondary">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        取消
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- General Notes -->
    <div class="card-nested bg-info-900/20 border-info-700 mb-6">
        <h3 class="font-semibold mb-3 text-text-primary flex items-center">
            <svg class="w-5 h-5 mr-2 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            说明
        </h3>
        <ul class="space-y-2 text-sm text-text-secondary">
            <li class="flex items-start">
                <svg class="w-4 h-4 mr-2 mt-0.5 text-info-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span><strong>SSH 连接：</strong>远程复制使用在<a href="/utils/ssh" class="text-primary-400 hover:text-primary-300">SSH 连接</a>中配置的基于密钥的 SSH 认证</span>
            </li>
            <li class="flex items-start">
                <svg class="w-4 h-4 mr-2 mt-0.5 text-info-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>如果目标数据集不存在，将自动创建</span>
            </li>
            <li class="flex items-start">
                <svg class="w-4 h-4 mr-2 mt-0.5 text-info-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>增量发送效率更高，占用的带宽更少</span>
            </li>
            <li class="flex items-start">
                <svg class="w-4 h-4 mr-2 mt-0.5 text-info-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>使用递归选项可复制整个数据集层级结构</span>
            </li>
        </ul>
    </div>

    <!-- Encrypted Replication -->
    <div class="card-nested bg-warning-900/20 border-warning-700 mb-6">
        <h3 class="font-semibold mb-3 text-text-primary flex items-center">
            <svg class="w-5 h-5 mr-2 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            加密数据集复制
        </h3>
        <div class="text-sm text-text-secondary space-y-3">
            <p>
                复制加密数据集时，必须启用<strong class="text-text-primary">原始发送</strong>选项
                （<code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-w</code>）。这会以加密形式发送
                数据，使接收端在无需访问加密密钥的情况下保留加密属性。
            </p>
            <p>
                如果不使用原始发送，ZFS 会尝试在发送前解密数据，这要求源端已加载加密
                密钥。并且目标端接收到的数据集将不会保留其加密属性。
            </p>
            <p>
                有关加密数据集发送和接收行为的完整详细信息，请参阅 OpenZFS 手册页：
            </p>
            <div class="flex flex-wrap items-center gap-3 mt-2">
                {% if zfs_send_man_url %}
                <a href="{{ zfs_send_man_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn-secondary btn-sm inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    zfs-send(8) 手册页
                </a>
                {% endif %}
                {% if zfs_receive_man_url %}
                <a href="{{ zfs_receive_man_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn-secondary btn-sm inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    zfs-receive(8) 手册页
                </a>
                {% endif %}
                {% if not zfs_send_man_url and not zfs_receive_man_url %}
                <span class="text-text-tertiary text-xs">手册页链接不可用（无法确定 ZFS 版本）。</span>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- SSH Connection Info -->
    <div class="card-nested bg-success-900/20 border-success-700">
        <h3 class="font-semibold mb-3 text-text-primary flex items-center">
            <svg class="w-5 h-5 mr-2 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
            SSH 基于密钥的认证
        </h3>
        <div class="text-sm text-text-secondary space-y-3">
            <p>
                远程复制需要使用基于密钥的 SSH 认证。所有 SSH 密钥都<strong class="text-text-primary">必须</strong>
                通过 <a href="/utils/ssh" class="text-primary-400 hover:text-primary-300">SSH 连接管理器</a>创建。
            </p>
            <div class="bg-warning-900/30 border border-warning-700 text-warning-400 px-3 py-2 rounded-lg">
                <p class="flex items-start">
                    <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span>
                        在 Linux 上，DataMax-zfs 以 <code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">webzfs</code> 用户身份运行。
                        以 root 身份手动创建的 SSH 密钥将<strong>无法</strong>被访问。请始终使用 SSH 连接管理器
                        生成和管理密钥，以确保应用正确的所有权和权限。
                    </span>
                </p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/utils/ssh" class="btn-success btn-sm inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    管理 SSH 连接
                </a>
                <a href="/utils/ssh/add" class="btn-primary btn-sm inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    添加新连接
                </a>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const localDatasets = {{ datasets | tojson }};
    const sourceSelect = document.getElementById('source');
    const replicationTypeSelect = document.getElementById('replication_type');
    const remoteOptions = document.getElementById('remote-options');
    const targetSelect = document.getElementById('target');
    const sshConnectionSelect = document.getElementById('ssh_connection');
    const testConnectionBtn = document.getElementById('test-connection-btn');
    const connectionStatus = document.getElementById('connection-status');
    const connectionInfo = document.getElementById('connection-info');
    const connectionDisplay = document.getElementById('connection-display');
    const remoteHostInput = document.getElementById('remote_host');
    const remotePortInput = document.getElementById('remote_port');

// Handle replication type change
replicationTypeSelect.addEventListener('change', function() {
    if (this.value === 'push') {
        remoteOptions.classList.remove('hidden');
        targetSelect.innerHTML = '<option value="">-- 请先选择 SSH 连接 --</option>';
    } else {
        remoteOptions.classList.add('hidden');
        loadLocalDatasets();
    }
});

// Handle SSH connection selection
if (sshConnectionSelect) {
    sshConnectionSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        
        if (this.value) {
            // Show connection info
            const host = selectedOption.dataset.host;
            const username = selectedOption.dataset.username;
            const port = selectedOption.dataset.port;
            
            connectionDisplay.textContent = `${username}@${host}:${port}`;
            connectionInfo.classList.remove('hidden');
            testConnectionBtn.disabled = false;
            
            // Set hidden form values
            remoteHostInput.value = `${username}@${host}`;
            remotePortInput.value = port;
            
            // Clear previous datasets and status
            targetSelect.innerHTML = '<option value="">-- 请测试连接以加载数据集 --</option>';
            connectionStatus.innerHTML = '';
        } else {
            connectionInfo.classList.add('hidden');
            testConnectionBtn.disabled = true;
            remoteHostInput.value = '';
            remotePortInput.value = '22';
            targetSelect.innerHTML = '<option value="">-- 请先选择 SSH 连接 --</option>';
            connectionStatus.innerHTML = '';
        }
    });
}

// Handle source snapshot change (for local replication)
sourceSelect.addEventListener('change', function() {
    if (replicationTypeSelect.value === 'local') {
        loadLocalDatasets();
    }
    checkLargeBlocks();
});

// Auto-check the Large blocks option when the source dataset uses a
// recordsize or volblocksize larger than 128 KiB (zfs send -L).
// The source here is always a local snapshot; the API strips the
// @snapshot suffix and checks the underlying dataset.
const largeBlocksHint = document.getElementById('large-blocks-hint');

async function checkLargeBlocks() {
    const largeBlocksInput = document.querySelector('input[name="large_blocks"]');
    if (!largeBlocksInput) return;
    const source = sourceSelect.value;
    if (!source) {
        largeBlocksHint.classList.add('hidden');
        return;
    }
    try {
        const response = await fetch('/zfs/replication/api/check-large-blocks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dataset: source })
        });
        const data = await response.json();
        if (data.success && data.large_blocks) {
            largeBlocksInput.checked = true;
            largeBlocksHint.classList.remove('hidden');
        } else {
            largeBlocksHint.classList.add('hidden');
        }
        if (typeof updateCommandPreview === 'function') {
            updateCommandPreview();
        }
    } catch (error) {
        // Non-fatal; the user can still set the option manually
        largeBlocksHint.classList.add('hidden');
    }
}

// Load local datasets (excluding source dataset)
function loadLocalDatasets() {
    const sourceSnapshot = sourceSelect.value;
    if (!sourceSnapshot) {
        targetSelect.innerHTML = '<option value="">-- 请先选择源快照 --</option>';
        return;
    }
    
    // Extract dataset name from snapshot (before @)
    const sourceDataset = sourceSnapshot.split('@')[0];
    
    // Clear and populate target dropdown
    targetSelect.innerHTML = '<option value="">-- 请选择目标数据集 --</option>';
    localDatasets.forEach(dataset => {
        if (dataset.name !== sourceDataset) {
            const option = document.createElement('option');
            option.value = dataset.name;
            option.textContent = dataset.name;
            targetSelect.appendChild(option);
        }
    });
}

// Test remote connection and load datasets
testConnectionBtn.addEventListener('click', async function() {
    const sshConnectionId = sshConnectionSelect ? sshConnectionSelect.value : '';
    
    if (!sshConnectionId) {
        connectionStatus.innerHTML = '<span class="text-danger-400 flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> 请选择 SSH 连接</span>';
        return;
    }
    
    connectionStatus.innerHTML = '<span class="text-info-400 flex items-center"><svg class="w-4 h-4 mr-1 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> 正在测试连接...</span>';
    testConnectionBtn.disabled = true;
    
    try {
        const response = await fetch('/zfs/replication/api/test-remote-connection', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                ssh_connection_id: sshConnectionId
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            connectionStatus.innerHTML = '<span class="text-success-400 flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> ' + data.message + '</span>';
            
            // Populate target dropdown with remote datasets
            targetSelect.innerHTML = '<option value="">-- 请选择目标数据集 --</option>';
            data.datasets.forEach(dataset => {
                const option = document.createElement('option');
                option.value = dataset;
                option.textContent = dataset;
                targetSelect.appendChild(option);
            });
        } else {
            connectionStatus.innerHTML = `<span class="text-danger-400 flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> ${data.error}</span>`;
            targetSelect.innerHTML = '<option value="">-- 连接失败 --</option>';
        }
    } catch (error) {
        connectionStatus.innerHTML = '<span class="text-danger-400 flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> 连接失败</span>';
        targetSelect.innerHTML = '<option value="">-- 连接失败 --</option>';
    } finally {
        testConnectionBtn.disabled = false;
    }
});

// Command preview elements
const commandPreview = document.getElementById('command-preview');
const confirmCheckbox = document.getElementById('confirm-command');
const executeBtn = document.getElementById('execute-btn');
const incrementalCheckbox = document.querySelector('input[name="incremental"]');
const recursiveCheckbox = document.querySelector('input[name="recursive"]');
const rawCheckbox = document.querySelector('input[name="raw"]');
const largeBlocksCheckbox = document.querySelector('input[name="large_blocks"]');
const compressionSelect = document.getElementById('compression');

// Build command preview string based on current form state
function updateCommandPreview() {
    const source = sourceSelect.value;
    const target = targetSelect.value;
    const replType = replicationTypeSelect.value;

    if (!source || !target) {
        commandPreview.innerHTML = '<span class="text-text-tertiary">请选择源快照和目标数据集以预览命令。</span>';
        return;
    }

    // Build send command
    var sendParts = ['zfs', 'send'];

    if (recursiveCheckbox && recursiveCheckbox.checked) {
        sendParts.push('-R');
    }
    if (rawCheckbox && rawCheckbox.checked) {
        sendParts.push('-w');
    }
    if (largeBlocksCheckbox && largeBlocksCheckbox.checked) {
        sendParts.push('-L');
    }
    if (compressionSelect && compressionSelect.value !== 'none') {
        sendParts.push('-c');
    }
    if (incrementalCheckbox && incrementalCheckbox.checked) {
        sendParts.push('-i <common_snapshot>');
    }

    sendParts.push(source);

    // Build receive command.
    // Full send: creates a child dataset under the target using the
    // source dataset basename (e.g. target/source_basename).
    // Incremental send: writes directly into the selected target.
    var receiveParts = ['zfs', 'receive'];
    var isIncremental = incrementalCheckbox && incrementalCheckbox.checked;

    if (isIncremental) {
        receiveParts.push(target);
    } else {
        // Extract source dataset basename for the child target path
        var sourceDataset = source.split('@')[0];
        var sourceBasename = sourceDataset.split('/').pop();
        receiveParts.push(target + '/' + sourceBasename);
    }

    // Build full pipeline
    var fullCommand = '';
    if (replType === 'push') {
        var remoteHost = remoteHostInput.value || '<remote_host>';
        var remotePort = remotePortInput.value || '22';
        fullCommand = sendParts.join(' ') + ' | ssh -p ' + remotePort + ' ' + remoteHost + ' ' + receiveParts.join(' ');
    } else {
        fullCommand = sendParts.join(' ') + ' | ' + receiveParts.join(' ');
    }

    commandPreview.textContent = fullCommand;

    // Reset confirmation when command changes
    confirmCheckbox.checked = false;
    executeBtn.disabled = true;
    executeBtn.classList.add('opacity-50', 'cursor-not-allowed');
}

// Handle confirmation checkbox
confirmCheckbox.addEventListener('change', function() {
    var source = sourceSelect.value;
    var target = targetSelect.value;

    if (this.checked && source && target) {
        executeBtn.disabled = false;
        executeBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
        executeBtn.disabled = true;
        executeBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
});

// Listen for changes on all form fields that affect the command
sourceSelect.addEventListener('change', updateCommandPreview);
targetSelect.addEventListener('change', updateCommandPreview);
replicationTypeSelect.addEventListener('change', updateCommandPreview);
compressionSelect.addEventListener('change', updateCommandPreview);
if (incrementalCheckbox) incrementalCheckbox.addEventListener('change', updateCommandPreview);
if (recursiveCheckbox) recursiveCheckbox.addEventListener('change', updateCommandPreview);
if (rawCheckbox) rawCheckbox.addEventListener('change', updateCommandPreview);
if (largeBlocksCheckbox) largeBlocksCheckbox.addEventListener('change', updateCommandPreview);
if (sshConnectionSelect) sshConnectionSelect.addEventListener('change', updateCommandPreview);

// Initialize on page load
if (replicationTypeSelect.value === 'local') {
    loadLocalDatasets();
}
updateCommandPreview();
})();
</script>
{% endblock %}
